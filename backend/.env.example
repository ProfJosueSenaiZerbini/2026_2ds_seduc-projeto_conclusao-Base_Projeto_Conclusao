# ==========================================
# CONFIGURAÇÕES DO SERVIDOR
# ==========================================
PORT=3000

# ==========================================
# BANCO DE DADOS ONLINE (SUPABASE - RECOMENDADO)
# ==========================================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=sua_chave_publica_aqui
SUPABASE_SECRET_KEY=sua_chave_secreta_aqui
SUPABASE_JWKS_URL=

# ==========================================
# OU BANCO DE DADOS LOCAL (MYSQL / XAMPP)
# ==========================================
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=blog

# ==========================================
# INTELIGÊNCIA ARTIFICIAL (CHATBOT - ESTILO CHATGPT / GEMINI)
# Opcional: Adicione sua chave do Google Gemini (gratuita em aistudio.google.com)
# ou OpenAI para usar os modelos mais recentes com sua própria cota.
# ==========================================
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...

# ==========================================
# AUTENTICAÇÃO E SEGURANÇA (JWT)
# ==========================================
JWT_SECRET=

# ==========================================
# DADOS DO ADMINISTRADOR INICIAL (npm run criar-admin)
# ==========================================
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=