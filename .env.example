# Configurações do Servidor
PORT=
NODE_ENV=

# Segredo para gerenciar as sessões do Express
# Gere um valor aleatorio forte (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=


# Conexão com o Banco de Dados MariaDB
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Verificação de endereço do bico pelo CEP (ViaCEP, com a BrasilAPI de reserva).
# CEP_FAKE=1 troca as APIs por um provedor falso em memória, sem internet: usado pelos testes E2E
# (o playwright.config.js já define essa variável no webServer). CEPs conhecidos pelo provedor falso:
#   01310-100 (Av. Paulista, Bela Vista, São Paulo/SP), 13690-000 (CEP geral de Descalvado/SP)
#   e 99999-999 (inexistente). Qualquer outro CEP é tratado como inexistente.
# Deixe vazio (ou 0) no uso normal. É ignorada quando NODE_ENV=production.
CEP_FAKE=