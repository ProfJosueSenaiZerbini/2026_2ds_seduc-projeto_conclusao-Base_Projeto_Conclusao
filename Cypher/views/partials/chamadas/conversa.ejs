<section class="op-panel"><h3>Conversa · <%= conversa.contexto %></h3><div class="op-chat" aria-label="Histórico de mensagens"><% if(!conversa.mensagens.length){ %><p class="op-note">Envie a primeira mensagem.</p><% } %><% conversa.mensagens.forEach(m=>{ %><article class="op-message <%= m.autor_id===usuario.id?'op-message-own':'' %>"><strong><%= m.nome %></strong><% if(m.texto){ %><p class="op-prose"><%= m.texto %></p><% } %><%- include('anexo-mensagem', { m }) %><small><%= data(m.criada_em) %><% if(m.autor_id===usuario.id){ %> · <%= m.lida_em ? "Lida" : "Enviada" %><% } %></small><% if(!administrativo){ %><a class="op-text-link" href="/suporte/new?objeto_tipo=mensagem&amp;objeto_id=<%= encodeURIComponent(m.id) %>">Denunciar esta mensagem</a><% } %></article><% }) %></div>
<% if(conversa.envioPermitido){ %><%- include('compositor-mensagem', { action: (administrativo ? '/admin/oportunidades/mensagens/' : '/messages/') + encodeURIComponent(conversa.id) }) %><% }else{ %><p class="op-feedback" role="status"><%= conversa.motivoEnvio %> O histórico autorizado permanece disponível.</p><% } %>
<% if(!administrativo){ %><form method="post" action="/messages/<%= encodeURIComponent(conversa.id) %>/hide"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="op-text-link">Ocultar da minha caixa</button></form><form method="post" action="/messages/block" data-confirm="Bloquear novos contatos desta pessoa? O histórico da conversa será preservado."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="alvo_id" value="<%= conversa.outro %>"><button class="op-text-link" name="acao" value="bloquear">Bloquear contato</button></form><% } %></section>
