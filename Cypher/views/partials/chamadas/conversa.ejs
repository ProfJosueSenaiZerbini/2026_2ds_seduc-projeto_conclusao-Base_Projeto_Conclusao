<section class="op-panel"><h3>Conversa · <%= conversa.contexto %></h3><div class="op-chat" aria-label="Histórico de mensagens"><% if(!conversa.mensagens.length){ %><p class="op-note">Este é o começo da conversa. Combine os detalhes e registre as condições na proposta.</p><% } %><% conversa.mensagens.forEach(m=>{ %><article class="op-message <%= m.autor_id===usuario.id?'op-message-own':'' %>"><strong><%= m.nome %></strong><p class="op-prose"><%= m.texto %></p><small><%= data(m.criada_em) %></small><% if(!administrativo){ %><a class="op-text-link" href="/suporte/new?objeto_tipo=mensagem&amp;objeto_id=<%= encodeURIComponent(m.id) %>">Denunciar esta mensagem</a><% } %></article><% }) %></div>
<% if(conversa.envioPermitido){ %><form method="post" action="<%= administrativo?'/admin/oportunidades/mensagens':'/messages' %>/<%= conversa.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="chave" value="<%= nonce %>"><label>Nova mensagem<textarea name="texto" maxlength="4000" rows="3" required></textarea></label><button class="op-button op-primary">Enviar mensagem</button></form><% }else{ %><p class="op-feedback" role="status"><%= conversa.motivoEnvio %> O histórico autorizado permanece disponível.</p><% } %>
<% if(!administrativo){ %><form method="post" action="/messages/block" data-confirm="Bloquear novos contatos desta pessoa? O histórico da conversa será preservado."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="alvo_id" value="<%= conversa.outro %>"><button class="op-text-link" name="acao" value="bloquear">Bloquear contato</button></form><% } %></section>
