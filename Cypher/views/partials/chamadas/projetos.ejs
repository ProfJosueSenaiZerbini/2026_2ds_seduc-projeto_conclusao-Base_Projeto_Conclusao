<header class="op-section-heading"><span class="op-eyebrow">Espaço de Trabalho / Projetos</span><h2><%= projeto?projeto.titulo:'Meus projetos' %></h2><p>Registre o contexto do trabalho para vinculá-lo às suas chamadas.</p></header>
<% if(projeto){ %><section class="op-panel"><p class="op-prose"><%= projeto.descricao %></p><span class="op-state"><%= projeto.publico?'Projeto público':'Projeto privado' %></span></section><a class="op-button" href="/opportunities/new">Criar oportunidade</a><% }else{ %><div class="op-detail-grid"><section class="op-panel op-rows"><% itens.forEach(p=>{ %><a href="/work-projects/<%= p.id %>"><strong><%= p.titulo %></strong><span><%= p.publico?'Público':'Privado' %></span></a><% }) %><% if(!itens.length){ %><p>Nenhum projeto cadastrado.</p><% } %></section><form class="op-panel" method="post" action="/work-projects"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>Registrar projeto</h3><label>Título<input name="titulo" required maxlength="120"></label><label>Descrição<textarea name="descricao" required maxlength="4000"></textarea></label><label class="op-check"><input type="checkbox" name="publico" value="sim"> Permitir consulta por usuários autenticados</label><button class="op-button op-primary">Criar projeto</button></form></div><% } %>
