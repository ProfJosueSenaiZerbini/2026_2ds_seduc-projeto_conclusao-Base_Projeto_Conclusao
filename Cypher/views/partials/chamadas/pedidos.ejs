<header class="op-section-heading"><span class="op-eyebrow">Serviços e mediação</span><h2><%= administrativo?'Triagem de pedidos excepcionais':'Minhas solicitações' %></h2><p><%= administrativo?'Analise cada necessidade e registre uma decisão fundamentada. A autorização vale apenas para o pedido.':'Acompanhe os pedidos que você enviou e responda aos esclarecimentos solicitados.' %></p></header>
<% if(!administrativo){ %><div class="op-actions"><a class="op-button op-primary" href="/service-requests/new">Solicitar pedido público</a><a class="op-button" href="/service-mediation">Encontrar mediador</a></div><% } %>
<% if(administrativo){ %><p class="admin-queue-count"><%= itens.length %> <%= itens.length === 1 ? "pedido para consultar" : "pedidos para consultar" %></p><% } %>
<% const abertos = administrativo ? itens.filter(p=>!["aprovado","recusado"].includes(p.estado)) : itens; const decididos = administrativo ? itens.filter(p=>["aprovado","recusado"].includes(p.estado)) : []; %>
<% const verPedidos = grupo => { %><% grupo.forEach(p=>{ %><a href="<%= administrativo?'/admin/oportunidades/pedidos':'/service-requests' %>/<%= p.id %>"><div><strong><%= p.dados.titulo %></strong><small><%= data(p.criado_em) %></small></div><span class="op-state<%= administrativo && p.estado === "pendente" ? " admin-badge" : "" %>"><%= ({pendente:'Pendente de aprovação',esclarecimento:'Aguardando esclarecimento',aprovado:'Aprovado',recusado:'Recusado'})[p.estado] %></span></a><% }) %><% }; %>
<% if(administrativo){ %><section class="admin-lane"><h3>Em andamento</h3><% if(!abertos.length){ %><p class="admin-empty-work">Nenhum pedido em andamento.</p><% }else{ %><div class="op-rows op-panel"><% verPedidos(abertos); %></div><% } %></section>
<details class="op-panel admin-lane admin-archive"><summary>Histórico de decisões <span class="admin-badge"><%= decididos.length %></span></summary><% if(decididos.length){ %><div class="op-rows"><% verPedidos(decididos); %></div><% }else{ %><p>Nenhum pedido decidido.</p><% } %></details>
<% }else{ %><div class="op-rows op-panel"><% if(!itens.length){ %><p>Nenhuma solicitação registrada.</p><% } %><% verPedidos(itens); %></div><% } %>
<% if(administrativo&&geridas.length){ %><section class="op-panel"><h3>Publicações sob sua responsabilidade</h3><div class="op-rows"><% geridas.forEach(o=>{ %><a href="/admin/oportunidades/<%= o.id %>"><strong><%= o.titulo %></strong><span><%= estadosChamada[o.estado] %></span></a><% }) %></div></section><% } %>
