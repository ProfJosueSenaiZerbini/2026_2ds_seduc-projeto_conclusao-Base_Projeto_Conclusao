<header class="op-section-heading"><span class="op-eyebrow">Pedido excepcional · <%= p.estado %></span><h2><%= p.dados.titulo %></h2><p>Solicitado por <%= p.solicitante %> em <%= data(p.criado_em) %></p></header>
<section class="op-panel"><h3>Necessidade e condições</h3><p class="op-prose"><%= p.dados.descricao %></p><dl class="op-facts"><% Object.entries(p.dados).filter(([k,v])=>!['_csrf','acao','funcoes','titulo','descricao','revisao','valor_centavos','submissao'].includes(k)&&typeof v==='string'&&v).forEach(([k,v])=>{ %><div><dt><%= ({contexto:'Contexto',tipo:'Finalidade',modalidade:'Modalidade',localizacao:'Região',remuneracao:'Remuneração',valor:'Valor (R$)',unidade:'Por',inicio:'Início',fim:'Fim',prazo:'Prazo',condicoes:'Condições'})[k]||k %></dt><dd><%= tiposChamada[v]||modosTrabalho[v]||remuneracoes[v]||v %></dd></div><% }) %></dl><% Object.values(p.dados.funcoes||{}).forEach(f=>{ %><div class="op-function"><h4><%= profissoes.find(x=>x.id===f.profissao_id)?.rotulo %> · <%= f.vagas %> vagas</h4><p class="op-prose"><%= f.responsabilidades %></p><p class="op-prose">Requisitos: <%= f.requisitos||'Não informados' %></p></div><% }) %></section>
<% if(p.publicacao){ %><section class="op-panel"><h3>Pedido publicado · <%= estadosChamada[p.publicacao.estado] %></h3><a class="op-button" href="<%= administrativo?'/admin/oportunidades':'/opportunities' %>/<%= p.publicacao.id %>">Acompanhar chamada autorizada</a></section><% } %>
<section class="op-panel"><h3>Acompanhamento</h3><ol class="op-history"><% p.historico.forEach(h=>{const d=JSON.parse(h.dados_json); %><li><strong><%= h.acao.replaceAll('_',' ') %></strong> · <%= data(h.criado_em) %><% if(d.mensagem){ %><p class="op-prose"><%= d.mensagem %></p><% } %></li><% }) %></ol></section>
<% if(administrativo&&['pendente','esclarecimento'].includes(p.estado)){ %><form class="op-panel" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>Registrar análise</h3><label>Justificativa ou pedido de esclarecimento<textarea name="motivo" required maxlength="3000"></textarea></label><p class="op-note">Ao aprovar, você assume a gestão desta publicação excepcional. O solicitante permanece Consumidor.</p><div class="op-actions"><button class="op-button op-primary" name="acao" value="aprovado">Aprovar e publicar</button><button class="op-button" name="acao" value="esclarecimento">Solicitar esclarecimento</button><button class="op-button" name="acao" value="recusado">Recusar pedido</button></div></form><% }else if(!administrativo&&p.estado==='esclarecimento'){ %><form class="op-panel" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Seu esclarecimento<textarea name="mensagem" required maxlength="4000"></textarea></label><button class="op-button op-primary">Enviar resposta</button></form><% } %>
