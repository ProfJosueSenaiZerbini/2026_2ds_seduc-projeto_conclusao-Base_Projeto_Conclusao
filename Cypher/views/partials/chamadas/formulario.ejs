<header class="op-section-heading"><span class="op-eyebrow"><%= consumidor?'Pedido público excepcional':'Publicação profissional' %></span><h2><%= consumidor?'De que serviço você precisa?':id?'Editar oportunidade':'Abra espaço para o próximo encontro.' %></h2><p><%= consumidor?'Seu pedido passará por análise. Se aprovado, terá gestão autorizada e você poderá acompanhar os encaminhamentos.':'Conte o que precisa, quem procura e quais condições oferece.' %></p></header>
<form class="op-editor" method="post" action="<%= consumidor?'/service-requests':id?'/opportunities/'+id+'/edit':'/opportunities' %>" data-op-review>
 <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="submissao" value="<%= dados.submissao||nonce %>"><input type="hidden" name="revisao" value="<%= dados.revisao||1 %>">
 <% function field(n,label,type='text',required=false){ %><label><%= label %><input name="<%= n %>" type="<%= type %>" value="<%= dados[n]??'' %>" <%= required?'required':'' %> aria-invalid="<%= !!campos[n] %>" <%- type==='number'?'min="0" step="0.01"':'' %>><% if(campos[n]){ %><small class="op-field-error"><%= campos[n] %></small><% } %></label><% } %>
 <% function area(n,label,required=false){ %><label class="op-wide"><%= label %><textarea name="<%= n %>" rows="4" <%= required?'required':'' %> aria-invalid="<%= !!campos[n] %>"><%= dados[n]||'' %></textarea><% if(campos[n]){ %><small class="op-field-error"><%= campos[n] %></small><% } %></label><% } %>
 <% function select(n,label,options){ %><label><%= label %><select name="<%= n %>" aria-invalid="<%= !!campos[n] %>"><% Object.entries(options).forEach(([v,t])=>{ %><option value="<%= v %>" <%= dados[n]===v?'selected':'' %>><%= t %></option><% }) %></select><% if(campos[n]){ %><small class="op-field-error"><%= campos[n] %></small><% } %></label><% } %>
 <fieldset class="op-panel"><legend>O que você quer realizar</legend><div class="op-fields"><% field('titulo','Título da chamada','text',true);select('tipo','Finalidade',tiposChamada);area('descricao','Descreva a necessidade',true);area('contexto','Contexto e objetivo'); %></div></fieldset>
 <fieldset class="op-panel"><legend>Quem você procura</legend><p>Defina vagas e critérios por função. Cada candidatura será vinculada a uma delas.</p><% if(campos.funcoes){ %><p class="op-field-error"><%= campos.funcoes %></p><% } %>
 <div data-op-functions><% const funcoes=Array.isArray(dados.funcoes)?dados.funcoes:Object.values(dados.funcoes||{});(funcoes.length?funcoes:[{}]).forEach((f,i)=>{ %>
 <div class="op-function" data-op-function><div class="op-fields"><label>Profissão<select name="funcoes[<%= i %>][profissao_id]" required><option value="">Selecione uma profissão</option><% areas.forEach(a=>{ %><optgroup label="<%= a.rotulo %>"><% a.profissoes.forEach(p=>{ %><option value="<%= p.id %>" <%= f.profissao_id===p.id?'selected':'' %>><%= p.rotulo %></option><% }) %></optgroup><% }) %></select></label><label>Quantidade de vagas<input type="number" name="funcoes[<%= i %>][vagas]" min="1" max="1000" required value="<%= f.vagas||1 %>"></label>
 <% [['responsabilidades','Responsabilidades'],['requisitos','Requisitos obrigatórios'],['desejaveis','Requisitos desejáveis']].forEach(([n,t])=>{ %><label class="<%= n==='responsabilidades'?'op-wide':'' %>"><%= t %><textarea name="funcoes[<%= i %>][<%= n %>]" rows="3" <%= n==='responsabilidades'?'required':'' %>><%= f[n]||'' %></textarea></label><% }) %></div><% if(campos['funcoes.'+i]){ %><p class="op-field-error"><%= campos['funcoes.'+i] %></p><% } %><button type="button" class="op-text-link" data-op-remove>Remover função</button></div><% }) %></div>
 <button type="button" class="op-button" data-op-add><%- icones.plus %> Adicionar função</button></fieldset>
 <fieldset class="op-panel"><legend>Condições do trabalho</legend><div class="op-fields"><% select('modalidade','Modalidade',modosTrabalho);field('localizacao','Cidade ou região (obrigatória em trabalho presencial ou híbrido)');select('remuneracao','Remuneração ou colaboração',remuneracoes);field('valor','Valor declarado (R$, opcional)','number');select('unidade','Valor por',{projeto:'Projeto',hora:'Hora',mes:'Mês'});field('prazo','Candidaturas até (horário de Brasília)','date');field('inicio','Início previsto','date');field('fim','Término previsto','date');area('condicoes','Benefícios e condições adicionais'); %></div></fieldset>
 <% if(!consumidor){ %><fieldset class="op-panel"><legend>Vínculos opcionais</legend><p>Vincule registros existentes sob sua responsabilidade.</p><div class="op-fields"><% select('evento_id','Evento',{'':'Sem vínculo',...Object.fromEntries(eventos.map(e=>[e.id,e.titulo]))});select('projeto_id','Projeto',{'':'Sem vínculo',...Object.fromEntries(projetos.map(e=>[e.id,e.titulo]))}); %></div><a class="op-text-link" href="/work-projects" target="_blank" rel="noopener">Gerenciar meus projetos em outra aba</a></fieldset><% } %>
 <section class="op-panel op-review" data-op-summary hidden><h3>Revise sua chamada</h3><div data-op-summary-content></div><p>Confira as funções, vagas e condições antes de confirmar.</p></section>
 <div class="op-actions"><button type="button" class="op-button" data-op-preview>Revisar dados</button><% if(!consumidor&&!id){ %><button class="op-button" name="acao" value="rascunho">Salvar rascunho</button><% } %><button class="op-button op-primary" name="acao" value="publicar"><%= consumidor?'Enviar para análise':id?'Salvar alterações':'Publicar oportunidade' %></button></div>
</form>
