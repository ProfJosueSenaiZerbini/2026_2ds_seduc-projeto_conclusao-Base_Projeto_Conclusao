<header class="op-intro">
 <div><span class="op-eyebrow">Conexões de trabalho / Cypher</span><h2><%= contexto==='minhas'?'Faça suas ideias acontecerem.':contexto==='candidaturas'?'Seu próximo passo na cena.':'Seu talento encontra propósito.' %></h2><p><%= contexto==='minhas'?'Acompanhe suas chamadas, conheça os candidatos e construa os próximos acordos.':contexto==='candidaturas'?'Da primeira conversa ao acordo: acompanhe cada etapa das suas candidaturas.':'Serviços, projetos e colaborações. Encontre quem precisa do que você faz.' %></p></div>
 <div class="op-intro-action"><span class="op-mark" aria-hidden="true"><%- icones.briefcase %></span><% if(profissional){ %><a class="op-button op-primary" href="/opportunities/new"><%- icones.plus %> Criar oportunidade</a><% }else{ %><a class="op-button op-primary" href="/service-requests/new">Solicitar serviço</a><a class="op-text-link" href="/service-mediation">Encontrar um mediador</a><% } %></div>
</header>
<form class="op-filters" method="get" role="search" aria-label="Filtrar oportunidades">
 <div class="op-quick"><label class="op-search">Buscar oportunidades<div><%- icones.search %><input name="q" value="<%= filtros.q||'' %>" placeholder="Título, serviço ou palavra-chave" maxlength="120"></div></label>
 <label>Profissão<select name="profissao"><option value="">Todas as profissões</option><% profissoes.forEach(p=>{ %><option value="<%= p.id %>" <%= filtros.profissao===p.id?'selected':'' %>><%= p.rotulo %></option><% }) %></select></label>
 <label>Modalidade<select name="modalidade"><option value="">Todas</option><% Object.entries(modosTrabalho).forEach(([v,n])=>{ %><option value="<%= v %>" <%= filtros.modalidade===v?'selected':'' %>><%= n %></option><% }) %></select></label>
 <button class="op-button op-primary">Buscar</button></div>
 <div class="op-filter-bottom"><label>Finalidade<select name="tipo"><option value="">Todas as chamadas</option><% Object.entries(tiposChamada).forEach(([v,n])=>{ %><option value="<%= v %>" <%= filtros.tipo===v?'selected':'' %>><%= n %></option><% }) %></select></label>
 <label>Organizar por<select name="ordem"><% [['recentes','Mais recentes'],['antigas','Mais antigas'],['prazo','Prazo mais próximo']].forEach(([v,n])=>{ %><option value="<%= v %>" <%= filtros.ordem===v?'selected':'' %>><%= n %></option><% }) %></select></label>
 <details class="op-advanced"><summary><%- icones.sliders %> Mais filtros</summary><div class="op-fields">
 <label>Área<select name="area"><option value="">Todas as áreas</option><% areas.forEach(a=>{ %><option value="<%= a.id %>" <%= filtros.area===a.id?'selected':'' %>><%= a.rotulo %></option><% }) %></select></label>
 <label>Localização<input name="localizacao" value="<%= filtros.localizacao||'' %>" maxlength="150" placeholder="Cidade ou região"></label>
 <label>Remuneração<select name="remuneracao"><option value="">Todas as condições</option><% Object.entries(remuneracoes).forEach(([v,n])=>{ %><option value="<%= v %>" <%= filtros.remuneracao===v?'selected':'' %>><%= n %></option><% }) %></select></label>
 <label>Comparar valores por<select name="unidade"><option value="">Escolha para filtrar valores</option><% [['projeto','Projeto'],['hora','Hora'],['mes','Mês']].forEach(([v,n])=>{ %><option value="<%= v %>" <%= filtros.unidade===v?'selected':'' %>><%= n %></option><% }) %></select></label>
 <% [['min','Valor mínimo (R$)','number'],['max','Valor máximo (R$)','number'],['vagas','Mínimo de vagas livres','number'],['desde','Publicada desde','date'],['ate','Publicada até','date'],['prazo','Prazo de candidatura até','date']].forEach(([v,n,t])=>{ %><label><%= n %><input name="<%= v %>" type="<%= t %>" value="<%= filtros[v]||'' %>" <%- t==='number'?'min="0" step="0.01"':'' %>></label><% }) %>
 <% if(contexto!=='explorar'){ %><label>Situação<select name="estado"><option value="">Todas</option><% Object.entries(estadosChamada).forEach(([v,n])=>{ %><option value="<%= v %>" <%= filtros.estado===v?'selected':'' %>><%= n %></option><% }) %></select></label><% } %>
 <button class="op-button op-primary">Aplicar filtros</button></div></details>
 <a class="op-text-link" href="<%= contexto==='minhas'?'/my-opportunities':contexto==='candidaturas'?'/my-applications':'/opportunities' %>">Limpar filtros</a></div>
</form>
<div class="op-results-heading"><h3><%= contexto==='minhas'?'Suas chamadas':contexto==='candidaturas'?'Oportunidades em que você se candidatou':'Chamadas abertas' %></h3><span class="op-count"><%= total %> <%= total===1?'resultado':'resultados' %></span></div>
<div class="op-chips"><% Object.entries(filtros).filter(([k,v])=>v&&!['pagina','ok'].includes(k)).forEach(([k,v])=>{ %><a href="<%= url({[k]:'',pagina:''}) %>" aria-label="Remover filtro <%= k %>: <%= v %>"><%= ({q:'Busca',profissao:'Profissão',modalidade:'Modalidade',tipo:'Finalidade',area:'Área'})[k]||k %>: <%= profissoes.find(p=>p.id===v)?.rotulo||modosTrabalho[v]||tiposChamada[v]||v %> <span aria-hidden="true">×</span></a><% }) %></div>
<% if(itens.length){ %><div class="op-grid"><% itens.forEach(o=>{ %><article class="op-card">
 <div class="op-card-top"><span class="op-eyebrow"><%= tiposChamada[o.tipo] %></span><span class="op-state" data-state="<%= o.estado %>"><%= estadosChamada[o.estado] %></span></div>
 <h3><a href="/opportunities/<%= o.id %>"><%= o.titulo %></a></h3>
 <p class="op-roles"><%= o.funcoes.map(f=>f.nome).join(' / ') %></p>
 <p class="op-summary"><%= o.descricao %></p>
 <div class="op-author"><span class="op-avatar"><%= o.autor_nome?.slice(0,2).toUpperCase()||'CY' %></span><div><strong><%= o.autor_nome %></strong><small><%= o.pedido_id?'Pedido excepcional · gestão autorizada':o.profissoes %></small></div></div>
 <dl class="op-facts"><div><dt>Trabalho</dt><dd><%= modosTrabalho[o.modalidade] %><%= o.localizacao?' · '+o.localizacao:'' %></dd></div><div><dt>Condições</dt><dd><%= o.valor_centavos!==null?moeda(o.valor_centavos)+' / '+({mes:'mês',hora:'hora',projeto:'projeto'})[o.unidade]:remuneracoes[o.remuneracao] %></dd></div><div><dt>Vagas</dt><dd><%= o.vagas-o.ocupadas %> disponíveis / <%= o.vagas %></dd></div><div><dt>Candidaturas até</dt><dd><%= data(o.prazo) %></dd></div></dl>
 <% if(contexto==='minhas'){ %><p class="op-note"><%= o.candidaturas %> candidaturas · <%= o.ocupadas %> vagas ocupadas</p><% } %>
 <footer><span>Publicada <%= o.publicada_em?data(o.publicada_em):'após revisão' %></span><a href="/opportunities/<%= o.id %>">Ver chamada <%- icones.plus %></a></footer>
 </article><% }) %></div><% }else{ %><section class="op-empty"><span class="op-symbol"><%- icones.briefcase %></span><h3><%= Object.keys(filtros).length?'Nenhuma chamada com essa combinação.':contexto==='explorar'?'O próximo encontro pode começar com você.':'Seu caminho começa por aqui.' %></h3><p><%= contexto==='candidaturas'?'Explore as chamadas abertas e encontre uma oportunidade para sua atuação.':'As oportunidades aparecerão aqui conforme forem publicadas. Explore outros filtros ou apresente sua necessidade à comunidade.' %></p><a class="op-button" href="<%= profissional?'/opportunities/new':'/service-requests/new' %>"><%= profissional?'Criar uma chamada':'Solicitar um serviço' %></a></section><% } %>
<% if(paginas>1){ %><nav class="op-pagination" aria-label="Paginação"><% if(pagina>1){ %><a href="<%= url({pagina:String(pagina-1)}) %>">Anterior</a><% } %><span>Página <%= pagina %> de <%= paginas %></span><% if(pagina<paginas){ %><a href="<%= url({pagina:String(pagina+1)}) %>">Próxima</a><% } %></nav><% } %>
