<a class="op-text-link" href="<%= base %>">Voltar às oportunidades</a>
<header class="op-detail-heading"><div><span class="op-eyebrow"><%= tiposChamada[o.tipo] %><%= o.pedido_id?' · Pedido excepcional autorizado':'' %></span><h2><%= o.titulo %></h2><p>Por <strong><%= o.autor_nome %></strong><%= o.profissoes?' · '+o.profissoes:'' %></p><% if(o.identificador){ %><a class="op-text-link" href="/p/<%= encodeURIComponent(o.identificador.replace(/^@/,'')) %>">Ver perfil e portfólio público</a><% } %></div><span class="op-state" data-state="<%= o.estado %>"><%= estadosChamada[o.estado] %></span></header>
<% if(!administrativo){ %><%- include('../componentes/acoes-conteudo', { tipo:'oportunidade', id:o.id }) %><a class="op-text-link" href="/suporte/new?objeto_tipo=oportunidade&amp;objeto_id=<%= encodeURIComponent(o.id) %>">Denunciar esta chamada</a><% } %>
<div class="op-detail-grid"><div class="op-stack"><section class="op-panel"><h3>Sobre a chamada</h3><p class="op-prose"><%= o.descricao %></p><% if(o.contexto){ %><h4>Contexto</h4><p class="op-prose"><%= o.contexto %></p><% } %></section>
<section class="op-panel"><h3>Funções e vagas</h3><% o.funcoes.forEach(f=>{ %><div class="op-function"><div class="op-results-heading"><h4><%= f.nome %></h4><span class="op-count"><%= f.disponiveis %> de <%= f.vagas %> vagas livres</span></div><h5>Responsabilidades</h5><p class="op-prose"><%= f.responsabilidades %></p><% if(f.requisitos){ %><h5>Requisitos obrigatórios</h5><p class="op-prose"><%= f.requisitos %></p><% } %><% if(f.desejaveis){ %><h5>Desejáveis</h5><p class="op-prose"><%= f.desejaveis %></p><% } %></div><% }) %></section>
<% if(o.condicoes){ %><section class="op-panel"><h3>Condições adicionais</h3><p class="op-prose"><%= o.condicoes %></p></section><% } %>
<% if(candidaturas.length){ %><section class="op-panel"><h3><%= proprio?'Candidaturas recebidas':'Suas candidaturas' %> <span class="op-count"><%= candidaturas.length %></span></h3><div class="op-rows"><% candidaturas.forEach(c=>{ %><a href="<%= administrativo?'/admin/oportunidades/candidaturas':'/opportunities/applications' %>/<%= c.id %>"><div><strong><%= c.nome %></strong><small><%= profissoes.find(p=>p.id===c.profissao_id)?.rotulo %></small></div><span><%= estadosCandidatura[c.estado] %></span></a><% }) %></div></section><% } %>
<% if(proprio&&historico.length){ %><details class="op-panel"><summary>Histórico da oportunidade</summary><ol class="op-history"><% historico.forEach(h=>{ %><li><%= h.acao.replaceAll('_',' ') %> · <%= data(h.criado_em) %></li><% }) %></ol></details><% } %>
</div><aside class="op-stack"><section class="op-panel op-conditions"><h3>Condições da chamada</h3><dl class="op-facts"><div><dt>Modalidade</dt><dd><%= modosTrabalho[o.modalidade] %></dd></div><% if(o.localizacao){ %><div><dt>Região</dt><dd><%= o.localizacao %></dd></div><% } %><div><dt>Remuneração</dt><dd><%= o.valor_centavos!==null?moeda(o.valor_centavos)+' / '+o.unidade:remuneracoes[o.remuneracao] %></dd></div><div><dt>Vagas</dt><dd><%= o.ocupadas %> ocupadas / <%= o.vagas %> totais</dd></div><div><dt>Prazo de candidatura</dt><dd><%= data(o.prazo) %></dd></div><% if(o.inicio||o.fim){ %><div><dt>Execução prevista</dt><dd><%= o.inicio?data(o.inicio):'A combinar' %> a <%= o.fim?data(o.fim):'combinar' %></dd></div><% } %><div><dt>Publicação</dt><dd><%= o.publicada_em?data(o.publicada_em):'Rascunho' %></dd></div></dl>
<% if(o.evento){ %><a class="op-text-link" href="/events?localizacao=#evento-<%= o.evento.id %>">Evento: <%= o.evento.titulo %></a><% } %><% if(o.projeto){ %><a class="op-text-link" href="/work-projects/<%= o.projeto.id %>">Projeto: <%= o.projeto.titulo %></a><% } %></section>
<% if(proprio){ %><section class="op-panel"><h3>Gerenciar chamada</h3><% if(!o.pedido_id&&!['cancelada','encerrada'].includes(o.estado)){ %><a class="op-button" href="/opportunities/<%= o.id %>/edit">Editar informações</a><% } %><form method="post" action="<%= base %>/<%= o.id %>/state" data-confirm="Confirmar a alteração de situação? Candidaturas e acordos anteriores serão preservados."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Alterar situação<select name="estado"><% const transicoes={rascunho:['aberta','cancelada'],aberta:['pausada','encerrada','cancelada'],pausada:['aberta','encerrada','cancelada'],expirada:['aberta','cancelada'],encerrada:['aberta','cancelada'],cancelada:[]};transicoes[o.estado].forEach(e=>{ %><option value="<%= e %>"><%= estadosChamada[e] %></option><% }) %></select></label><% if(transicoes[o.estado].length){ %><button class="op-button">Confirmar mudança</button><% } %></form></section>
<% }else if(profissional&&o.estado==='aberta'&&!candidaturas.some(c=>!['recusada','retirada'].includes(c.estado))){ %><section class="op-panel"><h3>Seu talento cabe aqui?</h3><% const disponiveis=o.funcoes.filter(f=>ativas.includes(f.profissao_id)&&f.disponiveis>0);if(disponiveis.length){ %><form method="post" action="/opportunities/<%= o.id %>/applications"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Função<select name="funcao_id"><% disponiveis.forEach(f=>{ %><option value="<%= f.id %>"><%= f.nome %></option><% }) %></select></label><label>Apresentação (opcional)<textarea name="apresentacao" maxlength="2000" rows="4" placeholder="Conte por que este encontro faz sentido."></textarea></label><label class="op-check"><input type="checkbox" name="requisitos" value="sim" required> Li e atendo aos requisitos da função escolhida.</label><button class="op-button op-primary">Enviar candidatura</button><p class="op-note">O responsável recebe sua candidatura. A seleção abre a negociação; o acordo depende do aceite das duas partes.</p></form><% }else{ %><p>As funções disponíveis exigem uma profissão ativa compatível com seu perfil.</p><% } %></section><% }else if(!proprio){ %><section class="op-panel"><p><%= !profissional?'As candidaturas são destinadas a profissionais com atuação compatível.':o.estado!=='aberta'?'Esta chamada não está recebendo novas candidaturas.':'Sua candidatura já está registrada. Acompanhe a situação ao lado.' %></p></section><% } %>
</aside></div>
