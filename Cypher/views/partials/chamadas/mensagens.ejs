<header class="op-section-heading"><span class="op-eyebrow">Contato e negociação</span><h2><%= conversa?conversa.contexto:'Suas conversas' %></h2><p>Mensagens privadas, propostas e encontros profissionais.</p></header>
<% if(conversa){ %><%- include('conversa') %><% }else{ %><div class="op-detail-grid"><section class="op-panel op-rows"><% if(!conversas.length){ %><p>Sua caixa está vazia. As conversas de negociação e os pedidos de mediação aparecerão aqui.</p><% } %><% conversas.forEach(c=>{ %><a href="/messages/<%= c.id %>"><strong><%= c.contexto %></strong><span>Abrir conversa</span></a><% }) %></section><aside class="op-stack"><form class="op-panel" action="/messages/preferences" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>Quem pode entrar em contato</h3><label class="op-check"><input type="checkbox" name="profissionais" value="sim" <%= preferencias.profissionais?'checked':'' %>> Permitir mensagens profissionais</label><label class="op-check"><input type="checkbox" name="consumidores" value="sim" <%= preferencias.consumidores?'checked':'' %>> Receber pedidos de consumidores</label><button class="op-button">Salvar preferências</button></form><section class="op-panel"><h3>Contatos bloqueados</h3><% if(!bloqueados.length){ %><p>Nenhum contato bloqueado.</p><% } %><% bloqueados.forEach(b=>{ %><form method="post" action="/messages/block"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="alvo_id" value="<%= b.alvo_id %>"><span><%= b.nome||'Conta' %></span><button class="op-text-link" name="acao" value="desbloquear">Desbloquear</button></form><% }) %></section></aside></div><% } %>
