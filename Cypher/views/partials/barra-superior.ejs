<% if (usuario.tipoConta === 'administrativo') { %>
<header class="dc-header admin-header">
  <button class="dc-menu" type="button" data-sidebar-open aria-label="Abrir navegação administrativa" aria-controls="navegacao-principal" aria-expanded="false"><%- icones.menu %></button>
  <a class="dc-brand cypher-logo" href="/admin" aria-label="Cypher: painel da equipe"><span aria-hidden="true">CYPHER</span></a>
  <div class="dc-title admin-location"><span class="admin-header-label">BASTIDORES / EQUIPE</span><span class="admin-location-name"><%= breadcrumb %></span></div>
  <div class="admin-header-account"><span class="lucide-icon" aria-hidden="true"><%- icones.shieldCheck %></span><span><%= {super_admin:'Administrador Geral',moderador:'Moderador',editor:'Editor'}[usuario.papelAdministrativo] %></span></div>
</header>
<% } else { %>
<header class="topbar">
  <button class="icon-button mobile-menu" type="button" data-sidebar-open aria-label="Abrir menu de navegação">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.menu %>
    </span>
  </button>
  <div class="breadcrumbs">
    <span>
      Workspace
    </span>
    <span class="breadcrumb-separator" aria-hidden="true">
      /
    </span>
    <strong>
      <%= breadcrumb %>
    </strong>
  </div>
  <div class="topbar-actions">
    <%- include('componentes/busca-global') %>
    <%- include('componentes/acoes-conta') %>
  </div>
</header>

<% } %>
