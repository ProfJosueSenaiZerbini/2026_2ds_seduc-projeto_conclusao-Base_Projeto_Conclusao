<% if (usuario.tipoConta === 'administrativo') { %>
<%- include('navegacao-administrativa',{path,usuario}) %>
<% } else { %>
<aside class="sidebar" id="navegacao-principal">
  <div class="sidebar-scroll">
    <div class="sidebar-top">
      <div class="sidebar-brand-row">
        <a class="logo logo-compact" href="/dashboard" aria-label="Cypher — início">
          <span class="discovery-rail-mark" hidden aria-hidden="true"><%- icones.crown %></span>
          <span class="logo-mark" aria-hidden="true">
            <span>
            </span>
            <span>
            </span>
            <span>
            </span>
          </span>
          <span class="logo-word">
            CYPHER
          </span>
        </a>
        <div class="sidebar-theme">
          <%- include('componentes/tema-entrada') %>
        </div>
        <button class="icon-button mobile-close" type="button" data-sidebar-close aria-label="Fechar menu">
          <span class="lucide-icon" aria-hidden="true">
            <%- icones.x %>
          </span>
        </button>
      </div>
    </div>
    <nav class="side-nav" aria-label="Navegação principal">
      <div class="nav-label">
        WORKSPACE
      </div>
      <% const links = [
        { href: '/dashboard', label: 'Descoberta', icon: icones.house },
        ...(usuario.tipoConta === 'profissional' && !usuario.demonstracao ? [{ href: '/espaco-de-trabalho', label: 'Espaço de Trabalho', icon: icones.briefcase }] : []),
        { href: '/works', label: 'Obras', icon: icones.music },
        { href: '/work-projects', label: 'Trabalhos e galerias', icon: icones.brush },
        { href: '/beats', label: 'Banco de Beats', icon: icones.headphones },
        { href: '/events', label: 'Eventos', icon: icones.calendarDays },
        { href: '/opportunities', label: 'Oportunidades', icon: icones.briefcase },
        ...(usuario.tipoConta === 'profissional' && !usuario.demonstracao ? [{href:'/colaboracoes',label:'Colaborações',icon:icones.users}] : []),
      ]; %>
      <% links.forEach(link => { %>
        <% const ativo = path === link.href || (link.href === '/dashboard' && path === '/') || (link.href === '/works' && path.startsWith('/works/')) || (link.href === '/work-projects' && path.startsWith('/work-projects/')) || (link.href === '/colaboracoes' && path.startsWith('/colaboracoes/')); %>
        <a class="side-link<%= ativo ? ' active' : '' %>" aria-label="<%= link.label %>" href="<%= link.href %>" <%- ativo ? 'aria-current="page"' : '' %>>
          <span class="side-icon lucide-icon" aria-hidden="true">
            <%- link.icon %>
          </span>
          <span class="side-link-label">
            <%= link.label %>
          </span>
          <% if (link.count) { %>
            <b>
              <%= link.count %>
            </b>
          <% } %>
        </a>
      <% }) %>
    </nav>
    <div class="sidebar-bottom">
      <div class="resource-links" id="recursos-menu" popover="manual" aria-label="Opções da conta" hidden>
        <a class="side-link<%= path === '/profile' ? ' active' : '' %>" href="/profile">
          <span class="side-icon lucide-icon" aria-hidden="true">
            <%- icones.user %>
          </span>
          <span class="side-link-label">
            Meu perfil
          </span>
        </a>
        <a class="side-link<%= path === '/settings' ? ' active' : '' %>" href="/settings">
          <span class="side-icon lucide-icon" aria-hidden="true">
            <%- icones.settings %>
          </span>
          <span class="side-link-label">
            Configurações
          </span>
        </a>
<a class="side-link" href="/suporte"><span class="side-icon lucide-icon" aria-hidden="true"><%- icones.circleHelp %></span><span class="side-link-label">Falar com a Cypher</span></a>
        <a class="side-link<%= path === '/purchases' ? ' active' : '' %>" href="/purchases"><span class="side-icon lucide-icon" aria-hidden="true"><%- icones.headphones %></span><span class="side-link-label">Minhas Compras</span></a>
        <a class="side-link<%= path === '/central' ? ' active' : '' %>" href="/central">
          <span class="side-icon lucide-icon" aria-hidden="true">
            <%- icones.lightbulb %>
          </span>
          <span class="side-link-label">
            Cypher Central
          </span>
        </a>
        <% if (typeof interacao === 'function') { %>
          <a class="side-link<%= path === '/colecoes' ? ' active' : '' %>" href="/colecoes">
            <span class="side-icon lucide-icon" aria-hidden="true"><%- icones.listChecks %></span>
            <span class="side-link-label">Minha coleção</span>
          </a>
        <% } %>
        <a class="side-link<%= path === '/notificacoes' ? ' active' : '' %>" href="/notificacoes">
          <span class="side-icon lucide-icon" aria-hidden="true">
            <%- icones.bell %>
          </span>
          <span class="side-link-label">
            Notificações
          </span>
        </a>
        <% if (usuario.ehAdministrador) { %>
          <a class="side-link<%= path.startsWith('/admin/revisao') ? ' active' : '' %>" href="/admin/revisao">
            <span class="side-icon lucide-icon" aria-hidden="true">
              <%- icones.shieldCheck %>
            </span>
            <span class="side-link-label">
              Administrador
            </span>
          </a>
        <% } %>
      </div>

      <% if (usuario.tipoConta === 'profissional') { const rep = typeof resumoReputacao==='function'?resumoReputacao(usuario.id):{media:null,estado:'Ainda sem avaliações'}; %><a class="reputation-mini reputation-link" href="/colaboracoes" aria-label="Consultar reputação profissional">
        <div class="mini-heading"><span>REPUTAÇÃO</span><span class="lucide-icon" aria-hidden="true"><%- icones.badgeCheck %></span></div>
        <div class="rep-number"><%= rep.media===null?'—':rep.media.toFixed(1).replace('.',',') %><% if(rep.media!==null){ %><span>/ 5</span><% } %></div><p><%= rep.estado %></p>
      </a>
      <% } %><div class="sidebar-account-row">
      <a class="user-mini" href="/profile" aria-label="Abrir perfil de<%= usuario.name %>">
        <div class="avatar avatar-yellow">
          <%- include('componentes/avatar-usuario') %>
        </div>
        <div>
          <strong>
            <%= usuario.name %>
          </strong>
          <span>
            <%= usuario.role %>
          </span>
        </div>
      </a>
      <div class="sidebar-options">
        <input type="checkbox" id="sidebar-options-checkbox" class="sidebar-options-checkbox" aria-label="Opções da conta" aria-controls="recursos-menu" aria-expanded="false">
        <label for="sidebar-options-checkbox" class="sidebar-options-toggle" title="Opções da conta">
          <span class="sidebar-options-bar" aria-hidden="true"></span>
          <span class="sidebar-options-bar" aria-hidden="true"></span>
          <span class="sidebar-options-bar" aria-hidden="true"></span>
        </label>
      </div>
      </div>
    </div>
  </div>
</aside>

<% } %>
