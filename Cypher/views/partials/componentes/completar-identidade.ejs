<% if (!usuario.demonstracao && ['consumidor', 'profissional'].includes(usuario.tipoConta)) {
     const progresso = completudePerfil(usuario);
     const noPerfil = typeof sempre !== 'undefined' && sempre;
     if (noPerfil || progresso.pendencias.length) { %>
  <a class="profile-progress-summary" href="/profile/completar">
    <span>Progresso do perfil</span>
    <strong><%= progresso.percentual %>% completo</strong>
    <span class="profile-progress-arrow" aria-hidden="true"><%- icones.arrowRight %></span>
  </a>
<% } } %>
