<% { const faltam = pendenciasPerfil(usuario).length; if (faltam && (typeof apenasIdentidade === 'undefined' || !usuario.identidadeRevisada)) { %>
  <a class="profile-completion" href="/profile/completar">
    <span class="profile-completion-icon" aria-hidden="true"><%- icones.listChecks %></span>
    <span><strong>Complete seu perfil</strong><small><%= faltam === 1 ? 'Falta 1 informação' : 'Faltam ' + faltam + ' informações' %></small></span>
    <span class="profile-completion-arrow" aria-hidden="true"><%- icones.arrowRight %></span>
  </a>
<% } } %>
