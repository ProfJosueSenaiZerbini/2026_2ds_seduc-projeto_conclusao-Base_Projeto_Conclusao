<% const e = typeof interacao === 'function' ? interacao(tipo, id) : null;
   const lista = typeof colecaoAtual === 'string' ? colecaoAtual : ''; %>
<% if (e) { const endereco = '/interacoes/' + encodeURIComponent(tipo) + '/' + encodeURIComponent(id); %>
  <div class="ci-actions" role="group" aria-label="Interações com <%= e.alvo.titulo %>">
    <% if (!lista && (typeof ocultarCurtida === 'undefined' || !ocultarCurtida)) { %>
      <form method="post" action="<%= endereco %>/curtir" data-ci-action="curtir" data-ci-name="<%= e.alvo.titulo %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="ativo" value="<%= e.curtido ? 'nao' : 'sim' %>">
        <button class="ci-button ci-crown" type="submit" aria-pressed="<%= e.curtido %>" aria-label="Curtir <%= e.alvo.titulo %>, <%= e.curtidas %> <%= e.curtidas === 1 ? 'curtida' : 'curtidas' %>">
          <%- include('icone-beat', { tipo: 'crown' }) %>
          <span data-ci-count aria-hidden="true"><%= e.curtidas %></span>
        </button>
      </form>
    <% } %>
    <% const seguir = tipo === 'perfil';
       const marcada = seguir ? e.segue : e.salvo;
       const mostrarAcao = seguir ? e.podeSeguir || e.segue : (typeof ocultarSalvar === 'undefined' || !ocultarSalvar); %>
    <% if (mostrarAcao) { %>
      <form method="post" action="<%= endereco %>/<%= seguir ? 'seguir' : 'salvar' %>" <% if (!lista) { %>data-ci-action="<%= seguir ? 'seguir' : 'salvar' %>"<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="ativo" value="<%= marcada ? 'nao' : 'sim' %>">
        <% if (lista) { %><input type="hidden" name="colecao" value="<%= lista %>"><% } %>
        <% if (seguir) { %>
          <button class="ci-button" type="submit" aria-pressed="<%= marcada %>" aria-label="Seguir <%= e.alvo.titulo %>">
            <span data-ci-label><%= marcada ? 'Deixar de seguir' : 'Seguir' %></span>
          </button>
        <% } else { %>
          <%- include('botao-salvar', { salvo: !!marcada, alvo: e.alvo.titulo, desabilitado: false }) %>
        <% } %>
      </form>
    <% } %>
    <% if (!lista && tipo !== 'perfil' && (typeof ocultarComentarios === 'undefined' || !ocultarComentarios)) { %>
      <button class="ci-button ci-comment-trigger" type="button" data-ci-open="<%= endereco %>" data-ci-name="<%= e.alvo.titulo %>" aria-label="Comentários em <%= e.alvo.titulo %>" aria-haspopup="dialog" title="Comentários"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg></button>
    <% } %>
  </div>
<% } %>
