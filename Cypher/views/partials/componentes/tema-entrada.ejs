<nav class="entry-theme" aria-label="Aparência da página">
  <label class="theme-switch">
    <input type="checkbox" data-theme-toggle role="switch" aria-label="Tema escuro" title="Ativar tema escuro" <%= typeof temaPreferido === 'undefined' || temaPreferido !== 'light' ? 'checked' : '' %>>
    <span class="theme-switch__slider" aria-hidden="true">
      <span class="theme-switch__sun"><%- icones.sun %></span>
      <span class="theme-switch__moon"><%- icones.moon %></span>
    </span>
  </label>
</nav>
