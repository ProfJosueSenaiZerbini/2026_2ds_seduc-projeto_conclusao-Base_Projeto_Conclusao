<% if (item.grupo === 'eventos') { %>
  <%- include('evento-descoberta', { item }) %>
<% } else if (item.grupo === 'profissionais') { %>
  <%- include('cartao-profissional', { perfil: { id: item.userId, nome: item.titulo, handle: item.autor, profissoes: item.profissoes, iniciais: item.iniciais, local: item.local, detalhes: item.estilos, url: item.url } }) %>
<% } else if (item.lancamento) { %>
  <%- include('cartao-lancamento-cena', { item, lancamento: item.lancamento }) %>
<% } else { %>
  <%- include('cartao-obra-descoberta', { item }) %>
<% } %>

