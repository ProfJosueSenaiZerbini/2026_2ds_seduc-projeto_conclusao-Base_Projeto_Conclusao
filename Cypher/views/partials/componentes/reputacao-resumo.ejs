<div class="co-reputation"><span class="co-eyebrow">REPUTAÇÃO PROFISSIONAL</span><strong class="co-score"><%= resumo.media===null?'—':resumo.media.toFixed(1).replace('.',',')+' / 5' %></strong><span><%= resumo.estado %></span><% if(resumo.media!==null){ %><span class="co-stars" aria-label="<%= resumo.media.toFixed(1) %> de 5 estrelas"><%= '★'.repeat(Math.round(resumo.media)) %></span><% } %><small><%= resumo.avaliacoes %> avaliações liberadas · <%= resumo.avaliadores %> profissionais diferentes</small></div>
