<section class="ci-conversation" aria-label="Conversa da publicação">
  <div class="ci-messages" id="comentarios" tabindex="0" aria-label="Comentários">
    <% if(!comentarios.length){ %><p class="ci-empty">Seja a primeira pessoa a comentar.</p><% } %>
    <% for(const c of comentarios){ %>
    <article class="ci-message" id="comentario-<%= c.id %>">
      <% if(c.perfil){ %><a class="ci-avatar" href="<%= c.perfil %>" aria-label="Perfil de <%= c.autor %>"><% }else{ %><span class="ci-avatar" aria-hidden="true"><% } %>
        <% if(c.foto){ %><img src="/img/<%= c.foto %>" alt="" loading="lazy"><% }else{ %><%= c.iniciais %><% } %>
      <% if(c.perfil){ %></a><% }else{ %></span><% } %>
      <div class="ci-message-body"><header><strong><% if(c.perfil){ %><a href="<%= c.perfil %>"><%= c.autor %></a><% }else{ %><%= c.autor %><% } %></strong><time><%= data(c.criadoEm) %><%= c.editado?' · Editado':'' %></time></header><p><%= c.texto %></p>
      <% if(c.proprio){ %><details class="ci-message-edit"><summary>Editar</summary><form method="post" action="<%= base %>/comentarios/<%= c.id %>/editar" data-ci-comment="editar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= c.versao %>"><label class="sr-only" for="ci-edit-<%= c.id %>">Editar comentário</label><textarea id="ci-edit-<%= c.id %>" name="texto" maxlength="1500" required rows="2"><%= c.texto %></textarea><button class="ci-text-action" type="submit">Salvar edição</button></form></details><form method="post" action="<%= base %>/comentarios/<%= c.id %>/excluir" data-ci-comment="excluir"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= c.versao %>"><button class="ci-text-action" type="submit">Excluir</button></form><% } %>
      </div>
      <% if(!c.proprio){ %><details class="ci-message-menu"><summary aria-label="Opções do comentário" title="Opções">•••</summary><a href="/suporte/new?objeto_tipo=comentario&amp;objeto_id=<%= c.id %>">Denunciar</a></details><% } %>
    </article><% } %>
  </div>
  <form method="post" action="<%= base %>/comentarios" class="ci-composer" data-ci-comment="publicar">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="envio" value="<%= envio %>">
    <% if(usuario.protecaoMenor){ %><p class="ci-private-note">Seu comentário fica visível somente para você.</p><% } %>
    <label class="sr-only" for="ci-write">Adicionar comentário</label><div class="ci-compose-field"><textarea id="ci-write" name="texto" rows="1" maxlength="1500" required placeholder="Entre na conversa…" aria-describedby="ci-write-hint"><%= texto %></textarea><button type="submit" class="ci-send ci-icon" aria-label="Publicar comentário" title="Publicar comentário"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 7-7 7 7M12 5v15"/></svg></button></div><small id="ci-write-hint">Enter envia · Shift + Enter quebra a linha</small>
  </form>
</section>
