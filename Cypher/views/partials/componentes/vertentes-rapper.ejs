<fieldset class="profile-category-fieldset rapper-branches" data-rapper-branches hidden>
  <legend>Vertentes do Rap</legend><p>Se quiser, selecione as vertentes com que se identifica.</p>
  <input type="hidden" name="vertentesPresentes" value="1">
  <div class="category-grid"><% vertentesDisponiveis.forEach(vertente => { %>
    <label class="category-option"><input type="checkbox" name="vertentes" value="<%= vertente %>" <%= vertentesSelecionadas.includes(vertente) ? 'checked' : '' %>><span><%= vertente %></span></label>
  <% }) %></div>
</fieldset>
