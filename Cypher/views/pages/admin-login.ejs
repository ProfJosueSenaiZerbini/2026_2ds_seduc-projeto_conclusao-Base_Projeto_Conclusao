<%- include('../partials/cabecalho', { title, stylesheet, temaFixoAdmin: true }) %>
<link rel="stylesheet" href="/css/entrada.css">
<link rel="stylesheet" href="/css/admin-login.css">
<main class="tag-page entrada-cypher admin-access">
  <a class="tag-brand" href="/admin/login" aria-label="Cypher, acesso da administração">CYPHER <span>/ ADMIN</span></a>
  <div class="tag-content">
    <div class="tag-shell">
      <section class="tag-panel auth-panel" aria-labelledby="admin-login-title">
        <p class="admin-access-badge">ÁREA RESTRITA · EQUIPE CYPHER</p>
        <h1 id="admin-login-title">Acesso da <em class="login-cena">administração</em></h1>
        <p class="admin-access-description">Entre com sua conta administrativa para acessar os bastidores da Cypher.</p>
        <%- include('../partials/componentes/olhos-senha') %>
        <% if (erro) { %>
          <p class="auth-message auth-message-error" role="alert"><%= erro %></p>
        <% } %>
        <form method="post" action="/admin/login">
          <label>E-mail da equipe
            <input type="email" name="email" value="<%= email %>" placeholder="voce@equipe.com" maxlength="254" autocomplete="username" autocapitalize="none" spellcheck="false" required>
          </label>
          <label>Senha
            <input type="password" name="password" placeholder="••••••••" maxlength="128" autocomplete="current-password" required>
          </label>
          <button class="button button-lime full" type="submit">
            Entrar na administração
            <span class="lucide-icon" aria-hidden="true"><%- icones.arrowUpRight %></span>
          </button>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        </form>
        <p class="join-cypher">Quer entrar na Cypher? <a href="/login">Acesse sua conta pessoal <span aria-hidden="true"><%- icones.arrowUpRight %></span></a></p>
      </section>
    </div>
  </div>
</main>
<%- include('../partials/fim-pagina') %>
