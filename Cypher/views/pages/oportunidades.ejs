<%- include('../partials/cabecalho', { title, stylesheet }) %>
<%
  function urlCategoria(categoria) {
    const params = new URLSearchParams();
    if (q) params.set('q', q);
    if (categoria) params.set('categoria', categoria);
    if (localizacaoSelecionada !== undefined) params.set('localizacao', localizacaoSelecionada);
    if (filtros.formato) params.set('formato', filtros.formato);
    if (filtros.periodo !== 'todos') params.set('periodo', filtros.periodo);
    if (filtros.ordem !== 'recentes') params.set('ordem', filtros.ordem);
    return '/events' + (params.size ? '?' + params : '');
  }

  const rotulosCategorias = new Map([
    ['Batalha', 'Batalhas'], ['Show', 'Shows'], ['Cypher', 'Cyphers'],
    ['Workshop', 'Workshops'], ['Outro', 'Outros'],
  ]);
  const limparFiltros = '/events?localizacao=';
  const filtrosBusca = { ...filtros, localizacao: localizacaoSelecionada };
  if (filtrosBusca.periodo === 'todos') delete filtrosBusca.periodo;
  if (filtrosBusca.ordem === 'recentes') delete filtrosBusca.ordem;
  const erros = {
    permissao: 'Sua conta precisa ter permissão para cadastrar e gerenciar eventos.',
    evento: 'O evento não foi encontrado ou não pertence à sua conta.',
  };
%>
<div class="dc-shell events-page">
  <a class="dc-skip" href="#conteudo-eventos">Pular para o conteúdo</a>
  <%- include('../partials/barra-lateral', { path }) %>
  <div class="dc-page">
    <%- include('../partials/componentes/cabecalho-descoberta', {
      titulo: 'Eventos',
      tituloId: 'titulo-eventos',
      descricao: 'Batalhas, shows, cyphers e encontros da cena.',
      busca: {
        acao: '/events',
        termo: q,
        limite: 120,
        rotulo: 'Evento, local ou organizador',
        filtros: filtrosBusca,
        filtrosVazios: ['localizacao']
      }
    }) %>

    <main class="dc-content" id="conteudo-eventos" aria-labelledby="titulo-eventos" tabindex="-1">
      <% if (mensagem) { %>
        <p class="events-feedback" role="status"><%= mensagem %></p>
      <% } %>
      <% if (erro) { %>
        <p class="events-feedback" role="alert"><%= Object.hasOwn(erros, erro) ? erros[erro] : erro %></p>
      <% } %>

      <div class="dc-controls events-controls">
        <nav class="dc-tabs events-categories" aria-label="Filtrar eventos por categoria" data-query-param="categoria">
          <a href="<%= urlCategoria('') %>"<% if (!filtros.categoria) { %> aria-current="page"<% } %>><span aria-hidden="true"><%- icones.calendarDays %></span> Todos</a>
          <% opcoesCategorias.forEach(categoria => { %>
            <a href="<%= urlCategoria(categoria) %>"<% if (categoria === filtros.categoria) { %> aria-current="page"<% } %>><%= rotulosCategorias.get(categoria) ?? categoria %></a>
          <% }) %>
        </nav>

        <form class="events-location-form" action="/events" method="get" role="search" aria-label="Localização dos eventos">
          <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
          <% for (const [nome, valor] of Object.entries(filtrosBusca)) { if (nome !== 'localizacao' && valor) { %>
            <input type="hidden" name="<%= nome %>" value="<%= valor %>">
          <% }} %>
          <%- include('../partials/componentes/campo-busca', { campo: { id: 'localizacao-eventos', nome: 'localizacao', valor: filtros.localizacao, limite: 100, rotulo: 'Cidade e bairro', rotuloBotao: 'Filtrar por cidade e bairro' } }) %>
        </form>

        <details class="dc-filter events-refinement<%= refinoAtivo ? ' events-refinement-active' : '' %>">
          <summary aria-label="Filtros" title="Filtros"><span aria-hidden="true"><%- icones.sliders %></span></summary>
          <form action="/events" method="get">
            <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
            <% if (filtros.categoria) { %><input type="hidden" name="categoria" value="<%= filtros.categoria %>"><% } %>

            <% if (localizacaoSelecionada !== undefined) { %>
              <input type="hidden" name="localizacao" value="<%= localizacaoSelecionada %>">
            <% } %>
            <% if (opcoesFormatos.length) { %>
              <label>Formato
                <select name="formato">
                  <option value="">Todos os formatos</option>
                  <% opcoesFormatos.forEach(formato => { %>
                    <option value="<%= formato %>"<% if (formato === filtros.formato) { %> selected<% } %>><%= formato %></option>
                  <% }) %>
                </select>
              </label>
            <% } %>
            <label>Período
              <select name="periodo">
                <option value="todos">Todos os períodos</option>
                <option value="proximos"<% if (filtros.periodo === 'proximos') { %> selected<% } %>>Próximos eventos</option>
                <option value="passados"<% if (filtros.periodo === 'passados') { %> selected<% } %>>Eventos passados</option>
              </select>
            </label>
            <label>Ordenar por
              <select name="ordem">
                <option value="recentes">Mais recentes</option>
                <option value="data"<% if (filtros.ordem === 'data') { %> selected<% } %>>Data do evento</option>
                <option value="titulo"<% if (filtros.ordem === 'titulo') { %> selected<% } %>>Título</option>
              </select>
            </label>
            <button type="submit">Aplicar filtros</button>
          </form>
        </details>

        <% if (podeGerenciar) { %>
          <a class="dc-primary" href="/events/new"><span aria-hidden="true"><%- icones.plus %></span> Cadastrar evento</a>
        <% } %>
      </div>

      <section aria-labelledby="titulo-agenda-eventos">
        <header class="dc-heading events-heading">
          <h2 id="titulo-agenda-eventos"><%= q ? 'Resultados para “' + q + '”' : 'Agenda de eventos' %></h2>
          <div class="events-heading-actions">
            <span class="cy-count-sticker"><%= eventos.length %> <%= eventos.length === 1 ? 'evento' : 'eventos' %></span>
            <% if (filtrado) { %>
              <a href="<%= limparFiltros %>">Limpar filtros <span aria-hidden="true"><%- icones.x %></span></a>
            <% } %>
          </div>
        </header>

        <% if (eventos.length) { %>
          <div class="events-catalog">
            <% eventos.forEach(({ item, evento }) => { %>
              <%- include('../partials/componentes/evento-descoberta', { item, evento }) %>
            <% }) %>
          </div>
        <% } else { %>
          <div class="dc-empty">
            <%- filtrado ? icones.search : icones.calendarDays %>
            <div>
              <strong><%= filtrado ? 'Nenhum evento encontrado.' : 'Ainda não há eventos na agenda.' %></strong>
              <% if (filtrado) { %><p>Tente outro termo ou ajuste os filtros.</p><% } %>
            </div>
          </div>
        <% } %>
      </section>
    </main>
    <%- include('../partials/navegacao-mobile', { rotaAtual: '/events' }) %>
  </div>

  <%- include('../partials/componentes/ficha-evento') %>
</div>
<script src="/js/descoberta.js" defer></script>
<%- include('../partials/fim-pagina') %>
