<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="dc-shell pf-shell">
  <a class="dc-skip" href="#progresso">Pular para o progresso</a>
  <%- include('../partials/barra-lateral', { path }) %>
  <div class="dc-page">
    <%- include('../partials/componentes/cabecalho-descoberta', {titulo: title, tituloId: 'titulo-progresso', descricao: ''}) %>
    <main class="pf-page" id="progresso" aria-labelledby="titulo-progresso">
      <section class="pf-panel profile-progress-details" aria-labelledby="progresso-essencial">
        <header class="pf-section-head">
          <h2 id="progresso-essencial">Informações essenciais</h2>
          <a class="pf-link" href="/profile">Voltar ao perfil</a>
        </header>
        <div class="profile-progress-value">
          <strong><%= completude.percentual %>% completo</strong>
          <progress max="100" value="<%= completude.percentual %>" aria-labelledby="progresso-essencial"></progress>
        </div>
        <% if (completude.pendencias.length) { %>
          <ul class="profile-progress-links">
            <% completude.pendencias.forEach(item => { %>
              <li><a href="<%= item.url %>"><%= item.rotulo %> <%- icones.arrowRight %></a></li>
            <% }); %>
          </ul>
        <% } else { %>
          <p>Você preencheu as informações essenciais do seu perfil.</p>
        <% } %>
      </section>
      <% if (completude.sugestoes.length) { %>
        <section class="pf-panel profile-progress-details profile-progress-optional" aria-labelledby="progresso-desenvolvimento">
          <header class="pf-section-head">
            <h2 id="progresso-desenvolvimento">Desenvolvimento profissional</h2>
          </header>
          <p>Sugestões opcionais para aprofundar sua apresentação.</p>
          <ul class="profile-progress-links">
            <% completude.sugestoes.forEach(item => { %>
              <li><a href="<%= item.url %>"><%= item.rotulo %> <%- icones.arrowRight %></a></li>
            <% }); %>
          </ul>
        </section>
      <% } %>
    </main>
    <%- include('../partials/navegacao-mobile', {rotaAtual: path}) %>
  </div>
</div>
<%- include('../partials/fim-pagina') %>
