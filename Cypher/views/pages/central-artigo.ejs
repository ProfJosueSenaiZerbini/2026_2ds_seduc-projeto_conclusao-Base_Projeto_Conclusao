<%- include('../partials/cabecalho',{title,stylesheet}) %>
<% const emPrevia=typeof preview!=='undefined'&&preview;const administrativo=usuario.tipoConta==='administrativo'; %>
<div class="<%= administrativo?'app-shell dc-shell admin-shell':'dc-shell cn-shell' %>"><a class="dc-skip" href="#central-artigo">Pular para o guia</a><%- include('../partials/barra-lateral',{path}) %><div class="<%= administrativo?'main-shell':'dc-page' %>">
<% if(administrativo){ %><%- include('../partials/barra-superior',{breadcrumb:'Prévia da Central'}) %><% }else{ %><%- include('../partials/componentes/cabecalho-descoberta',{titulo:'Cypher Central',tituloId:'central-titulo',descricao:'Informação direta. Um passo de cada vez.'}) %><% } %>
<main class="cn-page" id="central-artigo" aria-labelledby="central-artigo-titulo" tabindex="-1">
  <a class="cn-back" href="<%= administrativo?'/admin/central/'+artigo.id+'/edit':'/central' %>"><span class="lucide-icon" aria-hidden="true"><%- icones.arrowLeft %></span> Explorar a Central</a>
  <% if(emPrevia){ %><p class="cn-notice" role="status">Prévia editorial do rascunho salvo. Este conteúdo ainda pode ser diferente da versão disponível aos leitores; esta visita não registra leitura ou retorno.</p><% } %>
  <% const nomeCategoria=typeof categorias!=='undefined'?categorias.find(c=>c.id===artigo.categoria)?.nome || artigo.categoria:artigo.categoria; %>
  <header class="cn-article-header"><span class="cn-eyebrow"><%= nomeCategoria %></span><h2 id="central-artigo-titulo"><%= artigo.titulo %></h2><p class="cn-lead"><%= artigo.resumo %></p><div class="cn-article-meta"><span><%= artigo.minutos %> min de leitura</span><span><%= artigo.passos.length %> <%= artigo.passos.length===1?'passo prático':'passos práticos' %></span><span>Orientação da equipe Cypher</span></div></header>
  <div class="cn-article-body"><div class="cn-article-content">
    <div class="cn-roadmap" aria-label="Como usar este guia"><span><b>1</b> Entenda o caminho</span><span aria-hidden="true">→</span><span><b>2</b> Abra cada etapa</span><span aria-hidden="true">→</span><span><b>3</b> Aplique na prática</span></div>
    <section aria-labelledby="central-passos-titulo"><header class="cn-section-heading"><div><span class="cn-eyebrow">DO ENTENDIMENTO À AÇÃO</span><h3 id="central-passos-titulo">Vamos por partes.</h3></div><button class="cn-text-button" type="button" data-cn-expandir>Expandir etapas</button></header><div class="cn-steps" data-cn-passos>
    <% artigo.passos.forEach((p,i)=>{ %><details class="cn-step" <%= i===0?'open':'' %>><summary><b><%= String(i+1).padStart(2,'0') %></b><span><%= p.titulo %></span></summary><div class="cn-step-body"><p class="cn-prose"><%= p.conteudo %></p><% if(p.dica){ %><aside class="cn-step-tip"><strong>Fica a dica</strong><p><%= p.dica %></p></aside><% } %><label class="cn-check cn-complete"><input type="checkbox" data-cn-concluido="<%= i %>"> Entendi esta etapa</label></div></details><% }) %>
    </div></section>
    <% if(artigo.exemplo){ %><aside class="cn-example"><span class="cn-eyebrow">NA PRÁTICA</span><h3>Como isso pode aparecer na cena</h3><p class="cn-prose"><%= artigo.exemplo %></p><small>Este cenário explica uma possibilidade. Não cria permissões nem garante uma parceria.</small></aside><% } %>
    <% if(!emPrevia){ %><section class="cn-panel" aria-labelledby="central-feedback-titulo"><h3 id="central-feedback-titulo">Este guia ajudou?</h3><p class="cn-note">Seu retorno orienta a revisão deste conteúdo. Você pode atualizar sua resposta; ele conta uma única vez.</p><% if(salvo){ %><p class="cn-notice" role="status">Obrigado. Seu retorno foi registrado.</p><% } %>
    <form class="cn-form" method="post" action="/central/<%= encodeURIComponent(artigo.slug) %>/feedback" data-cn-feedback><input type="hidden" name="_csrf" value="<%= csrfToken %>"><fieldset class="cn-feedback-choice"><legend class="cn-sr">Avaliação de utilidade</legend><label class="cn-check"><input type="radio" name="util" value="sim" required <%= feedback?.util===1?'checked':'' %>> Foi útil</label><label class="cn-check"><input type="radio" name="util" value="nao" <%= feedback?.util===0?'checked':'' %>> Ainda preciso de ajuda</label></fieldset><div class="cn-feedback-fields" data-cn-feedback-negativo><label>O que pode melhorar?<select name="motivo"><option value="">Escolha um motivo</option><% motivos.forEach(m=>{ %><option value="<%= m.id %>" <%= feedback?.motivo===m.id?'selected':'' %>><%= m.nome %></option><% }) %></select></label><label>Explique em poucas palavras<textarea name="comentario" maxlength="1000" rows="3" placeholder="Não inclua senhas, documentos ou dados privados."><%= feedback?.comentario||'' %></textarea></label><p class="cn-note">Ao escolher “Outro motivo”, explique a dificuldade em pelo menos 10 caracteres.</p></div><button class="cn-button cn-primary" type="submit">Enviar retorno</button></form></section><% } %>
  </div>
  <aside class="cn-side"><section class="cn-panel"><span class="cn-eyebrow">SEU RITMO</span><h3>Um passo de cada vez.</h3><label for="cn-progresso" class="cn-note" id="cn-progresso-texto">0 de <%= artigo.passos.length %> etapas compreendidas</label><progress id="cn-progresso" value="0" max="<%= Math.max(1,artigo.passos.length) %>" aria-labelledby="cn-progresso-texto"></progress><p class="cn-note">Marque as etapas que já entendeu. Esse progresso fica apenas nesta página, sem gerar avaliações ou métricas sobre você.</p><% if(artigo.acao_url&&artigo.acao_label&&!administrativo){ %><a class="cn-button cn-primary" href="<%= artigo.acao_url %>"><%= artigo.acao_label %><span class="lucide-icon" aria-hidden="true"><%- icones.arrowUpRight %></span></a><% } %></section>
  <% if(relacionados.length){ %><section class="cn-panel"><span class="cn-eyebrow">CONTINUE POR AQUI</span><h3>Próximas descobertas</h3><div class="cn-related-list"><% relacionados.forEach(a=>{ %><a href="/central/<%= encodeURIComponent(a.slug) %>"><strong><%= a.titulo %></strong><small><%= a.minutos %> min de leitura</small></a><% }) %></div></section><% } %>
  </aside></div>
</main><% if(!administrativo){ %><%- include('../partials/navegacao-mobile',{rotaAtual:path}) %><% } %></div></div><script src="/js/central-nova.js" defer></script><%- include('../partials/fim-pagina') %>
