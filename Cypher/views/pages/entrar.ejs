<%- include('../partials/cabecalho', { title, stylesheet }) %>
<link rel="stylesheet" href="/css/entrada.css"><main class="tag-page entrada-cypher"><a class="tag-brand" href="/login" aria-label="Cypher, entrar">CYPHER</a><%- include('../partials/componentes/tema-entrada') %><div class="tag-content"><div class="tag-shell"><section class="tag-panel auth-panel"><h1>Vamo movimentar essa <em class="login-cena">cena</em></h1><%- include('../partials/componentes/olhos-senha') %><% if (mensagem) { %>
      <p class="auth-message auth-message-success" role="status">
        <%= mensagem %>
      </p>
    <% } %>
    <% if (erro) { %>
      <p class="auth-message auth-message-error" role="alert">
        <%= erro %>
      </p>
    <% } %>
    <form method="post" action="/login">
      <label>
        E-mail ou usuário
        <input type="text" name="identificador" value="<%= email ?? '' %>" placeholder="voce@email.com ou @usuario" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="254" required>
      </label>
      <label>
        Senha
        <input type="password" name="password" placeholder="••••••••" maxlength="128" autocomplete="current-password" required>
      </label>
      <p class="auth-switch login-recuperacao"><a href="/recuperar-senha">Esqueci minha senha</a></p>
      <button class="button button-lime full" type="submit">
        Entrar
        <span class="lucide-icon" aria-hidden="true">
          <%- icones.arrowUpRight %>
        </span>
      </button>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>


    <p class="join-cypher">Chega junto. <a href="/register">Crie sua conta <span aria-hidden="true"><%- icones.arrowUpRight %></span></a></p>
    <p class="auth-switch login-confirmacao"><a href="/email/pendente">Confirmar e-mail</a></p>
  </section></div></div></main><%- include('../partials/fim-pagina') %>
