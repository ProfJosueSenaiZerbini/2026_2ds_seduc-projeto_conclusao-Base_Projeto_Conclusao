<%- include('../partials/cabecalho', { title, stylesheet }) %>
<%
  function urlGenero(valor) {
    const parametros = new URLSearchParams();
    if (q) parametros.set('q', q);
    if (valor) parametros.set('genero', valor);
    if (licenca) parametros.set('licenca', licenca);
    return '/beats' + (parametros.size ? '?' + parametros : '');
  }

  const mensagens = {
    criado: 'Beat cadastrado com sucesso.',
    atualizado: 'Beat atualizado com sucesso.',
    excluido: 'Beat excluído com sucesso.',
    permissao: 'Sua conta precisa ter a categoria Beatmaker para cadastrar novos beats.'
  };
%>
<div class="dc-shell banco-beats" data-favorites-key="cypher-beats-favoritos:<%= usuario.id || 'visitante' %>">
  <a class="dc-skip" href="#conteudo-beats">Pular para o conteúdo</a>
  <%- include('../partials/barra-lateral', { path }) %>
  <div class="dc-page">
    <%- include('../partials/componentes/cabecalho-descoberta', {
      titulo: 'Banco de Beats', tituloId: 'titulo-banco-beats', descricao: 'Encontre a batida. Faça a sua história.',
      busca: { acao: '/beats', termo: q, limite: 120, rotulo: 'Título, beatmaker, gênero ou BPM', filtros: { genero, licenca } }
    }) %>
    <main class="dc-content" id="conteudo-beats" aria-labelledby="titulo-banco-beats" tabindex="-1">
      <% if (Object.hasOwn(mensagens, resultado)) { %>
        <p class="beats-feedback" role="<%= resultado === 'permissao' ? 'alert' : 'status' %>"><%= mensagens[resultado] %></p>
      <% } %>

      <% if (!filtrado) { %>
        <section class="beats-studio" aria-labelledby="beats-studio-title">
          <div class="beats-studio-copy">
            <span class="dc-stamp">Do quarto pro mundo</span>
            <h2 id="beats-studio-title">Sua próxima faixa<br><em>começa aqui.</em></h2>
            <p>Batidas com identidade pra quem tem algo a dizer. Explore a cena e encontre o som da sua próxima ideia.</p>
            <div class="beats-studio-actions">
              <a class="dc-primary" href="#catalogo-beats">Encontrar meu beat <span aria-hidden="true"><%- icones.arrowRight %></span></a>
              <% if (podeCadastrarBeat) { %><a class="beats-link" href="/beats/new">Publicar meu som <span aria-hidden="true"><%- icones.plus %></span></a><% } %>
            </div>
            <div class="beats-studio-note"><span aria-hidden="true"><%- icones.headphones %></span> Produção independente. Identidade de sobra.</div>
          </div>
          <% if (destaque) { %>
            <div class="beats-spotlight">
              <div class="beats-spotlight-label"><span><i aria-hidden="true"></i> Na agulha</span><span>SELEÇÃO CYPHER / 01</span></div>
              <div class="beats-spotlight-record">
                <div class="beats-vinyl" aria-hidden="true"><span>CYPHER<br>SIDE A</span></div>
                <img src="/img/<%= imagemPublicacaoDemo(destaque.id) %>" alt="Capa de <%= destaque.title %>" decoding="async" fetchpriority="high">
                <span class="beats-spotlight-sticker" aria-hidden="true">FEITO<br>PRA RIMAR.</span>
              </div>
              <div class="beats-spotlight-info"><div><h3><%= destaque.title %></h3><p><%= destaque.producer %> · <%= destaque.genre %> · <%= destaque.bpm %> BPM</p></div><a href="#beat-<%= destaque.id %>" aria-label="Ver detalhes de <%= destaque.title %>"><%- icones.arrowUpRight %></a></div>
              <%- include('../partials/componentes/player-previa-beat', { beat: destaque }) %>
            </div>
          <% } else { %>
            <div class="beats-studio-empty-art" aria-hidden="true"><%- icones.disc %><span>INDEPENDENTE<br>POR NATUREZA.</span></div>
          <% } %>
        </section>
      <% } %>

      <section class="beats-discovery" id="catalogo-beats" aria-labelledby="titulo-catalogo-beats">
        <header class="dc-heading beats-heading">
          <div><span class="beats-eyebrow">Escolha a sua frequência</span><h2 id="titulo-catalogo-beats"><%= q ? 'Resultados para “' + q + '”' : 'Dê play na sua próxima ideia' %></h2></div>
          <div class="beats-heading-actions">
            <span class="cy-count-sticker" data-beats-count><%= beats.length %> <%= beats.length === 1 ? 'beat' : 'beats' %></span>
            <% if (filtrado) { %><a href="/beats">Limpar filtros <span aria-hidden="true"><%- icones.x %></span></a><% } %>
          </div>
        </header>

      <% if (generos.length || licencas.length || podeCadastrarBeat) { %>
        <div class="dc-controls beats-controls">
          <% if (generos.length) { %>
            <nav class="dc-tabs beats-genres" aria-label="Filtrar beats por gênero">
              <a href="<%= urlGenero('') %>"<% if (!genero) { %> aria-current="page"<% } %>><span aria-hidden="true"><%- icones.headphones %></span> Todos</a>
              <% generos.forEach(opcao => { %>
                <a href="<%= urlGenero(opcao) %>"<% if (opcao === genero) { %> aria-current="page"<% } %>><%= opcao %></a>
              <% }) %>
            </nav>
          <% } %>
          <% if (licencas.length) { %>
            <details class="dc-filter beats-license-filter">
              <summary><span aria-hidden="true"><%- icones.sliders %></span> <%= licenca || 'Licença' %></summary>
              <form action="/beats">
                <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
                <% if (genero) { %><input type="hidden" name="genero" value="<%= genero %>"><% } %>
                <label>Tipo de licença
                  <select name="licenca">
                    <option value="">Todas as licenças</option>
                    <% licencas.forEach(opcao => { %>
                      <option value="<%= opcao %>"<% if (opcao === licenca) { %> selected<% } %>><%= opcao %></option>
                    <% }) %>
                  </select>
                </label>
                <button type="submit">Aplicar filtro</button>
              </form>
            </details>
          <% } %>
          <% if (podeCadastrarBeat && filtrado) { %>
            <a class="dc-primary beats-publish" href="/beats/new"><span aria-hidden="true"><%- icones.plus %></span> Cadastrar beat</a>
          <% } %>
        </div>
      <% } %>

        <% if (beats.length) { %>
          <div class="beats-toolbar" data-beats-toolbar hidden>
            <button type="button" class="beats-favorites-filter" data-favorites-filter aria-pressed="false"><span aria-hidden="true"><%- include('../partials/componentes/icone-beat', { tipo: 'heart' }) %></span> Meus favoritos <span data-favorites-count>0</span></button>
            <label class="beats-sort">Ordenar por <select data-beats-sort aria-label="Ordenar beats"><option value="original">Seleção Cypher</option><option value="price">Menor preço</option><option value="bpm">BPM crescente</option><option value="title">Título A–Z</option></select><span aria-hidden="true"><%- icones.chevronDown %></span></label>
          </div>
          <div class="beats-catalog">
            <% beats.forEach((beat, indice) => { %><%- include('../partials/componentes/cartao-beat', { beat, indice }) %><% }) %>
          </div>
          <div class="dc-empty beats-favorites-empty" data-favorites-empty hidden><%- include('../partials/componentes/icone-beat', { tipo: 'heart' }) %><div><strong>Nenhum favorito nesta seleção.</strong><p>Toque no coração dos beats que combinam com você.</p><button class="beats-link" type="button" data-show-all-beats>Explorar todos os beats</button></div></div>
        <% } else { %>
          <div class="dc-empty">
            <%- filtrado ? icones.search : icones.headphones %>
            <div>
              <strong><%= filtrado ? 'Nenhum beat encontrado.' : 'Ainda não há beats no catálogo.' %></strong>
              <% if (filtrado) { %><p>Tente outro termo ou ajuste os filtros.</p><% } %>
            </div>
          </div>
        <% } %>
      </section>
      <p class="sr-only" role="status" aria-live="polite" data-beats-status></p>
    </main>
    <%- include('../partials/navegacao-mobile', { rotaAtual: '/beats' }) %>
  </div>

  <dialog class="detail-dialog beats-detail" id="detalhe-beat" aria-labelledby="detalhe-beat-titulo">
    <header class="detail-dialog-header">
      <span class="dc-stamp">Ficha do beat</span>
      <button class="icon-button beats-detail-close" type="button" data-dialog-close aria-label="Fechar ficha" autofocus><%- icones.x %></button>
    </header>
    <h2 id="detalhe-beat-titulo" data-beat-title-detail></h2>
    <p class="beats-detail-producer">Produzido por <strong data-beat-producer-detail></strong></p>
    <span class="beats-exclusive" data-beat-exclusive-detail hidden>Venda exclusiva</span>

    <dl class="beats-facts">
      <div><dt>Andamento</dt><dd data-beat-bpm-detail></dd></div>
      <div><dt>Tom</dt><dd data-beat-key-detail></dd></div>
      <div><dt>Gênero</dt><dd data-beat-genre-detail></dd></div>
      <div><dt>Duração</dt><dd data-beat-duration-detail></dd></div>
    </dl>

    <section class="beats-detail-section">
      <h3>Sobre o beat</h3>
      <p data-beat-description-detail></p>
    </section>

    <section class="beats-license-note">
      <span class="beats-license-icon" aria-hidden="true"><%- icones.shieldCheck %></span>
      <div>
        <h3>Licença</h3>
        <strong data-beat-license-detail></strong>
        <p data-beat-usage-detail></p>
      </div>
    </section>

    <section class="beats-detail-section">
      <h3>Ofertas disponíveis</h3>
      <div data-beat-ofertas-detail></div>
    </section>
  </dialog>
</div>
<script src="/js/banco-beats.js" defer></script>
<%- include('../partials/fim-pagina') %>
