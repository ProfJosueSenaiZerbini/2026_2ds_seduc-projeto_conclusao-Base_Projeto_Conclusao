<%- include('../partials/cabecalho', {title, stylesheet}) %>
<div class="dc-shell ev-page">
 <a class="dc-skip" href="#evento-conteudo">Pular para o conteúdo</a>
 <%- include('../partials/barra-lateral',{path}) %>
 <div class="dc-page">
  <%- include('../partials/componentes/cabecalho-descoberta',{titulo:tela==='mapa'?'Eventos no mapa':'Eventos',tituloId:'titulo-evento',descricao:'Encontre a cena. Faça parte do encontro.'}) %>
  <main class="dc-content" id="evento-conteudo" tabindex="-1">
   <a class="ev-back" href="/events"><%- icones.arrowLeft %> Voltar à agenda</a>
   <% if(erro){ %><p class="ev-notice" role="alert"><%= erro %></p><% } %>
   <% if(tela==='mapa'){ %>
    <header class="dc-heading"><h2>Localizações confirmadas</h2><span><%= pontos.length %> eventos no mapa</span></header>
    <p class="ev-muted">Só entram aqui eventos com coordenadas confirmadas pela organização. Os demais continuam na agenda.</p>
    <% if(escolhido){ %><div class="ev-map-layout"><nav class="ev-panel" aria-label="Selecionar evento no mapa"><% pontos.forEach(p=>{ %><a class="ev-map-choice" href="/events/map?evento=<%= encodeURIComponent(p.id) %>"<% if(p.id===escolhido.id){ %> aria-current="true"<% } %>><strong><%= p.titulo %></strong><span><%= p.local %></span></a><% }) %></nav><section class="ev-panel"><h3><%= escolhido.titulo %></h3><p><%= escolhido.local %></p><iframe class="ev-map" title="Mapa de <%= escolhido.titulo %>" src="<%= mapaUrl %>" loading="lazy" referrerpolicy="no-referrer"></iframe><p class="ev-map-credit">Mapa: © colaboradores do OpenStreetMap</p><a class="dc-primary" href="/events/<%= encodeURIComponent(escolhido.id) %>">Ver evento <%- icones.arrowUpRight %></a></section></div><% } else{ %><div class="dc-empty"><%- icones.mapPin %><div><strong>Nenhum ponto confirmado ainda.</strong><p>Explore os eventos pela lista ou cidade.</p></div></div><% } %>
   <% } else if(tela==='ficha'){ const e=f.evento,c=f.config,base='/events/'+encodeURIComponent(e.id); const valor=(nome,padrao='')=>typeof formulario[nome]==='string'?formulario[nome]:padrao; %>
    <header class="ev-hero">
     <div class="ev-hero-copy"><span class="dc-stamp"><%= e.categoria %> · <%= c.estado==='cancelado'?'Cancelado':e.situacao %></span><h2><%= e.titulo %></h2><p><%= e.organizador %></p><p class="ev-muted"><%= e.descricao||'Consulte as condições e fale com a organização antes de participar.' %></p></div>
     <div class="ev-date"><span><%- icones.calendarDays %></span><strong><%= data(c.inicio_em,c.fuso) %></strong><span>Até <%= data(c.fim_em,c.fuso) %></span><small><%= c.fuso %></small></div>
    </header>
    <% if(c.estado==='cancelado'){ %><p class="ev-notice" role="status"><strong>Evento cancelado.</strong> <%= c.motivo_cancelamento %></p><% } %>
    <nav class="ev-jump" aria-label="Seções do evento"><a href="#participacao">Participação</a><a href="#local">Local e regras</a><a href="#experiencia">Depois do evento</a><% if(f.dono){ %><a href="#gestao">Gestão</a><% } %></nav>
    <div class="ev-metrics"><% for(const [nome,total] of [['Interessados',f.totais.interessados],['Inscrições',f.totais.inscritos],['Confirmados',f.totais.confirmados],['Presentes',f.totais.presentes]]){ %><div><strong><%= total %></strong><span><%= nome %></span></div><% } %></div>
    <div class="ev-columns">
     <%- include('../partials/componentes/midias-publicacao',{tipo:'evento',id:e.id}) %>
<%- include('../partials/componentes/creditos-ficha',{tipo:'evento',id:e.id}) %>
<% if(f.dono){ %><a class="ci-button" href="/publicacoes/evento/<%= e.id %>/midias">Enviar cartaz</a><a class="ci-button" href="/creditos/gerir/evento/<%= encodeURIComponent(e.id) %>">Gerenciar créditos</a><% } %>
<section class="ev-panel" id="participacao"><header class="dc-heading"><h2>Sua participação</h2></header>
      <% if(f.dono){ %><p>Você é responsável pela organização deste evento.</p><a class="dc-primary" href="#gestao">Gerenciar inscrições</a>
      <% }else{ %>
       <div class="ev-actions"><% for(const [acao,rotulo,ativo] of [['interesse','Tenho interesse',f.acompanhamento?.interessado],['salvar','Salvar evento',f.acompanhamento?.salvo]]){ %><form method="post" action="<%= base %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="<%= acao %>"><input type="hidden" name="ativo" value="<%= ativo?'nao':'sim' %>"><% if (acao === 'salvar') { %><%- include('../partials/componentes/botao-salvar', { salvo: !!ativo, alvo: e.titulo, desabilitado: c.estado === 'cancelado' }) %><% } else { %><button class="ev-secondary" aria-pressed="<%= !!ativo %>"<% if(c.estado==='cancelado'){ %> disabled<% } %>><%= ativo?'✓ ':'' %><%= rotulo %></button><% } %></form><% } %></div>
       <p class="ev-muted">Interesse e salvamento não reservam vaga nem comprovam presença.</p>
       <% if(f.inscricao){ %><p class="ev-status"><%= estados[f.inscricao.estado] %></p><% if(f.inscricao.resposta){ %><p><%= f.inscricao.resposta %></p><% } %><% if(['confirmada','pendente'].includes(f.inscricao.estado)&&!f.presenca){ %><form method="post" action="<%= base %>/register/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ev-text-button">Cancelar minha inscrição</button></form><% } %><% } %>
       <% if(f.aberto&&(!f.inscricao||f.inscricao.estado==='cancelada')){ %><form class="ev-form" method="post" action="<%= base %>/register"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Apresentação à organização <small>Opcional</small><textarea name="justificativa" maxlength="1000" rows="3"><%= valor('justificativa') %></textarea></label><label class="ev-check"><input type="checkbox" name="aceite" value="sim" required> Li e aceito os critérios de participação.</label><button class="dc-primary"><%= e.tipo_participacao==='aprovacao'?'Solicitar inscrição':'Confirmar inscrição' %></button></form>
       <% }else if(!f.inscricao){ %><p class="ev-notice">As inscrições estão encerradas ou aguardam confirmação dos horários.</p><% } %>
       <% if(f.presenca){ %><p class="ev-status">Comparecimento reconhecido pela organização.</p><% } %>
       <details class="ev-details"><summary>Lembretes deste evento</summary><form class="ev-form" method="post" action="<%= base %>/follow"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="preferencias"><p class="ev-muted">Avisos na Cypher para eventos salvos, de seu interesse ou com inscrição ativa.</p><label class="ev-check"><input type="checkbox" name="lembrar24" value="sim"<% if(f.acompanhamento?.lembrar24??true){ %> checked<% } %>> Até 24 horas antes</label><label class="ev-check"><input type="checkbox" name="lembrarDia" value="sim"<% if(f.acompanhamento?.lembrar_dia??true){ %> checked<% } %>> No dia do evento</label><label>Seu fuso horário<select name="fuso"><% for(const z of ['America/Sao_Paulo','America/Manaus','America/Rio_Branco','America/Noronha','UTC']){ %><option value="<%= z %>"<% if(z===(f.acompanhamento?.fuso??'America/Sao_Paulo')){ %> selected<% } %>><%= z %></option><% } %></select></label><button class="ev-secondary">Salvar preferências</button></form></details>
      <% } %>
     </section>
     <section class="ev-panel" id="local"><header class="dc-heading"><h2>Local e regras</h2></header><dl class="ev-facts"><div><dt>Onde</dt><dd><%= e.local %></dd></div><div><dt>Formato</dt><dd><%= e.formato %></dd></div><div><dt>Admissão</dt><dd><%= e.tipo_participacao==='aprovacao'?'Mediante aprovação da organização':'Aberta, conforme as vagas disponíveis' %></dd></div><div><dt>Vagas</dt><dd><%= c.capacidade===null?'Sem limite informado':f.vagas+' disponíveis de '+c.capacidade %></dd></div><div><dt>Condições</dt><dd><%= c.criterios||e.inscricao||'A organização ainda precisa confirmar os critérios.' %></dd></div><% if(e.premio){ %><div><dt>Destaque</dt><dd><%= e.premio %></dd></div><% } %></dl>
      <% if(c.local_confirmado&&c.latitude!==null&&c.longitude!==null){ %><a class="ev-secondary" href="/events/map?evento=<%= encodeURIComponent(e.id) %>"><%- icones.mapPin %> Ver localização no mapa</a><% }else{ %><p class="ev-muted">Localização sem coordenadas confirmadas. Confira as orientações da organização.</p><% } %>
      <% if(f.edicoes.length>1){ %><details class="ev-details"><summary>Outras edições</summary><ul><% f.edicoes.forEach(ed=>{ %><li><a href="/events/<%= encodeURIComponent(ed.id) %>"><%= ed.titulo %> · <%= ed.data_texto %></a></li><% }) %></ul></details><% } %>
     </section>
    </div>
    <section class="ev-panel" id="experiencia"><header class="dc-heading"><h2>Depois do evento</h2><span><%= f.feedback.total %> avaliações · <%= f.feedback.positivas %> positivas</span></header><p class="ev-muted">Experiência do evento, independente da reputação por colaborações profissionais.</p>
     <% if(f.avaliacao){ %><p class="ev-status">Sua experiência foi <%= f.avaliacao.positiva?'positiva':'negativa' %>.</p><p><%= f.avaliacao.justificativa %></p>
     <% }else if(f.avaliavel&&!f.dono){ %><form class="ev-form" method="post" action="<%= base %>/feedback"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><fieldset><legend>Como foi a experiência?</legend><label class="ev-check"><input type="radio" name="positiva" value="sim" required> Positiva</label><label class="ev-check"><input type="radio" name="positiva" value="nao" required> Negativa</label></fieldset><label>Conte o que aconteceu <small>Obrigatório em experiências negativas, com pelo menos 10 caracteres.</small><textarea name="justificativa" maxlength="1500" rows="3"><%= valor('justificativa') %></textarea></label><button class="dc-primary">Registrar experiência</button></form>
     <% }else{ %><p>As avaliações abrem após o encerramento, para quem teve comparecimento reconhecido.</p><% } %>
     <% if(f.avaliavel&&!f.dono&&!f.reclamacoes.length){ %><details class="ev-details"><summary>Preciso tratar um problema com a organização</summary><form class="ev-form" method="post" action="<%= base %>/complaints"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p>A organização recebe a reclamação primeiro e pode reconhecer ou contestar o relato.</p><label>O que aconteceu?<textarea name="descricao" required minlength="20" maxlength="3000" rows="4"><%= valor('descricao') %></textarea></label><label>Referências e evidências <small>Compartilhe somente o necessário para analisar o problema.</small><textarea name="evidencias" maxlength="3000" rows="3"><%= valor('evidencias') %></textarea></label><button class="ev-secondary">Enviar à organização</button></form></details><% } %>
    </section>
    <% if(f.dono){ %><section class="ev-panel" id="gestao"><header class="dc-heading"><h2>Gestão do evento</h2><a href="<%= base %>/edit">Editar informações <%- icones.arrowUpRight %></a></header><p class="ev-muted">A lista de inscrições e os registros de conferência ficam disponíveis apenas à organização.</p>
     <% if(!f.inscricoes.length){ %><p>Ainda não há inscrições.</p><% } %><div class="ev-registration-list"><% f.inscricoes.forEach(i=>{ %><article class="ev-registration"><div><h3><%= i.nome %></h3><span><%= i.identificador %> · <%= estados[i.estado] %></span><% if(i.justificativa){ %><p><%= i.justificativa %></p><% } %><% if(i.presenca_em){ %><p class="ev-status">Presença registrada</p><% } %></div>
      <% if(i.estado==='pendente'&&f.aberto){ %><form class="ev-form" method="post" action="<%= base %>/registrations/<%= encodeURIComponent(i.usuario_id) %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= i.versao %>"><label>Decisão<select name="estado"><option value="confirmada">Aprovar inscrição</option><option value="recusada">Recusar inscrição</option></select></label><label>Justificativa ao participante<textarea name="resposta" required minlength="10" maxlength="1000" rows="2"></textarea></label><button class="ev-secondary">Comunicar decisão</button></form><% } %>
      <% if(i.estado==='confirmada'&&c.inicio_em&&Date.now()>=c.inicio_em&&c.estado==='ativo'){ %><form class="ev-form" method="post" action="<%= base %>/registrations/<%= encodeURIComponent(i.usuario_id) %>/attendance"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="acao" value="<%= i.presenca_em?'revogar':'registrar' %>"><label><%= i.presenca_em?'Motivo da correção':'Como o comparecimento foi conferido?' %><textarea name="evidencia" required minlength="10" maxlength="1200" rows="2" placeholder="Ex.: conferência da lista na entrada"></textarea></label><button class="ev-secondary"><%= i.presenca_em?'Corrigir presença':'Registrar comparecimento' %></button></form><% } %>
     </article><% }) %></div>
     <% if(c.estado==='ativo'){ %><details class="ev-details"><summary>Cancelar evento</summary><form class="ev-form" method="post" action="<%= base %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= c.versao %>"><p>Inscrições são canceladas e as pessoas afetadas recebem um aviso. O histórico desta edição é preservado.</p><label>Motivo do cancelamento<textarea name="motivo" required minlength="10" maxlength="1500" rows="3"></textarea></label><button class="ev-secondary ev-danger">Confirmar cancelamento</button></form></details><% } %>
     <details class="ev-details"><summary>Histórico de alterações</summary><ol class="ev-history"><% f.historico.forEach(h=>{ %><li><strong><%= h.acao.replaceAll('_',' ') %></strong><span><%= data(h.criada_em,c.fuso) %></span></li><% }) %></ol></details>
    </section><% } %>
    <% if(f.reclamacoes.length){ %><section class="ev-panel" id="reclamacoes"><header class="dc-heading"><h2>Reclamações</h2></header><div class="ev-registration-list"><% f.reclamacoes.forEach(r=>{ %><article class="ev-registration"><div><h3><%= f.dono?r.nome:'Seu relato' %></h3><span class="ev-status"><%= ({pendente:'Aguardando organização',reconhecida:'Problema reconhecido',contestada:'Relato contestado',moderacao:'Encaminhado à moderação'})[r.estado] %></span><p class="ev-preserve"><%= r.descricao %></p><% if(r.evidencias){ %><details class="ev-details"><summary>Evidências compartilhadas</summary><p class="ev-preserve"><%= r.evidencias %></p></details><% } %><% if(r.resposta){ %><p class="ev-preserve"><strong>Organização:</strong> <%= r.resposta %></p><% } %></div>
     <% if(f.dono&&r.estado==='pendente'){ %><form class="ev-form" method="post" action="<%= base %>/complaints/<%= encodeURIComponent(r.id) %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Posicionamento<select name="estado"><option value="reconhecida">Reconhecer o problema</option><option value="contestada">Contestar o relato</option></select></label><label>Resposta ao participante<textarea name="resposta" required minlength="20" maxlength="3000" rows="3"></textarea></label><button class="ev-secondary">Enviar resposta</button></form><% } %>
     <% if(!f.dono&&r.estado==='contestada'){ %><form method="post" action="<%= base %>/complaints/<%= encodeURIComponent(r.id) %>/escalate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ev-secondary">Pedir análise à moderação</button></form><% } %>
     <% if(!f.dono&&r.caso_suporte_id){ %><a class="ev-secondary" href="/suporte/<%= encodeURIComponent(r.caso_suporte_id) %>">Acompanhar análise</a><% } %>
    </article><% }) %></div></section><% } %>
    <%- include('../partials/componentes/acoes-conteudo', { tipo:'evento', id:e.id, ocultarSalvar:!f.dono }) %>
    <a class="cy-report-link" href="/suporte/new?objeto_tipo=evento&amp;objeto_id=<%= encodeURIComponent(e.id) %>">Denunciar este evento</a>
   <% } %>
  </main>
  <%- include('../partials/navegacao-mobile',{rotaAtual:'/events'}) %>
 </div>
</div>
<%- include('../partials/fim-pagina') %>
