<%- include('../partials/cabecalho',{title,stylesheet}) %>
<link rel="stylesheet" href="/css/entrada.css"><main class="tag-page"><a class="tag-brand" href="/login" aria-label="Cypher, entrar">CYPHER</a><%- include('../partials/componentes/tema-entrada') %><div class="tag-content"><div class="tag-shell"><section class="auth-panel tag-panel"><h2><%= confirmado ? 'E-mail confirmado' : token ? 'Confirme seu endereço' : 'Falta confirmar seu e-mail' %></h2>
<% if(erro){ %><p class="auth-message auth-message-error" role="alert"><%= erro %></p><% } %><% if(mensagem){ %><p class="auth-message auth-message-success" role="status"><%= mensagem %></p><% } %>
<% if(confirmado){ %><a class="button button-lime" href="/login">Entrar na Cypher</a>
<% }else if(token){ %><p>Confirme para ativar o acesso à sua conta. O link só pode ser usado uma vez.</p><form method="post" action="/confirmar-email"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-lime full" type="submit">Confirmar e-mail</button></form>
<% }else{ %><p>Use o link de confirmação para ativar sua conta. Ele expira em 30 minutos. Enquanto isso, a conta permanece pendente.</p><form method="post" action="/email/reenviar"><label>E-mail da conta<input type="email" name="email" maxlength="254" autocomplete="email" required></label><button class="button button-lime full" type="submit">Solicitar novo link</button><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><p class="auth-switch"><a href="/login">Voltar para entrar</a></p><% } %>
</section></div></div></main><%- include('../partials/fim-pagina') %>
