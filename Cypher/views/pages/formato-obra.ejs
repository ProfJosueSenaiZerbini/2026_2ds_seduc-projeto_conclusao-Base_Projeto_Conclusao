<%- include('../partials/inicio-trabalhos', { breadcrumb:'Criar obra' }) %>
<a class="et-back" href="/espaco-de-trabalho"><%- icones.arrowLeft %> Voltar ao Espaço de Trabalho</a>
<div class="et-heading"><h2 class="cy-work-heading">Escolha o formato</h2><p>Qual tipo de obra você quer cadastrar?</p></div>
<div class="et-formats"><% tipos.filter(tipo => !['Obra', 'Música'].includes(tipo)).forEach(tipo => { %><a href="/works/new?tipo=<%= encodeURIComponent(tipo) %>&amp;origem=espaco"><%- icones[tipo === 'Instrumental' ? 'audioLines' : 'fileMusic'] %><strong><%= tipo %></strong><%- icones.arrowRight %></a><% }) %></div>
<%- include('../partials/fim-trabalhos') %>
