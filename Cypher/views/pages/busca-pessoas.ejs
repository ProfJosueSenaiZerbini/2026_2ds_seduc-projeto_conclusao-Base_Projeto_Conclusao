<%- include('../partials/cabecalho', { title, stylesheet }) %>
<%
  const contexto = { q, tipo, ...filtros };
  const limpar = urlBusca({ q, tipo });
  const exibidas = categorias.filter(c => c.id !== 'tudo' && (tipo === 'tudo' || c.id === tipo));
%>
<div class="dc-shell cy-search">
  <a class="dc-skip" href="#conteudo-busca">Pular para os resultados</a>
  <%- include('../partials/barra-lateral', { path }) %>
  <div class="dc-page">
    <%- include('../partials/componentes/cabecalho-descoberta', { titulo: 'Busca global', tituloId: 'titulo-busca', descricao: 'Pessoas, sons e encontros. A cena se conecta aqui.' }) %>
    <main class="dc-content" id="conteudo-busca" aria-labelledby="titulo-busca" tabindex="-1">
      <header class="search-intro">
        <div><span class="dc-stamp">Conexões que movem a cultura</span>
          <h2><%= q ? 'Resultados para' : 'Encontre sua' %> <em><%= q ? '“' + q + '”' : 'próxima conexão.' %></em></h2>
          <p><%= q ? 'Explore os resultados ou refine a busca por categoria.' : 'Descubra artistas, profissionais e trabalhos com a identidade da rua.' %></p>
        </div>
        <span class="search-index" aria-hidden="true">CYPHER<br>MAPA DA CENA <span>↗</span></span>
      </header>
      <nav class="dc-tabs search-tabs" aria-label="Categorias da pesquisa">
        <% categorias.forEach(cat => { %>
          <a href="<%= urlBusca({ q, tipo: cat.id }) %>" data-search-navigation<% if (tipo === cat.id) { %> aria-current="page"<% } %>><span aria-hidden="true"><%- icones[cat.icone] %></span><%= cat.nome %><small><%= contagens[cat.id] %></small></a>
        <% }) %>
      </nav>
      <% if (tipo !== 'tudo') { %>
        <form class="search-filters" action="/search" method="get" aria-label="Filtrar <%= categorias.find(c => c.id === tipo).nome %>">
          <input type="hidden" name="q" value="<%= q %>"><input type="hidden" name="tipo" value="<%= tipo %>">
          <% const campos = [
            { nome: 'categoria', rotulo: tipo === 'pessoas' ? 'Profissão' : tipo === 'eventos' ? 'Tipo de evento' : 'Formato', todas: tipo === 'pessoas' ? 'Todas as profissões' : 'Todos os formatos', opcoes: opcoes.categorias },
            ...(['pessoas', 'obras', 'beats'].includes(tipo) ? [{ nome: 'genero', rotulo: 'Gênero musical', todas: 'Todos os gêneros', opcoes: opcoes.generos }] : []),
            ...(['pessoas', 'eventos'].includes(tipo) ? [{ nome: 'localizacao', rotulo: 'Localização', todas: 'Todas as localidades', opcoes: opcoes.localizacoes }] : []),
            ...(tipo === 'pessoas' ? [{ nome: 'ordem', rotulo: 'Ordenar por', todas: 'Nome A–Z', opcoes: ['populares'] }] : []),
            ...(tipo === 'eventos' ? [{ nome: 'periodo', rotulo: 'Período', todas: 'Todas as datas', opcoes: ['proximos', 'passados'] }] : [])
          ].filter(c => c.opcoes.length || filtros[c.nome]); %>
          <% campos.forEach(campo => { %>
            <label for="search-<%= campo.nome %>"><%= campo.rotulo %><select id="search-<%= campo.nome %>" name="<%= campo.nome %>">
              <option value=""><%= campo.todas %></option>
              <% const valores = [...new Set([...campo.opcoes, filtros[campo.nome]].filter(Boolean))]; valores.forEach(valor => { %><option value="<%= valor %>"<%= filtros[campo.nome] === valor ? ' selected' : '' %>><%= ({ populares: 'Populares', proximos: 'Próximos eventos', passados: 'Eventos passados' })[valor] || valor %></option><% }) %>
            </select></label>
          <% }) %>
          <% if (campos.length) { %><button class="dc-primary" type="submit"><span aria-hidden="true"><%- icones.sliders %></span> Aplicar filtros</button><% } %>
        </form>
      <% } %>
      <% if (filtrosAtivos) { %><div class="search-active-filters"><span><%= Object.values(filtros).filter(Boolean).map(v => ({ populares: 'Populares', proximos: 'Próximos eventos', passados: 'Eventos passados' })[v] || v).join(' / ') %></span><a href="<%= limpar %>" data-search-navigation>Limpar filtros <span aria-hidden="true">×</span></a></div><% } %>
      <div class="search-results">
        <div class="search-meta"><span><strong><%= total %></strong> <%= total === 1 ? 'resultado' : 'resultados' %><%= q ? ' para “' + q + '”' : ' na cena' %></span><span><%= tipo === 'pessoas' ? filtros.ordem === 'populares' ? 'Popularidade' : 'Nome A–Z' : 'Conteúdo público' %></span></div>
        <% exibidas.forEach(cat => {
          const todos = grupos[cat.id];
          const itens = tipo === 'tudo' ? todos.slice(0, 6) : todos.slice((pagina - 1) * 24, pagina * 24);
          if (!itens.length) return;
        %>
          <section class="search-section" aria-labelledby="search-<%= cat.id %>-title">
            <div class="dc-heading"><h3 id="search-<%= cat.id %>-title"><span aria-hidden="true"><%- icones[cat.icone] %></span><%= cat.nome %> <small><%= todos.length %></small></h3><% if (tipo === 'tudo') { %><a href="<%= urlBusca({ q, tipo: cat.id }) %>" data-search-navigation>Ver <%= cat.nome.toLocaleLowerCase('pt-BR') %> <%- icones.arrowRight %></a><% } %></div>
            <div class="search-grid search-grid-<%= cat.id %>">
              <% itens.forEach(item => { %>
                <% if (cat.id === 'pessoas') { %><%- include('../partials/componentes/pessoa-resultado', { pessoa: item, rotulos: rotulosPessoa(item) }) %>
                <% } else { %><%- include('../partials/componentes/item-descoberta', { item }) %><% } %>
              <% }) %>
            </div>
          </section>
        <% }) %>
        <% if (!total) { %>
          <div class="dc-empty search-empty"><span aria-hidden="true"><%- icones.search %></span><div><h3><%= q || filtrosAtivos ? 'Essa conexão ainda não apareceu.' : 'A cena começa com quem chega.' %></h3><p><%= q || filtrosAtivos ? 'Tente outro nome, termo ou combinação de filtros. Você também pode explorar outras categorias.' : 'Os perfis e trabalhos públicos da comunidade aparecerão aqui.' %></p><% if (filtrosAtivos) { %><a class="dc-primary" href="<%= limpar %>" data-search-navigation>Limpar filtros</a><% } else if (q) { %><a class="dc-primary" href="/search" data-search-navigation>Explorar a cena</a><% } %></div></div>
        <% } %>
        <% if (tipo !== 'tudo' && paginas > 1) { %>
          <nav class="search-pagination" aria-label="Paginação dos resultados"><% if (pagina > 1) { %><a href="<%= urlBusca({ ...contexto, pagina: pagina - 1 }) %>" data-search-navigation>← Anterior</a><% } %><span>Página <%= pagina %> de <%= paginas %></span><% if (pagina < paginas) { %><a href="<%= urlBusca({ ...contexto, pagina: pagina + 1 }) %>" data-search-navigation>Próxima →</a><% } %></nav>
        <% } %>
      </div>
      <footer class="search-note"><span aria-hidden="true"><%- icones.users %></span> Uma pessoa, muitas atuações. Encontre quem soma à sua ideia.</footer>
      <p class="sr-only" role="status" aria-live="polite" data-search-status></p>
    </main>
    <%- include('../partials/navegacao-mobile', { rotaAtual: '/search' }) %>
  </div>
</div>
<%- include('../partials/fim-pagina') %>
