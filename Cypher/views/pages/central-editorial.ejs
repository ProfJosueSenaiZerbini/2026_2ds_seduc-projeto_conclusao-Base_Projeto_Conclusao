<%- include('../partials/cabecalho',{title,stylesheet}) %>
<div class="app-shell dc-shell admin-shell"><a class="dc-skip" href="#central-editorial">Pular para a gestão da Central</a><%- include('../partials/navegacao-administrativa',{path,usuario}) %><main class="main-shell">
<%- include('../partials/barra-superior',{breadcrumb:'Cypher Central'}) %>
<div class="cn-page admin-page" id="central-editorial" tabindex="-1">
<% const listaArtigos=typeof artigos!=='undefined'?artigos:[];const item=typeof artigo!=='undefined'?artigo:null;const draft=(typeof valores!=='undefined'&&valores)||item?.rascunho||{titulo:'',resumo:'',categoria:'',intencao:'comecar',profissoes:[],passos:[],exemplo:'',acao_url:'',acao_label:''};const filtrosAtuais=typeof filtros!=='undefined'?filtros:{dias:'30',artigo:'',categoria:''};const analise=typeof qualidade!=='undefined'&&qualidade?qualidade:{totais:{acessos:0,usuarios:0,avaliacoes:0,uteis:0,negativas:0,taxa:0,aprovacao:0},artigos:[],lacunas:[],evolucao:[],historico:[]};const nomeCategoria=id=>categorias.find(c=>c.id===id)?.nome||id;const pct=n=>Number(n||0).toFixed(1).replace('.',',')+'%';const estadoNome=id=>({rascunho:'Rascunho',em_revisao:'Em revisão',publicado:'Publicado',arquivado:'Arquivado'})[id]||id;const dataTexto=valor=>{if(!valor)return '—';const d=new Date(typeof valor==='number'?valor:String(valor).replace(' ','T'));return Number.isNaN(d.getTime())?'—':d.toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'short',year:'numeric'});}; %>
<header class="cn-admin-title"><div><span class="cn-eyebrow">CYPHER / CONHECIMENTO COMPARTILHADO</span><h1><%= tela==='editar'?(item?'Editar guia':'Criar guia'):tela==='qualidade'?'Qualidade da Central':tela==='pesquisas'?'Dúvidas sem resposta':tela==='revisoes'?'Revisões editoriais':tela==='erro'?'Não foi possível continuar':'Conteúdos da Central' %></h1><p><%= tela==='editar'?'Ensine o essencial primeiro. Organize os detalhes em passos curtos e acionáveis.':'Publique orientações úteis, acompanhe o retorno dos leitores e refine o que precisa ficar mais claro.' %></p></div><% if(tela!=='editar'&&tela!=='erro'){ %><a class="cn-button cn-primary" href="/admin/central/new">Criar guia <span class="lucide-icon" aria-hidden="true"><%- icones.plus %></span></a><% } %></header>
<nav class="cn-admin-tabs" aria-label="Gestão editorial da Central"><% [['lista','/admin/central','Conteúdos'],['qualidade','/admin/central/quality','Qualidade'],['pesquisas','/admin/central/searches','Pesquisas'],['revisoes','/admin/central/reviews','Revisões']].forEach(([id,href,nome])=>{ %><a href="<%= href %>" <%- tela===id?'aria-current="page"':'' %>><%= nome %></a><% }) %></nav>
<% if(erro){ %><p class="cn-notice cn-error" role="alert"><%= erro %></p><% } %>
<% if(tela==='erro'){ %><a class="cn-button" href="/admin/central">Voltar aos conteúdos</a><% } %>
<% if(tela==='lista'||tela==='revisoes'){ %>
<% if(tela==='revisoes'){ %><p class="cn-notice">Revise conteúdo, permissões e clareza antes de publicar. Quando um artigo publicado recebe alterações, os leitores continuam vendo sua versão publicada até a nova publicação.</p><% } %>
<div class="cn-admin-list"><% listaArtigos.forEach(a=>{ %><article class="cn-admin-row"><div><div class="cn-chips"><span class="cn-chip"><%= estadoNome(a.estado) %></span><span class="cn-chip"><%= nomeCategoria(a.rascunho.categoria) %></span><span class="cn-chip">Versão <%= a.versao %></span></div><h3><%= a.rascunho.titulo %></h3><p><%= a.rascunho.resumo %></p><small class="cn-note"><%= a.autor||'Equipe Cypher' %> · Atualizado em <%= dataTexto(a.atualizado_em) %><%= a.publicado&&a.estado!=='arquivado'?' · Há uma versão disponível aos leitores':'' %></small></div><div class="cn-form-actions"><a class="cn-button" href="/admin/central/<%= a.id %>/edit">Editar e revisar</a><% if(a.publicado&&a.estado!=='arquivado'){ %><a class="cn-button" href="/central/<%= encodeURIComponent(a.slug) %>" target="_blank" rel="noopener">Abrir guia ↗</a><% } %></div></article><% }) %></div>
<% if(!listaArtigos.length){ %><section class="cn-empty"><h3><%= tela==='revisoes'?'Nenhuma revisão pendente.':'A Central começa com um bom guia.' %></h3><p><%= tela==='revisoes'?'Os conteúdos que precisarem de análise aparecerão nesta área.':'Crie uma orientação curta, com passos práticos e um caminho claro para aplicar o que foi aprendido.' %></p><a class="cn-button" href="/admin/central/new">Criar guia</a></section><% } %>
<% } %>
<% if(tela==='editar'){ %>
<a class="cn-back" href="/admin/central">← Conteúdos da Central</a>
<% if(item){ %><a class="cn-button" href="/admin/central/<%= item.id %>/preview" target="_blank" rel="noopener">Pré-visualizar rascunho salvo ↗</a><% } %>
<% if(item?.publicado&&item.estado!=='arquivado'){ %><p class="cn-notice">Há uma versão publicada deste guia. Salvar o rascunho preserva o que os leitores já veem; as mudanças entram no ar somente com uma nova publicação.</p><% } %>
<form class="cn-form" method="post" action="/admin/central<%= item?'/'+item.id:'' %>" id="cn-editor-form">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(item){ %><input type="hidden" name="versao" value="<%= item.versao %>"><% } %>
<section class="cn-panel"><span class="cn-eyebrow">01 / DIREÇÃO</span><h3>Qual dúvida este guia resolve?</h3><label>Título<input name="titulo" required minlength="3" maxlength="120" value="<%= draft.titulo||'' %>" placeholder="Ex.: Como montar sua primeira galeria"></label><label>Resumo em poucas linhas<textarea name="resumo" required minlength="10" maxlength="280" rows="3" placeholder="Diga o que a pessoa será capaz de fazer depois da leitura."><%= draft.resumo||'' %></textarea></label><div class="cn-form-fields"><label>Assunto<select name="categoria" required><option value="">Escolha um assunto</option><% categorias.forEach(c=>{ %><option value="<%= c.id %>" <%= draft.categoria===c.id?'selected':'' %>><%= c.nome %></option><% }) %></select></label><label>Intenção do leitor<select name="intencao"><% [['comecar','Começar a usar a Cypher'],['publicar','Publicar e apresentar trabalhos'],['conectar','Conectar e colaborar'],['resolver','Resolver uma dúvida ou problema']].forEach(([id,nome])=>{ %><option value="<%= id %>" <%= draft.intencao===id?'selected':'' %>><%= nome %></option><% }) %></select></label></div><fieldset class="cn-profession-fieldset"><legend>Profissões relacionadas (opcional)</legend><p class="cn-note">Marque atuações a que este conteúdo se aplica. Sem seleção, o guia é transversal.</p><div class="cn-chips"><% profissoes.forEach(p=>{ %><label class="cn-check"><input type="checkbox" name="profissoes" value="<%= p.id %>" <%= (draft.profissoes||[]).includes(p.id)?'checked':'' %>><%= p.rotulo %></label><% }) %></div></fieldset></section>
<section class="cn-panel"><span class="cn-eyebrow">02 / APRENDIZADO</span><h3>Ensine em etapas curtas.</h3><p class="cn-note">Cada etapa deve explicar uma ação ou ideia. Dicas ficam separadas para quem precisar de mais contexto.</p><noscript><p class="cn-notice">Ative o JavaScript para editar e organizar as etapas. Sem ele, as etapas existentes são preservadas.</p></noscript><textarea name="passos" id="cn-passos-json" hidden><%= JSON.stringify(draft.passos||[]) %></textarea><div id="cn-editor-passos" class="cn-editor-steps"></div><button class="cn-button" type="button" id="cn-adicionar-passo">Adicionar etapa <span class="lucide-icon" aria-hidden="true"><%- icones.plus %></span></button><p class="cn-note">Use até 12 etapas. Prefira uma sequência curta e um objetivo claro.</p></section>
<section class="cn-panel"><span class="cn-eyebrow">03 / APLICAÇÃO</span><h3>Mostre a ideia em contexto.</h3><label>Aplicação prática (opcional)<textarea name="exemplo" maxlength="1200" rows="4" placeholder="Um cenário curto que ajude a reconhecer a situação no cotidiano."><%= draft.exemplo||'' %></textarea></label><div class="cn-form-fields"><label>Texto da ação prática<input name="acao_label" maxlength="60" value="<%= draft.acao_label||'' %>" placeholder="Ex.: Criar minha galeria"></label><label>Destino da ação<input name="acao_url" maxlength="500" value="<%= draft.acao_url||'' %>" placeholder="Ex.: /work-projects/new"></label></div><p class="cn-note">A ação ajuda a aplicar o guia. Use um destino permitido; não inclua URLs com credenciais ou scripts.</p></section>
<div class="cn-form-actions"><button class="cn-button cn-primary" type="submit">Salvar rascunho <span class="lucide-icon" aria-hidden="true"><%- icones.check %></span></button><a class="cn-button" href="/admin/central">Voltar aos conteúdos</a></div><span class="cn-sr" id="cn-editor-status" aria-live="polite"></span>
</form>
<% if(item){ %><section class="cn-panel"><span class="cn-eyebrow">CICLO EDITORIAL</span><h3>Revise antes de colocar no ar.</h3><p class="cn-note">Estado atual: <strong><%= estadoNome(item.estado) %></strong>. Cada decisão preserva autoria, versão e justificativa.</p><form class="cn-form" method="post" action="/admin/central/<%= item.id %>/state"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= item.versao %>"><label>Justificativa da decisão<textarea name="motivo" required minlength="10" maxlength="600" rows="3" placeholder="O que foi conferido ou por que o conteúdo deve mudar de situação?"></textarea></label><div class="cn-form-actions"><% if(item.estado==='arquivado'){ %><button class="cn-button" name="acao" value="reabrir">Reabrir como rascunho</button><% }else{ %><% if(item.estado==='rascunho'){ %><button class="cn-button" name="acao" value="revisar">Encaminhar para revisão</button><% }else if(item.estado==='em_revisao'){ %><button class="cn-button cn-primary" name="acao" value="publicar">Publicar versão revisada</button><% } %><button class="cn-button" name="acao" value="arquivar">Arquivar guia</button><% } %></div></form></section><% } %>
<% } %>
<% if(tela==='qualidade'||tela==='pesquisas'){ %>
<form class="cn-controls cn-quality-filters" method="get" action="<%= tela==='pesquisas'?'/admin/central/searches':'/admin/central/quality' %>"><label>Período<select name="dias"><% ['7','30','90'].forEach(n=>{ %><option value="<%= n %>" <%= filtrosAtuais.dias===n?'selected':'' %>>Últimos <%= n %> dias</option><% }) %></select></label><label>Artigo<select name="artigo"><option value="">Todos os artigos</option><% listaArtigos.forEach(a=>{ %><option value="<%= a.id %>" <%= filtrosAtuais.artigo===a.id?'selected':'' %>><%= a.rascunho.titulo %></option><% }) %></select></label><label>Assunto<select name="categoria"><option value="">Todos os assuntos</option><% categorias.forEach(c=>{ %><option value="<%= c.id %>" <%= filtrosAtuais.categoria===c.id?'selected':'' %>><%= c.nome %></option><% }) %></select></label><button class="cn-button" type="submit">Aplicar filtros</button></form>
<% } %>
<% if(tela==='qualidade'){const t=analise.totais; %>
<div class="cn-metrics"><div class="cn-metric"><span>Acessos registrados</span><strong><%= t.acessos %></strong><small>Eventos deduplicados de leitura no período</small></div><div class="cn-metric"><span>Leitores únicos</span><strong><%= t.usuarios %></strong><small>Pessoas distintas que acessaram os guias</small></div><div class="cn-metric"><span>Avaliações</span><strong><%= t.avaliacoes %></strong><small><%= t.uteis %> úteis · <%= t.negativas %> negativas</small></div><div class="cn-metric"><span>Aprovação</span><strong><%= t.avaliacoes?pct(t.aprovacao):'—' %></strong><small><%= t.uteis %> respostas úteis de <%= t.avaliacoes %> avaliações</small></div><div class="cn-metric"><span>Participação no retorno</span><strong><%= t.acessos?pct(t.taxa):'—' %></strong><small><%= t.avaliacoes %> avaliações para <%= t.acessos %> acessos registrados</small></div></div>
<p class="cn-notice">Leia porcentagens junto das quantidades. Um resultado com poucos votos ainda pede contexto. Acesso, leitor único e avaliação são medidas diferentes.</p>
<section class="cn-panel"><span class="cn-eyebrow">EVOLUÇÃO NO PERÍODO</span><h3>Leituras e retornos</h3><% if(analise.evolucao.length){const maximo=Math.max(1,...analise.evolucao.map(e=>Math.max(e.acessos,e.votos))); %><div class="cn-bar-list"><% analise.evolucao.forEach(e=>{ %><div class="cn-bar-row"><div class="cn-bar-top"><strong><%= e.dia %></strong><span><%= e.acessos %> acessos · <%= e.votos %> registros de feedback</span></div><div class="cn-bar" aria-label="<%= e.acessos %> acessos"><i style="width:<%= Math.min(100,Math.max(0,100*e.acessos/maximo)) %>%"></i></div><div class="cn-bar cn-bar-votes" aria-label="<%= e.votos %> registros de feedback"><i style="width:<%= Math.min(100,Math.max(0,100*e.votos/maximo)) %>%"></i></div></div><% }) %></div><% }else{ %><p class="cn-note">Ainda não há eventos registrados neste período.</p><% } %></section>
<section class="cn-section"><header class="cn-section-heading"><div><span class="cn-eyebrow">CONTEÚDOS QUE MERECEM ATENÇÃO</span><h3>Qualidade por artigo</h3><p>Use o retorno para escolher o próximo conteúdo a revisar.</p></div></header><% if(analise.artigos.length){ %><div class="cn-table-wrap"><table class="cn-table"><thead><tr><th>Guia</th><th>Acessos / leitores</th><th>Retornos</th><th>Aprovação</th><th>Taxa de avaliação</th></tr></thead><tbody><% analise.artigos.forEach(a=>{ %><tr><td><a class="cn-text-link" href="/admin/central/<%= a.id %>/edit"><%= a.titulo %></a><small class="cn-table-note"><%= nomeCategoria(a.categoria) %></small></td><td><%= a.acessos %> / <%= a.usuarios %></td><td><%= a.avaliacoes %><small class="cn-table-note"><%= a.uteis %> úteis · <%= a.negativas %> negativas</small></td><td><%= a.avaliacoes?pct(a.aprovacao):'—' %><small class="cn-table-note"><%= a.uteis %> de <%= a.avaliacoes %></small></td><td><%= a.acessos?pct(a.taxa):'—' %><small class="cn-table-note"><%= a.avaliacoes %> de <%= a.acessos %></small></td></tr><% }) %></tbody></table></div><% }else{ %><p class="cn-note">Nenhum artigo corresponde aos filtros selecionados.</p><% } %></section>
<% analise.artigos.filter(a=>a.motivos?.length).forEach(a=>{ %><details class="cn-panel"><summary><%= a.titulo %> · motivos do retorno negativo</summary><div class="cn-bar-list"><% const totalMotivos=a.motivos.reduce((s,m)=>s+m.total,0);a.motivos.forEach(m=>{ %><div class="cn-bar-row"><div class="cn-bar-top"><strong><%= motivos.find(x=>x.id===m.motivo)?.nome||m.motivo %></strong><span><%= m.total %> · <%= pct(totalMotivos?100*m.total/totalMotivos:0) %></span></div><div class="cn-bar"><i style="width:<%= totalMotivos?100*m.total/totalMotivos:0 %>%"></i></div></div><% }) %></div></details><% }) %>
<% if(analise.historico.length){ %><details class="cn-panel"><summary>Histórico editorial no período</summary><ol class="cn-history"><% analise.historico.forEach(h=>{ %><li><strong><%= h.titulo %> · <%= h.acao.replaceAll('_',' ') %></strong><small><%= h.autor||'Equipe Cypher' %> · <%= dataTexto(h.criado_em) %></small></li><% }) %></ol></details><% } %>
<% } %>
<% if(tela==='pesquisas'){ %><section class="cn-panel"><span class="cn-eyebrow">LACUNAS DE CONHECIMENTO</span><h3>O que ainda precisa de uma resposta?</h3><p class="cn-note">Esta lista reúne somente pesquisas sem resultado cujo registro foi autorizado. Os termos ajudam a planejar conteúdo; não são uma caixa de atendimento individual.</p><% if(analise.lacunas.length){ %><div class="cn-table-wrap"><table class="cn-table"><thead><tr><th>Termo pesquisado</th><th>Assunto</th><th>Data</th><th>Ocorrências</th></tr></thead><tbody><% analise.lacunas.forEach(l=>{ %><tr><td><%= l.termo %></td><td><%= l.categoria?nomeCategoria(l.categoria):'Sem filtro de assunto' %></td><td><%= l.dia %></td><td><%= l.total %></td></tr><% }) %></tbody></table></div><% }else{ %><p class="cn-note">Nenhuma lacuna registrada nos filtros atuais. Isso também pode significar que ainda não houve pesquisas autorizadas.</p><% } %></section><% } %>
</div></main></div><script src="/js/central-nova.js" defer></script><%- include('../partials/fim-pagina') %>
