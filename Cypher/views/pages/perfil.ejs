<%- include('../partials/cabecalho', { title, stylesheet }) %>
<% if (typeof editando !== 'undefined' && editando) { %><link rel="stylesheet" href="/css/perfil-edicao.css"><% } %>
<div class="dc-shell pf-shell<%= typeof editando !== 'undefined' && editando ? ' pf-edit-shell' : '' %>">
  <a class="dc-skip" href="#perfil">Pular para o perfil</a>
  <%- include('../partials/barra-lateral', {path}) %>
  <div class="dc-page">
    <%- include('../partials/componentes/cabecalho-descoberta', {titulo: path === '/profile' ? 'Meu perfil' : 'Perfil profissional', tituloId:'perfil-pagina', descricao:''}) %>
    <main class="pf-page" id="perfil">
      <% if (path === '/profile') { %><%- include('../partials/componentes/perfil-avisos') %><% } %>
      <% if (!pessoa) { %>
        <section class="pf-panel pf-empty"><h2>Perfil indisponível</h2><p>O endereço pode ter mudado ou o acesso a este perfil é restrito.</p><a class="pf-button" href="/search?tipo=pessoas">Buscar profissionais</a></section>
      <% } else if (editando && !usuario.demonstracao) { %>
        <%- include('../partials/componentes/editar-perfil-secoes') %>
        <script src="/js/questionario-atuacoes.js" defer></script>
        <script src="/js/perfil-edicao.js" defer></script>
      <% } else { %>
        <%- include('../partials/componentes/apresentacao-artista') %>
        <% if (apresentacao.editavel) { %><%- include('../partials/componentes/completar-identidade', { usuario, sempre: true }) %><% } %>
        <%- include('../partials/componentes/perfil-secoes') %>
      <% } %>
    </main>
    <%- include('../partials/navegacao-mobile',{rotaAtual:path}) %>
  </div>
</div>
<script src="/js/perfil.js" defer></script>
<%- include('../partials/fim-pagina') %>
