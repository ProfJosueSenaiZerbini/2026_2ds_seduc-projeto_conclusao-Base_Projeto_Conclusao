<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="dc-shell bl-shell"><a class="dc-skip" href="#beat-form">Pular para o formulário</a><%- include('../partials/barra-lateral',{path}) %><div class="dc-page">
<%- include('../partials/componentes/cabecalho-descoberta',{titulo:'Banco de Beats',tituloId:'beat-titulo',descricao:'Dê identidade ao instrumental. Prepare o próximo encontro.'}) %>
<main class="bl-page" id="beat-form" tabindex="-1" aria-labelledby="beat-titulo"><nav class="bl-nav"><a href="<%= origemEspaco?'/espaco-de-trabalho':'/beats' %>"><%= origemEspaco?'Espaço de Trabalho':'Explorar beats' %></a><% if(editando){ %><a href="/beats/<%= encodeURIComponent(beatId) %>/manage">Arquivos e ofertas</a><% } %></nav>
<header class="bl-heading"><div><span class="bl-eyebrow"><%= editando?'SEU ACERVO / INFORMAÇÕES':'01 / SEU NOVO INSTRUMENTAL' %></span><h2><%= editando?'Refine a apresentação.':'Toda ideia tem uma batida.' %></h2><p>Comece pela identidade do beat. Depois, envie os arquivos e organize suas ofertas.</p></div></header>
<% if(erro){ %><p class="bl-feedback" role="alert"><%= erro %></p><% } %>
<form class="bl-form" method="post" action="<%= editando?'/beats/'+encodeURIComponent(beatId)+'/edit':'/beats/new' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(origemEspaco){ %><input type="hidden" name="origem" value="espaco"><% } %>
<section class="bl-panel"><h3>A identidade do som</h3><div class="bl-form"><label>Título do beat<input name="title" minlength="2" maxlength="120" required value="<%= valores.title %>" placeholder="Ex.: Semáforo quebrado"></label><div class="bl-two"><label>Gênero ou estilo <small>Opcional</small><input name="genre" maxlength="60" value="<%= valores.genre %>" placeholder="Ex.: Boom bap"></label><label>BPM <small>Opcional</small><input name="bpm" type="number" min="30" max="300" step="1" value="<%= valores.bpm %>" placeholder="Ex.: 92"></label><label>Tonalidade <small>Opcional</small><input name="key" maxlength="30" value="<%= valores.key %>" placeholder="Ex.: Dm"></label><label>Duração <small>Opcional · mm:ss</small><input name="duration" pattern="\d{1,2}:[0-5]\d" value="<%= valores.duration %>" placeholder="Ex.: 2:48"></label></div><label>Descrição <small>Opcional</small><textarea name="description" maxlength="500" rows="4" placeholder="A atmosfera, as referências e a intenção do instrumental."><%= valores.description %></textarea></label></div></section>
<section class="bl-panel"><h3>Uma apresentação transparente</h3><div class="bl-form"><label>Indicação geral de licença<select name="license"><% licencasBeat.forEach(l=>{ %><option value="<%= l %>" <%= valores.license===l?'selected':'' %>><%= l %></option><% }) %></select></label><label>Orientação geral de uso <small>Opcional</small><textarea name="usage" maxlength="500" rows="3" placeholder="As condições detalhadas serão definidas em cada oferta."><%= valores.usage %></textarea></label></div><p class="bl-note">Essa indicação apresenta o beat. A autorização depende de uma oferta com termos e arquivos definidos e do aceite correspondente. A prévia não concede direitos de utilização.</p></section>
<div class="bl-actions"><button class="bl-button"><%= editando?'Salvar informações':'Salvar e preparar arquivos' %></button><a class="bl-button bl-outline" href="/beats">Voltar ao catálogo</a></div></form></main><%- include('../partials/navegacao-mobile',{rotaAtual:path}) %></div></div><%- include('../partials/fim-pagina') %>
