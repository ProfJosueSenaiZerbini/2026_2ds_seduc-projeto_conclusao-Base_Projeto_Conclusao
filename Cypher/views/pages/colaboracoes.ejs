<%- include('../partials/cabecalho',{title,stylesheet}) %>
<div class="<%= usuario.tipoConta==='administrativo'?'app-shell dc-shell admin-shell':'dc-shell co-shell' %>">
<%- include('../partials/barra-lateral',{path}) %><div class="<%= usuario.tipoConta==='administrativo'?'main-shell':'dc-page' %>">
<% if(usuario.tipoConta==='administrativo'){ %><%- include('../partials/barra-superior',{breadcrumb:'Moderação de reputação'}) %><% }else{ %><%- include('../partials/componentes/cabecalho-descoberta',{titulo:'Colaborações e reputação',tituloId:'co-titulo',descricao:'Reconhecer o trabalho em conjunto, com responsabilidade.'}) %><% } %>
<main class="co-page <%= usuario.tipoConta==='administrativo'?'admin-page':'' %>">
<% if(tela==='erro'){ %><section class="co-panel"><h1>Não foi possível continuar</h1><p role="alert"><%= erro %></p><a class="co-button" href="<%= usuario.tipoConta==='administrativo'?'/admin/reputacao':'/colaboracoes' %>">Voltar</a></section><% } %>
<% if(tela==='lista'){ %>
<header class="co-heading"><div><span class="co-eyebrow">TRABALHOS EM CONJUNTO</span><h1>Minhas colaborações</h1><p>Acompanhe convites, decisões e o reconhecimento de cada entrega.</p></div><a class="co-button co-primary" href="/colaboracoes/new">Propor colaboração <%- icones.plus %></a></header>
<section class="co-panel"><%- include('../partials/componentes/reputacao-resumo',{resumo}) %><p class="co-note">Cada profissional avaliador tem o mesmo peso. As notas medem a experiência de colaboração.</p></section>
<nav class="co-tabs" aria-label="Situação das colaborações"><a href="/colaboracoes" <%- !filtro?'aria-current="page"':'' %>>Todas</a><% [['pendente_aceite','Convites'],['em_andamento','Em andamento'],['conclusao_pendente','Conclusão'],['concluida','Concluídas'],['contestada','Contestadas']].forEach(([id,nome])=>{ %><a href="/colaboracoes?estado=<%= id %>" <%- filtro===id?'aria-current="page"':'' %>><%= nome %></a><% }) %></nav>
<div class="co-list"><% itens.filter(i=>!filtro||i.estado===filtro).forEach(i=>{ %><a class="co-card" href="/colaboracoes/<%= i.id %>"><span class="co-state"><%= i.nomeEstado %></span><h2><%= i.titulo %></h2><p>Com <%= i.outro_nome %></p><small><%= data(i.criada_em) %><%= i.podeAvaliar?' · Prazo para avaliar':'' %></small></a><% }) %></div><% if(!itens.length){ %><p class="co-empty">Suas colaborações aparecerão aqui. Créditos e contatos não criam vínculos avaliáveis automaticamente.</p><% } %>
<section class="co-panel"><h2>Avaliações recebidas e liberadas</h2><% if(!recebidas.length){ %><p class="co-note">Nenhuma avaliação liberada.</p><% } %><% recebidas.forEach(a=>{ %><article class="co-review"><strong><%= a.nota.toFixed(1).replace('.',',') %> / 5</strong><p><%= a.avaliador %> · <%= a.titulo %></p><p class="co-prose"><%= a.comentario %></p><a href="/colaboracoes/<%= a.colaboracao_id %>">Consultar vínculo e solicitar revisão</a></article><% }) %></section>
<% } %>
<% if(tela==='novo'){ %><header class="co-heading"><div><span class="co-eyebrow">CONVITE PROFISSIONAL</span><h1>Propor colaboração</h1><p>O vínculo envolve duas pessoas. A outra parte precisa aceitar.</p></div></header>
<form method="post" action="/colaboracoes" class="co-form co-panel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>@ do profissional<input name="destinatario" required maxlength="25" value="<%= destinatario %>" placeholder="@profissional"></label><div class="co-fields"><label>Título do trabalho<input name="titulo" required minlength="3" maxlength="120"></label><label>Natureza do trabalho<input name="natureza" required minlength="3" maxlength="60" placeholder="Ex.: produção musical, fotografia"></label></div><label>Descrição do trabalho e dos combinados<textarea name="descricao" required minlength="10" maxlength="3000" rows="4"></textarea></label><div class="co-fields"><label>Sua função<input name="funcao_proponente" required minlength="2" maxlength="160"></label><label>Função da outra pessoa<input name="funcao_convidado" required minlength="2" maxlength="160"></label></div><label>Data / período aproximado<input name="periodo" maxlength="100"></label>
<div class="co-fields"><label>Tipo de registro relacionado<select name="origem_tipo"><option value="">Sem registro na Cypher</option><option value="obra">Obra</option><option value="beat">Beat</option><option value="evento">Evento</option><option value="projeto">Projeto / galeria</option></select></label><label>Registro relacionado<select name="origem_id"><option value="">Nenhum</option><% referencias.forEach(r=>{ %><option value="<%= r.id %>"><%= r.titulo %> · <%= r.modalidade %></option><% }) %></select></label></div><p class="co-note">Vincular mantém o registro original e suas permissões. Escolha o tipo correspondente ao registro.</p>
<label class="co-check"><input type="checkbox" name="exige_lancamento" value="sim"> A entrega depende de lançamento público de uma obra. A conclusão exigirá evidência e reconhecimento das duas partes.</label>
<label class="co-check"><input type="checkbox" name="publico" value="sim"> Solicitar associação pública. A publicação dependerá também do consentimento da outra pessoa.</label>
<label class="co-check"><input type="checkbox" name="consentimento" value="sim" required> Entendo que a colaboração começa privada e exige aceite. Após conclusão válida, as avaliações facultativas podem compor a reputação agregada, mesmo em vínculo privado. Detalhes exigem autorização bilateral.</label><button class="co-button co-primary">Enviar convite</button></form><% } %>
<% if(tela==='detalhe'){ %>
<a class="co-back" href="/colaboracoes">← Minhas colaborações</a><header class="co-heading"><div><span class="co-state"><%= c.nomeEstado %></span><h1><%= c.titulo %></h1><p>Com <%= c.outro_nome %> · <%= c.natureza %></p></div></header>
<section class="co-panel"><h2>Contexto do trabalho</h2><p class="co-prose"><%= c.descricao %></p><dl class="co-facts"><div><dt>Seu papel</dt><dd><%= c.eProponente?c.funcao_proponente:c.funcao_convidado %></dd></div><div><dt>Papel da outra pessoa</dt><dd><%= c.eProponente?c.funcao_convidado:c.funcao_proponente %></dd></div><div><dt>Período</dt><dd><%= c.periodo||'Não informado' %></dd></div><div><dt>Associação</dt><dd><%= c.publico_a&&c.publico_b&&c.aceita_em?'Pública por consentimento bilateral':'Privada' %></dd></div></dl>
<% if(c.exige_lancamento){ %><p class="co-note">A entrega depende de evidência de lançamento. O cadastro da obra não basta.</p><% if(c.evidencia_url){ %><a href="<%= c.evidencia_url %>" target="_blank" rel="noopener noreferrer">Conferir evidência de lançamento ↗</a><p class="co-prose"><%= c.evidencia_descricao %></p><% } %><% } %>
<p class="co-note">Uma colaboração confirmada é uma declaração bilateral de trabalho; ela não certifica autoria, direitos ou contratação.</p></section>
<% function acao(id,nome,campos=''){ %><form method="post" action="/colaboracoes/<%= c.id %>/acoes/<%= id %>" class="co-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= c.versao %>"><%- campos %><button class="co-button <%= id==='confirmar_conclusao'||id==='aceitar'?'co-primary':'' %>"><%= nome %></button></form><% } %>
<section class="co-panel"><h2>Próxima etapa</h2><div class="co-actions">
<% if(c.estado==='pendente_aceite'){if(c.eProponente){acao('cancelar_convite','Cancelar convite');}else{acao('aceitar','Aceitar colaboração','<label class="co-check"><input type="checkbox" name="consentimento" value="sim" required> Aceito o vínculo e entendo as regras de privacidade, reputação agregada e avaliação facultativa.</label><label class="co-check"><input type="checkbox" name="publico" value="sim"> Consinto com a associação pública. Ela só será exibida se houver o consentimento das duas partes.</label>');acao('recusar','Recusar convite');}} %>
<% if(c.estado==='em_andamento'&&!c.cancelamento_por){acao('pedir_conclusao','Solicitar conclusão',c.exige_lancamento?'<label>Link HTTPS de lançamento ou áudio /work-media/…<input type="text" name="evidencia_url" required maxlength="2048"></label><label>Descreva a evidência<textarea name="evidencia_descricao" required minlength="10" maxlength="2000"></textarea></label><label class="co-check"><input type="checkbox" name="evidencia_confirmada" value="sim" required> Verifiquei o áudio ou a publicação e sua correspondência com esta entrega.</label>':'');acao('pedir_cancelamento','Pedir cancelamento','<label>Motivo<textarea name="motivo" maxlength="2000" required></textarea></label>');} %>
<% if(c.estado==='em_andamento'&&c.cancelamento_por){ %><p>Há um pedido de cancelamento aguardando resposta. Ele vence em <%= data(c.cancelamento_em+14*86400000) %>.</p><% if(c.cancelamento_por!==usuario.id){acao('confirmar_cancelamento','Concordar com o cancelamento');acao('manter_colaboracao','Manter colaboração');}} %>
<% if(c.estado==='conclusao_pendente'){ %><p>Uma confirmação foi solicitada em <%= data(c.pedido_conclusao_em) %>.</p><% if(c.pedido_conclusao_por!==usuario.id){acao('confirmar_conclusao','Confirmar conclusão','<label class="co-check"><input type="checkbox" name="confirmacao" value="sim" required> Reconheço que a entrega foi concluída.</label>'+(c.exige_lancamento?'<label class="co-check"><input type="checkbox" name="evidencia_confirmada" value="sim" required> Conferi a evidência de lançamento e reconheço o lançamento desta entrega.</label>':''));acao('ainda_nao','Ainda não concluímos');}else{ %><p class="co-note">Aguardando a outra pessoa. O silêncio não conclui a colaboração.</p><% }} %>
<% if(c.estado==='contestada'){ %><p>A colaboração está em análise. Avaliações permanecem bloqueadas até uma decisão válida.</p><% } %>
<% if(c.estado==='concluida'){ %><p>Conclusão: <%= data(c.concluida_em) %>. Prazo para avaliar: <strong><%= data(c.prazo_avaliacao_em) %></strong>.</p><% if(c.enviou){ %><p class="co-feedback">Avaliação enviada. O conteúdo só é liberado após ambos enviarem ou após o fim do prazo.</p><% }else if(!c.podeAvaliar){ %><p class="co-note">O prazo de avaliação terminou.</p><% }} %>
</div></section>
<% if(c.podeAvaliar){ %><form method="post" action="/colaboracoes/<%= c.id %>/avaliacoes" class="co-panel co-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Avaliar a experiência com <%= c.outro_nome %></h2><p>Use os critérios da convivência profissional. O envio é facultativo, único e definitivo; as notas permanecem lacradas até ambos enviarem ou até encerrar o prazo.</p><div class="co-fields"><% [['comunicacao','Comunicação'],['combinados','Cumprimento de combinados'],['equipe','Trabalho em equipe']].forEach(([id,nome])=>{ %><label><%= nome %><select name="<%= id %>" required><option value="">Escolha</option><% [1,2,3,4,5].forEach(n=>{ %><option value="<%= n %>"><%= n %></option><% }) %></select></label><% }) %></div><label>Comentário opcional<textarea name="comentario" maxlength="1000" rows="3"></textarea></label><label class="co-check"><input type="checkbox" name="confirmacao" value="sim" required> Confirmo o envio definitivo, dentro do prazo informado.</label><button class="co-button co-primary">Enviar avaliação</button></form><% } %>
<section class="co-panel"><h2>Avaliações liberadas</h2><% if(!c.avaliacoes.length){ %><p class="co-note">Nenhuma avaliação liberada para exibição.</p><% } %><% c.avaliacoes.forEach(a=>{ %><article class="co-review"><strong><%= ((a.comunicacao+a.combinados+a.equipe)/3).toFixed(1).replace('.',',') %> / 5</strong><p><%= a.avaliador %></p><p>Comunicação <%= a.comunicacao %> · Combinados <%= a.combinados %> · Equipe <%= a.equipe %></p><p class="co-prose"><%= a.comentario %></p><% if(a.avaliado_id===usuario.id){ %><details><summary>Denunciar avaliação</summary><form method="post" action="/colaboracoes/<%= c.id %>/contestar" class="co-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="avaliacao_id" value="<%= a.id %>"><label>Motivo<select name="motivo"><% motivos.forEach(m=>{ %><option value="<%= m %>"><%= m.replaceAll('_',' ') %></option><% }) %></select></label><label>Justificativa<textarea name="detalhes" minlength="10" maxlength="3000" required></textarea></label><label>Evidências / referências<textarea name="evidencias" maxlength="3000"></textarea></label><button class="co-button">Solicitar revisão</button></form></details><% } %></article><% }) %></section>
<% if(c.estado!=='invalidada'){ %><details class="co-panel"><summary>Privacidade da associação</summary><p>A reputação agregada não depende da divulgação do vínculo. Qualquer participante pode retirar a publicidade imediatamente.</p><% acao('visibilidade','Registrar preferência','<label>Associação<select name="publico"><option value="">Tornar privada / retirar consentimento</option><option value="sim">Consinto com a associação pública</option></select></label>'); %></details><% } %>
<% if(['pendente_aceite','em_andamento','conclusao_pendente','concluida'].includes(c.estado)){ %><details class="co-panel"><summary>Contestar vínculo ou conclusão</summary><form class="co-form" method="post" action="/colaboracoes/<%= c.id %>/contestar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Motivo<input name="motivo" minlength="3" maxlength="100" required></label><label>Justificativa<textarea name="detalhes" minlength="10" maxlength="3000" required></textarea></label><label>Evidências / referências<textarea name="evidencias" maxlength="3000"></textarea></label><button class="co-button">Encaminhar contestação</button></form></details><% } %>
<% c.casos.forEach(k=>{ %><section class="co-panel"><h2>Solicitação de revisão</h2><p>Protocolo <%= k.id %> · <%= k.estado.replaceAll('_',' ') %></p><p><%= k.motivo.replaceAll('_',' ') %></p><p class="co-prose"><%= k.detalhes %></p><% if(k.decisao){ %><p>Decisão: <%= k.decisao.replaceAll('_',' ') %></p><p class="co-prose"><%= k.justificativa %></p><% } %><% k.manifestacoes.forEach(x=>{ %><blockquote><strong><%= x.autor %></strong><p class="co-prose"><%= x.texto %></p></blockquote><% }) %>
<% if(['aberta','em_analise'].includes(k.estado)){ %><form class="co-form" action="/colaboracoes/casos/<%= k.id %>/manifestar" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Sua manifestação<textarea name="texto" minlength="10" maxlength="3000" required></textarea></label><button class="co-button">Registrar manifestação</button></form><% } %>
<% if(k.estado==='decidida'){ %><details><summary>Solicitar recurso</summary><form class="co-form" action="/colaboracoes/<%= c.id %>/contestar" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="recurso_de" value="<%= k.id %>"><input type="hidden" name="avaliacao_id" value="<%= k.avaliacao_id||'' %>"><input type="hidden" name="motivo" value="<%= k.avaliacao_id?'outro':'recurso' %>"><label>Fundamento do recurso<textarea name="detalhes" minlength="10" maxlength="3000" required></textarea></label><label>Evidências<textarea name="evidencias" maxlength="3000"></textarea></label><button class="co-button">Pedir nova análise</button></form></details><% } %></section><% }) %>
<details class="co-panel"><summary>Histórico da colaboração</summary><ol class="co-history"><% c.historico.forEach(h=>{ %><li><strong><%= h.acao.replaceAll('_',' ') %></strong><small><%= data(h.ocorrida_em) %></small><p class="co-prose"><%= h.justificativa %></p></li><% }) %></ol></details>
<% } %>
<% if(tela==='reputacao'){ %><header class="co-heading"><div><span class="co-eyebrow">EXPERIÊNCIA PROFISSIONAL</span><h1>Reputação de <%= perfil.nome %></h1></div></header><section class="co-panel"><%- include('../partials/componentes/reputacao-resumo',{resumo}) %><p class="co-note">A média pondera igualmente cada profissional avaliador. Vínculos privados contribuem somente para os dados agregados.</p></section><% resumo.avaliacoesPublicas.forEach(a=>{ %><article class="co-panel"><strong><%= a.nota.toFixed(1).replace('.',',') %> / 5</strong><h2><%= a.titulo %></h2><p><%= a.avaliador %> · <%= a.papel %></p><p class="co-prose"><%= a.comentario %></p></article><% }) %><% } %>
<% if(tela==='fila'){ %><header class="co-heading"><div><span class="co-eyebrow">MODERAÇÃO / REPUTAÇÃO</span><h1>Solicitações e contestações</h1><p>Analise contestações, confira a manifestação das partes e registre a decisão.</p></div></header><p class="admin-queue-count"><%= itens.length %> <%= itens.length === 1 ? "caso na fila" : "casos na fila" %></p>
<% const abertos=itens.filter(k=>["aberta","em_analise"].includes(k.estado));const decididos=itens.filter(k=>!["aberta","em_analise"].includes(k.estado));const verCasos = grupo => { %><% grupo.forEach(k=>{ %><a class="co-card" href="/admin/reputacao/<%= k.id %>"><span class="co-state"><%= k.estado.replaceAll('_',' ') %></span><h2><%= k.motivo.replaceAll('_',' ') %></h2><p><%= k.recurso_de?'Recurso · ':'' %><%= k.vinculo_estado.replaceAll('_',' ') %></p><small><%= data(k.criada_em) %></small></a><% }) %><% }; %>
<section class="admin-lane"><h2>Casos em aberto</h2><% if(abertos.length){ %><div class="co-list"><% verCasos(abertos); %></div><% }else{ %><p class="admin-empty-work">Nenhuma contestação em aberto.</p><% } %></section>
<details class="co-panel admin-archive"><summary>Histórico de decisões <span class="admin-badge"><%= decididos.length %></span></summary><% if(decididos.length){ %><div class="co-list"><% verCasos(decididos); %></div><% }else{ %><p>Nenhum caso decidido.</p><% } %></details><% } %>
<% if(tela==='caso'){const k=caso,c=colaboracao; %><a class="co-back" href="/admin/reputacao">← Fila de moderação</a><header class="co-heading"><div><span class="co-state"><%= k.estado.replaceAll('_',' ') %></span><h1>Revisão de colaboração</h1><p>Protocolo <%= k.id %></p></div></header><section class="co-panel"><h2><%= c.titulo %></h2><p><%= partes.map(p=>p.nome).join(' · ') %></p><p class="co-prose"><%= k.detalhes %></p><h3>Evidências / referências</h3><p class="co-prose"><%= k.evidencias||'Nenhuma referência adicional.' %></p><p>Associação <%= c.publico_a&&c.publico_b?'pública':'privada' %> · <%= estadosColaboracao[c.estado] %></p><p class="co-note">Sinais para revisão humana: <%= padroes.vinculos %> vínculos nesta dupla; <%= padroes.concluidas||0 %> concluídos. Esses números não determinam punição.</p>
<dl class="co-facts"><% sinais.forEach(s=>{ %><div><dt><%= s.nome %> · histórico recente</dt><dd>Conta criada em <%= data(Date.parse(s.criado_em+'Z')) %></dd><dd><%= s.avaliacoes_30d %> avaliações liberadas enviadas em 30 dias</dd><dd><%= s.conclusoes_7d %> conclusões em 7 dias</dd></div><% }) %></dl>
<% manifestacoes.forEach(x=>{ %><blockquote><strong><%= x.autor %></strong><p class="co-prose"><%= x.texto %></p></blockquote><% }) %><% if(avaliacao||inspecao){const a=inspecao||avaliacao; %><h3>Avaliação pertinente ao caso</h3><p>Comunicação <%= a.comunicacao %> · Combinados <%= a.combinados %> · Equipe <%= a.equipe %></p><p class="co-prose"><%= a.comentario %></p><% }else if(k.avaliacao_id){ %><p class="co-note">Conteúdo não liberado. Acesso excepcional exige necessidade concreta, risco grave e auditoria.</p><form class="co-form" method="post" action="/admin/reputacao/<%= k.id %>/inspecionar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Necessidade do acesso<textarea name="necessidade" minlength="20" maxlength="3000" required></textarea></label><label class="co-check"><input type="checkbox" name="risco_grave" value="sim" required> Este conteúdo é necessário à investigação de risco grave.</label><button class="co-button">Consultar com registro de auditoria</button></form><% } %></section>
<% if(['aberta','em_analise'].includes(k.estado)){ %><form class="co-panel co-form" method="post" action="/admin/reputacao/<%= k.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Registrar análise</h2><label>Decisão<select name="decisao"><option value="assumir">Assumir análise</option><% if(k.recurso_de&&c.estado==='invalidada'){ %><option value="restaurar_vinculo">Reverter invalidação em recurso, preservando prazo original</option><% } %><% const opcoes=k.avaliacao_id?[['manter','Manter avaliação'],['ocultar_avaliacao','Ocultar cautelarmente e suspender cômputo'],['ocultar_comentario','Ocultar somente comentário'],['invalidar_avaliacao','Invalidar avaliação'],['restaurar','Restaurar avaliação'],['invalidar_vinculo','Invalidar colaboração e avaliações']]:[['retomar','Devolver ao trabalho em andamento'],['cancelar','Encerrar sem conclusão válida'],['concluir','Reconhecer conclusão fundamentada'],['invalidar_vinculo','Invalidar conclusão anterior e avaliações']];opcoes.forEach(([id,nome])=>{ %><option value="<%= id %>"><%= nome %></option><% }) %></select></label><label>Fundamentação<textarea name="justificativa" required minlength="20" maxlength="3000"></textarea></label><label>Evidências verificadas<textarea name="evidencias" maxlength="3000"></textarea></label><label class="co-check"><input type="checkbox" name="evidencias_suficientes" value="sim"> Há evidências suficientes e foi oferecida oportunidade de manifestação para reconhecer conclusão.</label><p class="co-note">A conclusão excepcional exige aceite anterior, evidências e manifestação da outra parte ou 7 dias para resposta. Recursos exigem outro revisor. Uma conclusão anterior mantém o prazo original.</p><button class="co-button co-primary">Registrar decisão</button></form><% }else{ %><section class="co-panel"><h2>Decisão registrada</h2><p><%= k.decisao %></p><p class="co-prose"><%= k.justificativa %></p></section><% } %><details class="co-panel"><summary>Histórico pertinente</summary><ol class="co-history"><% historico.forEach(h=>{ %><li><strong><%= h.acao.replaceAll('_',' ') %></strong><small><%= data(h.ocorrida_em) %></small><p class="co-prose"><%= h.justificativa %></p></li><% }) %></ol></details><% } %>
</main><% if(usuario.tipoConta!=='administrativo'){ %><%- include('../partials/navegacao-mobile',{rotaAtual:path}) %><% } %></div></div><%- include('../partials/fim-pagina') %>
