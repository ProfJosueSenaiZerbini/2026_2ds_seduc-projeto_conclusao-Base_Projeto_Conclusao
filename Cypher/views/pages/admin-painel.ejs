<%- include('../partials/cabecalho', {title,stylesheet}) %>
<div class="app-shell dc-shell admin-shell"><%- include('../partials/navegacao-administrativa',{path,usuario}) %><main class="main-shell">
<%- include('../partials/barra-superior',{breadcrumb:'Administração'}) %>
<div class="page-content admin-page admin-dashboard"><header class="admin-dashboard-hero"><div><span class="eyebrow">CYPHER / EQUIPE</span><h1>Painel administrativo</h1><p>Olá, <%= usuario.name %>. Gerencie as atividades da plataforma em um só lugar.</p></div><span class="admin-role"><%= {super_admin:'Administrador Geral',moderador:'Moderador',editor:'Editor'}[usuario.papelAdministrativo] %></span></header>
<% if (['super_admin','moderador'].includes(usuario.papelAdministrativo)) { %><section class="admin-quick"><div class="admin-group-heading"><span>01 / OPERAÇÃO</span><h2>Áreas de trabalho</h2><p>Acesse as filas e acompanhe as solicitações.</p></div><div class="admin-quick-grid"><% if (usuario.papelAdministrativo === 'super_admin') { %><a href="/admin/revisao"><strong>Análises de taxonomia <span>↗</span></strong><small>Revise propostas de gêneros e profissões.</small></a><% } %><a href="/admin/revisao/excecoes"><strong>Exceções profissionais <span>↗</span></strong><small>Analise solicitações e esclarecimentos.</small></a><a href="/admin/moderacao"><strong>Suporte e moderação <span>↗</span></strong><small>Analise denúncias, acompanhe recursos e registre medidas.</small></a><a href="/admin/reputacao"><strong>Reputação <span>↗</span></strong><small>Revise contestações de colaborações e avaliações.</small></a><a href="/admin/oportunidades"><strong>Pedidos de serviço <span>↗</span></strong><small>Acompanhe pedidos e decisões.</small></a></div></section><% } %>
<% if (mensagem) { %><p class="profile-message profile-message-success" role="status"><%= mensagem %></p><% } %>
<% if (erro) { %><p class="profile-message profile-message-error" role="alert"><%= erro %></p><% } %>
<% if (usuario.papelAdministrativo === 'editor') { %><section class="settings-section card-surface"><h2>Conteúdo educativo</h2><p>Crie guias e acompanhe a qualidade das orientações da Cypher.</p><a class="button button-lime" href="/admin/central">Gerenciar conteúdos</a><a class="button button-outline" href="/admin/central/quality">Ver qualidade</a></section><% } %>

<% if (['super_admin','moderador'].includes(usuario.papelAdministrativo)) { %>
<details class="settings-section card-surface admin-disclosure"><summary>Exceção de identificador @ <span>Alteração excepcional</span></summary><p>Altere somente após analisar a solicitação. A decisão e o motivo ficam registrados.</p><form class="profile-edit-form" method="post" action="/admin/identificador"><label>@ atual<input name="atual" maxlength="25" required></label><label>Novo @<input name="novo" maxlength="25" required></label><label>Justificativa<textarea name="motivo" minlength="10" maxlength="500" required></textarea></label><button class="button button-outline" type="submit">Aplicar alteração excepcional</button><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form></details>
<% } %>
<% if (usuario.papelAdministrativo === 'super_admin') { %>
<div class="admin-group-heading"><span>02 / GOVERNANÇA</span><h2>Equipe e controle</h2><p>Gerencie acessos e consulte o histórico administrativo.</p></div><details class="settings-section card-surface admin-disclosure"><summary>Adicionar integrante da equipe <span>Criar acesso interno</span></summary><form class="profile-edit-form" method="post" action="/admin/equipe">
<label>Nome<input name="nome" minlength="2" maxlength="80" required></label><label>E-mail<input type="email" name="email" maxlength="254" required></label>
<label>Senha inicial<input type="password" name="senha" minlength="8" maxlength="128" autocomplete="new-password" required></label>
<label>Papel<select name="papel"><option value="moderador">Moderador</option><option value="editor">Editor</option><option value="super_admin">Administrador Geral</option></select></label>
<button class="button button-lime" type="submit">Criar acesso interno</button><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form></details>
<details class="settings-section card-surface admin-disclosure"><summary>Equipe <span>Consultar e gerenciar acessos</span></summary>
<% equipe.forEach(pessoa => { %><article class="admin-review-card"><h3><%= pessoa.nome %></h3><p><%= pessoa.email %></p><p><%= pessoa.ativo ? 'Acesso ativo' : 'Acesso revogado' %></p>
<% if (pessoa.id !== usuario.id) { %><form method="post" action="/admin/equipe/<%= pessoa.id %>"><label>Papel<select name="papel"><% ['super_admin','moderador','editor'].forEach(papel => { %><option value="<%= papel %>" <%= pessoa.papel === papel ? 'selected' : '' %>><%= {super_admin:'Administrador Geral',moderador:'Moderador',editor:'Editor'}[papel] %></option><% }) %></select></label><label><input type="checkbox" name="ativo" value="1" <%= pessoa.ativo ? 'checked' : '' %>> Acesso ativo</label><button class="button button-outline" type="submit">Salvar acesso</button><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><% } %></article><% }) %>
</details>
<details class="settings-section card-surface admin-disclosure"><summary>Histórico administrativo <span>Consultar registros</span></summary><% auditoria.forEach(item => { %><article class="admin-review-card"><strong><%= item.acao %></strong><p><%= item.autor %> → <%= item.alvo %></p><p><%= item.detalhe %></p><small><%= item.data %></small></article><% }) %></details>
<% } %>
</div></main></div><%- include('../partials/fim-pagina') %>
