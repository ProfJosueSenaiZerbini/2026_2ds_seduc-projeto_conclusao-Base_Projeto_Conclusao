<%- include('../partials/cabecalho', {title,stylesheet}) %>
<div class="app-shell dc-shell admin-shell"><a class="dc-skip" href="#admin-conteudo">Pular para o painel</a><%- include('../partials/navegacao-administrativa',{path,usuario}) %><main class="main-shell">
<%- include('../partials/barra-superior',{breadcrumb:'Administração'}) %>
<div class="page-content admin-page admin-dashboard" id="admin-conteudo" tabindex="-1">
<header class="admin-dashboard-hero">
  <div class="admin-hero-lead">
    <span class="admin-paper">CYPHER / EQUIPE</span>
    <h1>Painel administrativo</h1>
    <p>Olá, <%= usuario.name %>. Acompanhe o que precisa de decisão e acesse as ferramentas da sua área.</p>
    <div class="admin-hero-actions">
      <% if (usuario.papelAdministrativo === 'editor') { %><a class="button button-lime" href="/admin/central/reviews">Abrir fila editorial <span aria-hidden="true">↗</span></a><a class="button button-outline" href="/admin/central">Ver conteúdos</a>
      <% } else { %><a class="button button-lime" href="/admin/moderacao?estado=pendente">Ver denúncias e solicitações pendentes <span aria-hidden="true">↗</span></a><a class="button button-outline" href="/admin/revisao/excecoes">Ver exceções profissionais</a><% } %>
      <% if (usuario.papelAdministrativo === 'super_admin') { %><a class="button button-outline" href="#governanca">Equipe e histórico</a><% } %>
    </div>
  </div>
  <span class="admin-role"><%= {super_admin:'Administrador Geral',moderador:'Moderador',editor:'Editor'}[usuario.papelAdministrativo] %></span>
</header>
<% if (mensagem) { %><p class="profile-message profile-message-success" role="status"><%= mensagem %></p><% } %>
<% if (erro) { %><p class="profile-message profile-message-error" role="alert"><%= erro %></p><% } %>
<%- include("../partials/componentes/destinos-admin", { modo: "painel" }) %>
<% if (['super_admin','moderador'].includes(usuario.papelAdministrativo)) { %>
<details class="settings-section card-surface admin-disclosure"><summary>Exceção de identificador @ <span>Alteração excepcional</span></summary><p>Altere somente após analisar a solicitação. A decisão e o motivo ficam registrados.</p><form class="profile-edit-form" method="post" action="/admin/identificador"><label>@ atual<input name="atual" maxlength="25" required></label><label>Novo @<input name="novo" maxlength="25" required></label><label>Justificativa<textarea name="motivo" minlength="10" maxlength="500" required></textarea></label><button class="button button-outline" type="submit">Aplicar alteração excepcional</button><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form></details>
<% } %>
<% if (usuario.papelAdministrativo === 'super_admin') { %>
<div class="admin-group-heading" id="governanca"><span>ACESSO INTERNO</span><h2>Equipe e histórico</h2><p>Gerencie acessos e consulte as decisões registradas.</p></div><details class="settings-section card-surface admin-disclosure"><summary>Adicionar integrante da equipe <span>Criar acesso interno</span></summary><form class="profile-edit-form" method="post" action="/admin/equipe">
<label>Nome<input name="nome" minlength="2" maxlength="80" required></label><label>E-mail<input type="email" name="email" maxlength="254" required></label>
<label>Senha inicial<input type="password" name="senha" minlength="8" maxlength="128" autocomplete="new-password" required></label>
<label>Papel<select name="papel"><option value="moderador">Moderador</option><option value="editor">Editor</option><option value="super_admin">Administrador Geral</option></select></label>
<button class="button button-lime" type="submit">Criar acesso interno</button><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form></details>
<details class="settings-section card-surface admin-disclosure"><summary>Gerenciar equipe <span><%= equipe.length %> <%= equipe.length === 1 ? "integrante" : "integrantes" %> · papéis e acessos</span></summary>
<% equipe.forEach(pessoa => { %><article class="admin-review-card"><h3><%= pessoa.nome %></h3><p><%= pessoa.email %></p><p><%= pessoa.ativo ? 'Acesso ativo' : 'Acesso revogado' %></p>
<% if (pessoa.id !== usuario.id) { %><form method="post" action="/admin/equipe/<%= pessoa.id %>"><label>Papel<select name="papel"><% ['super_admin','moderador','editor'].forEach(papel => { %><option value="<%= papel %>" <%= pessoa.papel === papel ? 'selected' : '' %>><%= {super_admin:'Administrador Geral',moderador:'Moderador',editor:'Editor'}[papel] %></option><% }) %></select></label><label><input type="checkbox" name="ativo" value="1" <%= pessoa.ativo ? 'checked' : '' %>> Acesso ativo</label><button class="button button-outline" type="submit">Salvar acesso</button><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><% } %></article><% }) %>
</details>
<details class="settings-section card-surface admin-disclosure"><summary>Histórico administrativo <span>Consulte as alterações registradas recentemente</span></summary><% if (!auditoria.length) { %><p class="admin-empty-work">Ainda não há alterações registradas.</p><% } %><% auditoria.forEach(item => { %><article class="admin-review-card"><strong><%= item.acao %></strong><p><%= item.autor %> → <%= item.alvo %></p><p><%= item.detalhe %></p><small><%= item.data %></small></article><% }) %></details>
<% } %>
</div></main></div><%- include('../partials/fim-pagina') %>
