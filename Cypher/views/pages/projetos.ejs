<%- include('../partials/cabecalho',{title,stylesheet}) %>
<div class="dc-shell pt-shell">
<%- include('../partials/barra-lateral',{path}) %><div class="dc-page">
<%- include('../partials/componentes/cabecalho-descoberta',{titulo:'Trabalhos e galerias',tituloId:'pt-titulo',descricao:'Projetos, imagens e outras expressões da cena.'}) %>
<main class="pt-page" aria-labelledby="pt-titulo">
<% if(tela==='lista'){ %>
<header class="pt-heading"><div><span class="op-eyebrow">ACERVO DA CENA</span><h2><%= meus?'Meus projetos e trabalhos':'Projetos e expressões' %></h2><p>Explore experiências e produções de diferentes atuações.</p></div><% if(podeCriar){ %><a class="pt-button pt-primary" href="/work-projects/new">Criar trabalho <%- icones.plus %></a><% } %></header>
<form class="pt-filters" method="get"><label>Pesquisa<input name="q" maxlength="120" value="<%= q %>" placeholder="Título, descrição ou profissional"></label><label>Formato<select name="modalidade"><option value="">Todos os formatos</option><% formatos.forEach(f=>{ %><option value="<%= f.id %>" <%= modalidade===f.id?'selected':'' %>><%= f.nome %></option><% }) %></select></label><label class="pt-check"><input type="checkbox" name="meus" value="sim" <%= meus?'checked':'' %>> Somente meus trabalhos</label><button class="pt-button">Filtrar</button></form>
<div class="pt-grid"><% itens.forEach(p=>{const capa=p.itens.find(i=>i.mime.startsWith('image/')); %><a class="pt-card" href="/work-projects/<%= p.id %>"><div class="pt-card-art"><% if(capa){ %><img src="<%= capa.url %>" alt="" loading="lazy"><% }else{ %><span aria-hidden="true"><%- icones[({visual:'brush',audiovisual:'clapperboard',audio:'headphones',danca:'footprints',texto:'pen',tecnico:'sliders'})[p.modalidade]||'briefcase'] %></span><% } %></div><div><small><%= formatos.find(f=>f.id===p.modalidade)?.nome||'Projeto' %> · <%= p.publico?'Visível na Cypher':'Privado' %></small><h3><%= p.titulo %></h3><p><%= p.autor %></p><span class="pt-role"><%= p.papel||'Atuação declarada' %></span></div></a><% }) %></div>
<% if(!itens.length){ %><div class="pt-empty"><%- icones.briefcase %><h3>Nenhum trabalho encontrado.</h3><p>Altere os filtros ou registre uma nova experiência.</p></div><% } %>
<% }else{ const p=projeto; %>
<a class="et-back" href="/work-projects<%= p.autor_id===usuario.id?'?meus=sim':'' %>">← Voltar aos trabalhos</a>
<% if(salvo){ %><p class="pt-feedback" role="status">Trabalho salvo.</p><% } %>
<header class="pt-heading"><div><span class="op-eyebrow"><%= formatos.find(f=>f.id===p.modalidade)?.nome||'Projeto' %> · <%= p.publico?'Visível na Cypher':'Privado' %></span><h2><%= p.titulo %></h2><p><%= p.autor %></p></div><% if(p.autor_id===usuario.id){ %><a class="pt-button" href="/work-projects/<%= p.id %>/edit">Editar trabalho</a><% } %></header>
<%- include('../partials/componentes/acoes-conteudo', { tipo:'projeto', id:p.id }) %>
<a class="pt-button" href="/suporte/new?objeto_tipo=projeto&amp;objeto_id=<%= encodeURIComponent(p.id) %>">Denunciar este trabalho</a>
<% if(p.autor_id===usuario.id){ %><a class="ci-button" href="/publicacoes/projeto/<%= p.id %>/midias">Enviar mídia do trabalho</a><% } %>
<%- include('../partials/componentes/midias-publicacao',{tipo:'projeto',id:p.id}) %>
<section class="pt-panel"><h3>Sobre o trabalho</h3><p class="pt-prose"><%= p.descricao %></p><p class="pt-note">Informações e resultados declarados pelo responsável. A presença na equipe não comprova crédito confirmado ou Collab concluída.</p><dl class="pt-facts"><% [['objetivo','Objetivo'],['papel','Função exercida'],['inicio','Início'],['fim','Fim'],['equipe','Equipe / participantes'],['entregas','Entregas'],['resultados','Resultados']].forEach(([k,n])=>{if(p[k]){ %><div><dt><%= n %></dt><dd class="pt-prose"><%= p[k] %></dd></div><% }}) %><div><dt>Atuações</dt><dd><%= p.profissoes.map(id=>profissoes.find(f=>f.id===id)?.rotulo||id).join(' · ')||'Não informadas' %></dd></div></dl><% if(p.texto){ %><h3>Texto / relato</h3><div class="pt-prose"><%= p.texto %></div><% } %></section>
<section class="pt-panel"><h3>Materiais e trabalhos relacionados</h3><div class="pt-gallery"><% p.itens.forEach(i=>{ %><figure><% if(i.mime.startsWith('image/')){ %><a href="<%= i.url %>" target="_blank" rel="noopener"><img src="<%= i.url %>" alt="<%= i.legenda||i.nome %>" loading="lazy"></a><% }else if(i.mime.startsWith('video/')){ %><video controls preload="metadata" src="<%= i.url %>" aria-label="<%= i.legenda||i.nome %>"></video><% }else if(i.mime.startsWith('audio/')){ %><audio controls preload="metadata" src="<%= i.url %>" aria-label="<%= i.legenda||i.nome %>"></audio><% }else{ %><a class="pt-button" href="<%= i.url %>" <%- i.mime==='link'?'target="_blank" rel="noopener noreferrer"':'' %>><%= i.nome %> <%- icones.externalLink %></a><% } %><figcaption><%= i.legenda||i.nome %><% if(i.mime==='link'){ %><small>Link externo</small><% } %></figcaption></figure><% }) %></div><% if(!p.itens.length){ %><p class="pt-note">Nenhum material disponível para sua conta.</p><% } %></section>
<% if(p.autor_id===usuario.id){ %><details class="pt-panel"><summary>Retirar trabalho</summary><form action="/work-projects/<%= p.id %>/withdraw" method="post"><p>O trabalho deixará de ser exibido. Seus arquivos e os registros vinculados serão preservados.</p><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="pt-button pt-danger">Confirmar retirada</button></form></details><% } %>
<% } %>
</main><%- include('../partials/navegacao-mobile',{rotaAtual:path}) %></div></div>
<%- include('../partials/fim-pagina') %>
