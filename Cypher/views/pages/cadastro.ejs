<%- include('../partials/cabecalho',{title,stylesheet}) %>
<link rel="stylesheet" href="/css/entrada.css">
<main class="tag-page entrada-cypher registration-page" data-tag-page data-active="<%= erro || tipoInicial ? dados.tipoConta : '' %>">
<a class="tag-brand" href="/login" aria-label="Cypher, entrar">CYPHER</a><%- include('../partials/componentes/tema-entrada') %><div class="tag-content"><div class="tag-shell">
<header class="tag-intro"><h1>Boas-vindas à Cypher!</h1><p>Como você participa da cena?</p></header>
<nav class="tag-stack" aria-label="Tipo de conta">
<% for (const [tipo,nome,descricao] of [['consumidor','Público','Descubra e acompanhe a cena.'],['profissional','Profissional','Mostre a todos sua arte!']]) { %>
<a href="<%= (erro || tipoInicial) && dados.tipoConta === tipo ? '/register' : '/register?tipo='+tipo %>" aria-label="<%= (erro || tipoInicial) && dados.tipoConta === tipo ? nome+' selecionado. Trocar tipo de conta' : 'Selecionar '+nome+'. '+descricao %>" class="tag-sticker" data-sticker="<%= tipo %>" aria-controls="cadastro-dados"><span class="sticker-paper"><span class="tag-band">CYPHER</span><strong><%= nome %></strong><small><%= descricao %></small></span></a>
<% } %></nav>
<section class="auth-panel tag-panel" id="cadastro-dados">
<h2 data-register-title tabindex="-1">Crie sua conta</h2><p data-register-description>Preencha seus dados para continuar.</p>
<% if(erro){ %><p class="auth-message auth-message-error" role="alert"><%= erro %></p><% } %>
<form method="post" action="/register" data-register-form data-atuacao-form data-start-stage="<%= etapaInicial %>">
<div hidden><% for(const tipo of ['consumidor','profissional']){ %><input type="radio" name="tipoConta" value="<%= tipo %>" <%= dados.tipoConta===tipo?'checked':'' %>><% } %></div>
  <ol class="register-steps" aria-label="Dados da conta e etapas do cadastro">
    <% for (const [id, nome] of [['conta','Nome'],['contato','Contato'],['acesso','Acesso'],['categorias','Atuação'],['vertentes','Vertentes'],['questionarios','Trajetória']]) { %>
      <li data-step-indicator="<%= id %>" <%= ['categorias','vertentes','questionarios'].includes(id) ? 'data-professional-only' : '' %>><span><%= nome %></span></li>
    <% } %>
  </ol>
  <section class="register-stage" data-register-stage="conta" aria-label="Nome e vulgo">
    <label>Nome completo<input id="register-name" name="name" minlength="2" maxlength="80" value="<%= dados.nomeInformado %>" autocomplete="name" required></label>
    <label class="nickname-switch"><input type="checkbox" name="possuiVulgo" value="1" data-has-nickname <%= dados.vulgo ? 'checked' : '' %>> Quero informar meu vulgo</label>
    <div data-nickname-fields <%= dados.vulgo ? '' : 'hidden' %>><label>Vulgo<input name="vulgo" minlength="2" maxlength="80" value="<%= dados.vulgo %>" autocomplete="nickname"></label></div>
    <p class="register-inline-error" data-stage-error role="alert" hidden></p>
    <div class="register-navigation"><button class="button button-lime" type="button" data-continue>Continuar →</button></div>
  </section>
  <section class="register-stage" data-register-stage="contato" aria-label="Nome de usuário e e-mail" hidden>
    <label>Nome de usuário<input name="identificador" value="<%= dados.identificador === '@' ? '' : dados.identificador %>" minlength="3" maxlength="25" placeholder="@seu.identificador" autocomplete="username" autocapitalize="none" spellcheck="false" pattern="@?[a-zA-Z0-9_.]{3,24}" required data-handle-input aria-describedby="handle-help handle-state"><small id="handle-help">De 3 a 24 letras, números, ponto ou sublinhado. Seu @ é único e identifica seu perfil.</small></label><p id="handle-state" data-handle-state role="status" aria-live="polite"></p>
    <label>E-mail<input name="email" type="email" maxlength="254" value="<%= dados.email %>" autocomplete="email" required><small>Você precisará confirmar este endereço para ativar a conta.</small></label>
    <p class="register-inline-error" data-stage-error role="alert" hidden></p>
    <div class="register-navigation"><button class="button button-outline" type="button" data-register-back>Voltar</button><button class="button button-lime" type="button" data-continue>Continuar →</button></div>
  </section>
  <section class="register-stage" data-register-stage="acesso" aria-label="Nascimento, gênero e senha" hidden>
    <%- include('../partials/componentes/olhos-senha') %>
    <div class="form-grid"><label>Data de nascimento<input name="nascimento" type="date" value="<%= dados.nascimento %>" max="<%= hoje %>" required autocomplete="bday"><small>Você precisa ter 18 anos ou mais.</small></label><%- include('../partials/componentes/genero',{identidade:dados}) %></div>
    <div class="form-grid"><label>Senha<input type="password" name="password" minlength="8" maxlength="128" autocomplete="new-password" required></label><label>Confirmar senha<input type="password" name="passwordConfirmation" minlength="8" maxlength="128" autocomplete="new-password" required></label></div>
    <p class="register-inline-error" data-stage-error role="alert" hidden></p><div class="register-navigation"><button class="button button-outline" type="button" data-register-back>Voltar</button><button class="button button-lime" type="button" data-account-next>Continuar <span aria-hidden="true">→</span></button></div>
  </section>
  <section class="register-stage" data-register-stage="categorias" aria-label="Atuação" hidden>
    <%- include('../partials/componentes/selecao-profissional',{gruposProfissionais,categoriasSelecionadas,vertentesDisponiveis,vertentesSelecionadas,mostrarVertentes:false}) %>
    <p class="register-inline-error" data-stage-error role="alert" hidden></p><div class="register-navigation"><button class="button button-outline" type="button" data-register-back>Voltar</button><button class="button button-lime" type="button" data-categories-next>Continuar →</button></div>
  </section>
  <section class="register-stage register-branches-stage" data-register-stage="vertentes" aria-label="Vertentes do rap" hidden>
    <%- include('../partials/componentes/vertentes-rapper',{vertentesDisponiveis,vertentesSelecionadas}) %>
    <p class="branches-selection-status" data-branches-status aria-live="polite">Nenhuma vertente selecionada.</p>
    <div class="register-navigation"><button class="button button-outline" type="button" data-register-back>Voltar</button><button class="button button-lime" type="button" data-continue>Continuar →</button></div>
  </section>
  <section class="register-stage" data-register-stage="questionarios" aria-label="Trajetória" hidden>
    <div class="trajectory-professions" data-question-category aria-label="Suas profissões" aria-live="polite"></div>
    <section class="professional-questionnaires" aria-label="Tempo de atuação por profissão"><% questionariosAtuacao.forEach((questionario,indice)=>{ %><%- include('../partials/componentes/questionario-atuacao',{categoriaAtuacao:questionario.categoria,perguntasAtuacao:questionario.perguntas,idQuestionario:`cadastro-atuacao-${indice}`,cadastro:true,legada:false,atuacoesExistentes,formatarRespostaAtuacao}) %><% }) %></section>
    <p class="register-inline-error" data-stage-error role="alert" hidden></p><div class="register-navigation register-navigation--trajectory"><button class="button button-outline" type="button" data-question-previous hidden>Profissão anterior</button><button class="button button-lime" type="button" data-question-next>Próxima profissão →</button><button class="button button-lime" type="submit" data-register-submit hidden>Finalizar cadastro →</button><button class="button button-outline" type="button" data-register-back>Voltar</button></div>
  </section>
  <noscript><style>[data-register-stage][hidden],[data-category-area-panel][hidden],[data-category-browser][hidden]{display:block!important}</style><p>Sem JavaScript, preencha os dados e, se for profissional, selecione as profissões e seus tempos de atuação abaixo.</p><button class="button button-lime" type="submit">Finalizar cadastro</button></noscript>
  <input type="hidden" name="respostasAtuacoesJson" data-respostas-atuacoes-json value="{}"><input type="hidden" name="visibilidadesAtuacoesJson" data-visibilidades-atuacoes-json value="{}"><div class="ctag-note" data-register-ctag hidden>Seu ID Cypher é único e permanece vinculado à mesma conta.</div><input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form></section>
<p class="tag-login">Já tem uma conta? <a href="/login">Entrar</a></p>
</div></div></main><script src="/js/questionario-atuacoes.js" defer></script><%- include('../partials/fim-pagina') %>
