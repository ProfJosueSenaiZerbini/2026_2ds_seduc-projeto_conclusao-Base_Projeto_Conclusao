<%- include('../partials/cabecalho', { title, stylesheet }) %>
<% const urlFiltro = (tipo, termo = '', refino = '', pag = 1) => {
     const params = new URLSearchParams();
     if (tipo !== 'tudo') params.set('tipo', tipo);
     if (termo) params.set('q', termo);
     if (refino) params.set('detalhe', refino);
     if (pag > 1) params.set('pagina', pag);
     return '/dashboard' + (params.size ? '?' + params : '');
   };
   function cabecao(titulo, url, acao = 'Ver mais') { %>
  <div class="dc-heading"><h2><%= titulo %></h2><% if (url) { %><a href="<%= url %>" aria-label="<%= acao %> — <%= titulo %>"><%= acao %> <%- icones.arrowRight %></a><% } %></div>
<% } %>
<div class="dc-shell">
  <a class="dc-skip" href="#conteudo-descoberta">Pular para o conteúdo</a>
  <%- include('../partials/barra-lateral', { path }) %>
  <div class="dc-page">
    <%- include('../partials/componentes/cabecalho-descoberta', {
      titulo: 'Descoberta', tituloId: 'titulo-descoberta', descricao: 'Obras, artistas, profissionais e a cultura em movimento.',
      busca: { acao: '/dashboard', termo: q, limite: 100, rotulo: 'Buscar na Cypher', filtros: { tipo: categoria === 'tudo' ? '' : categoria, detalhe } }
    }) %>
    <main class="dc-content" id="conteudo-descoberta" tabindex="-1">
      <div class="dc-controls">
        <nav class="dc-tabs" aria-label="Tipo de conteúdo">
          <% categorias.forEach(cat => { %>
            <a href="<%= urlFiltro(cat.id, q) %>"<% if (cat.id === categoria) { %> aria-current="page"<% } %>>
              <% if (cat.icone) { %><span aria-hidden="true"><%- icones[cat.icone] %></span><% } %>
              <%= cat.nome %>
            </a>
          <% }) %>
        </nav>
        <% if (opcoes.length || detalhe) { %>
          <details class="dc-filter"><summary aria-label="Refinar resultados" title="Refinar resultados"><%- icones.sliders %></summary>
            <form action="/dashboard">
              <input type="hidden" name="tipo" value="<%= categoria %>"><input type="hidden" name="q" value="<%= q %>">
              <label>Refinar resultados<select name="detalhe"><option value="">Todos</option>
                <% opcoes.forEach(op => { %><option <%= op === detalhe ? 'selected' : '' %>><%= op %></option><% }) %>
              </select></label><button type="submit">Aplicar filtro</button>
            </form>
          </details>
        <% } %>
      </div>
      <% if (filtrado) { %>
        <section class="dc-results"><% cabecao(q ? 'Resultados para “' + q + '”' : (categoria === 'musica' ? 'Lançamentos na cena' : categorias.find(c => c.id === categoria).nome), '/dashboard', 'Limpar filtros'); %>
          <p><%= total %> <%= total === 1 ? 'resultado' : 'resultados' %><%= detalhe ? ' · ' + detalhe : '' %></p>
          <% if (total) { %><div class="dc-result-grid">
            <% resultados.forEach(item => { %><%- include('../partials/componentes/item-descoberta', { item }) %><% }) %>
          </div><% } else { %><div class="dc-empty"><%- icones.search %><div><strong>Nenhum resultado por aqui.</strong><p>Experimente outro termo ou escolha uma categoria diferente.</p></div></div><% } %>
          <% if (paginas > 1) { %><nav class="dc-pagination" aria-label="Páginas dos resultados">
            <% if (pagina > 1) { %><a href="<%= urlFiltro(categoria,q,detalhe,pagina-1) %>">Anterior</a><% } %>
            <span>Página <%= pagina %> de <%= paginas %></span>
            <% if (pagina < paginas) { %><a href="<%= urlFiltro(categoria,q,detalhe,pagina+1) %>">Próxima</a><% } %>
          </nav><% } %>
        </section>
      <% } else { %>
        <div class="dc-columns">
          <div class="dc-main">
            <% const slidesEventos = eventosDestacados.map(ev => ({titulo: ev.titulo, texto: [ev.dataCurta, ev.hora, ev.local].filter(Boolean).join(' · '), foto: 'descoberta/' + ev.fotoDestaque, url: ev.url, acao: 'Ver evento'}));
            const [perfilDestacado] = pessoas;
            const [eventoDaAgenda] = agenda;
            const destaques = [
              ...slidesEventos.slice(0,1),
              perfilDestacado && { titulo: perfilDestacado.titulo, texto: [perfilDestacado.tipo, perfilDestacado.local].filter(Boolean).join(' · '), foto: imagemPerfilDemo(perfilDestacado.autor) || 'descoberta/profissionais.png', url: perfilDestacado.url, acao: 'Ver perfil' },
              obraDestacada && { titulo: obraDestacada.titulo, texto: [obraDestacada.autor, obraDestacada.tipo].filter(Boolean).join(' · '), url: obraDestacada.url, acao: 'Ver obra' },
              ...discosDestacados.map(obra => ({ titulo: obra.titulo, texto: [obra.autor, obra.tipo, discoDemo(obra.id).faixas.length + ' faixas'].join(' · '), foto: imagemPublicacaoDemo(obra.id), url: obra.url, acao: 'Ver lançamento' })),
              beatDestacado && { titulo: beatDestacado.titulo, texto: [beatDestacado.autor, beatDestacado.genero].filter(Boolean).join(' · '), foto: imagemPublicacaoDemo(beatDestacado.id), url: beatDestacado.url, acao: 'Ver beat' },
              eventoDaAgenda && { titulo: eventoDaAgenda.titulo, texto: [eventoDaAgenda.dataCurta, eventoDaAgenda.hora, eventoDaAgenda.local].filter(Boolean).join(' · '), foto: 'descoberta/eventos.jpg', url: eventoDaAgenda.url, acao: 'Ver evento' },
              ...slidesEventos.slice(1)
            ].filter(Boolean); %>
            <% if (destaques.length) { %>
            <section class="dc-feature" aria-label="Destaques da Cypher">
              <div id="destaques-conteudo" class="dc-feature-content">
              <% destaques.forEach((slide,i) => { %><a class="dc-slide" data-slide="<%= i %>" href="<%= slide.url %>" <%= i ? 'hidden' : '' %>>
                <% if (slide.foto) { %><picture>
                  <img src="/img/<%= slide.foto %>" alt="" decoding="async" loading="<%= i ? 'lazy' : 'eager' %>">
                </picture><% } %>
                <span class="dc-slide-copy"><span class="dc-stamp">Em destaque</span><strong><%= slide.titulo %></strong><span><%= slide.texto %></span><b><%= slide.acao %> <%- icones.arrowRight %></b></span>
              </a><% }) %>
              </div>
              <div class="dc-feature-nav" role="group" aria-label="Navegar pelos destaques" hidden>
                <button class="dc-feature-arrow dc-feature-prev" type="button" aria-label="Destaque anterior" aria-controls="destaques-conteudo"><%- icones.arrowLeft %></button>
                <div class="dc-dots" role="radiogroup" aria-label="Escolher destaque">
                  <% destaques.forEach((slide,i) => { %>
                    <label class="dc-dot dc-dot-<%= i % 2 === 0 ? 'green' : 'yellow' %>">
                      <input type="radio" name="destaque" aria-label="Destaque <%= i + 1 %> de <%= destaques.length %>: <%= slide.titulo %>" aria-controls="destaques-conteudo"<% if (i === 0) { %> checked<% } %>>
                    </label>
                  <% }) %>
                </div>
                <button class="dc-feature-arrow dc-feature-next" type="button" aria-label="Próximo destaque" aria-controls="destaques-conteudo"><%- icones.arrowRight %></button>
                <span class="dc-feature-status" role="status" aria-live="polite" aria-atomic="true"></span>
              </div>
            </section>
            <% } %>
            <section><% cabecao(musica.length ? 'Lançamentos na cena' : 'Explore por categoria', musica.length ? urlFiltro('musica') : ''); %>
              <div class="dc-tiles" role="region" aria-label="<%= musica.length ? 'Lançamentos na cena' : 'Explore por categoria' %> — rolagem horizontal" tabindex="0">
                <% if (musica.length) { musica.forEach(item => { %><%- include('../partials/componentes/item-descoberta', { item }) %><% }); } else { categorias.slice(1).forEach(cat => { %>
                  <a class="dc-category dc-cat-<%= cat.id %>" href="<%= urlFiltro(cat.id) %>">
                    <span class="dc-category-art"><img src="/img/<%= cat.foto %>" alt="" loading="lazy" decoding="async"><i aria-hidden="true"><%- icones[cat.icone] %></i></span>
                    <span class="dc-cat-info"><strong><%= cat.nome %></strong><small><%= cat.legenda %></small><%- icones.arrowUpRight %></span>
                  </a>
                <% }); } %>
              </div>
            </section>
            <section><% cabecao(pessoas[0]?.complementar ? 'Profissionais para colaborar' : 'Profissionais sugeridos', '/search'); %>
              <% if (pessoas.length) { %><div class="dc-people"><% pessoas.slice(0,3).forEach(item => { %><%- include('../partials/componentes/item-descoberta', { item }) %><% }) %></div>
              <% } else { %><div class="dc-empty"><%- icones.users %><div><strong>Novos nomes por aqui em breve</strong><p>Os perfis públicos de outros profissionais aparecem aqui.</p></div></div><% } %>
            </section>
            <section><% cabecao('Eventos em destaque', urlFiltro('eventos')); %>
              <% if (eventosDestacados.length) { %>
                <div class="dc-event-carousel">
                  <div id="eventos-destaque-conteudo" class="dc-tiles dc-event-tiles" role="region" aria-label="Eventos em destaque — rolagem horizontal" tabindex="0">
                    <% eventosDestacados.forEach(item => { %><%- include('../partials/componentes/item-descoberta', { item }) %><% }) %>
                  </div>
                  <% if (eventosDestacados.length > 1) { %>
                    <div class="dc-event-nav" role="group" aria-label="Navegar pelos eventos em destaque" hidden>
                      <button class="dc-feature-arrow dc-event-prev" type="button" aria-label="Evento anterior" aria-controls="eventos-destaque-conteudo"><%- icones.arrowLeft %></button>
                      <span class="dc-event-progress" aria-hidden="true"><span></span></span>
                      <button class="dc-feature-arrow dc-event-next" type="button" aria-label="Próximo evento" aria-controls="eventos-destaque-conteudo"><%- icones.arrowRight %></button>
                    </div>
                  <% } %>
                </div>
              <% } else { %><div class="dc-empty"><%- icones.calendarDays %><div><strong>Sem eventos em destaque</strong></div></div><% } %>
            </section>
          </div>
          <aside class="dc-aside" aria-label="Mais na cena">
            <section class="dc-panel"><% cabecao(pessoas.length > 3 ? 'Profissionais para conhecer' : 'Explore por atuação', '/search'); %>
              <% if (pessoas.length > 3) { pessoas.slice(3).forEach(item => { %><%- include('../partials/componentes/item-descoberta', { item }) %><% }); } else { %>
                <% for (const [nome, icone, desc] of [['Rapper','mic','Rimas e lançamentos'],['Beatmaker','headphones','Produção de beats'],['DJ','disc','Sets e performances']]) { %>
                  <a class="dc-role" href="<%= urlFiltro('profissionais', nome) %>"><i aria-hidden="true"><%- icones[icone] %></i><span><strong><%= nome %></strong><small><%= desc %></small></span><%- icones.arrowUpRight %></a>
                <% } %>
              <% } %>
            </section>
            <section class="dc-panel"><% cabecao('Próximos eventos', '/events?periodo=proximos&localizacao='); %>
              <% if (agenda.length) { %><div class="dc-event-stack"><% agenda.forEach(item => { %><%- include('../partials/componentes/item-descoberta', { item }) %><% }); %></div><% } else { %>
                <a class="dc-agenda" href="/events?localizacao="><i aria-hidden="true"><%- icones.calendarDays %></i><span><strong>Agenda da cena</strong><small>Consulte eventos de todas as regiões.</small></span><%- icones.arrowRight %></a>
              <% } %>
            </section>
            <section class="dc-panel dc-guide">
              <% cabecao('Cypher Central'); %>
              <%- include('../partials/componentes/cartao-central', { rotulo: 'Guia da cena', titulo: guia.q, descricao: guia.a, href: '/central' }) %>
            </section>
            <%- include('../partials/componentes/completar-identidade', { usuario }) %>
          </aside>
        </div>
      <% } %>
    </main>
    <%- include('../partials/navegacao-mobile', { rotaAtual: '/dashboard' }) %>
  </div>
</div>
<script src="/js/descoberta.js" defer></script>
<%- include('../partials/fim-pagina') %>
