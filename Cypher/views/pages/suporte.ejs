<%- include('../partials/cabecalho',{title,stylesheet}) %>
<% const admin=usuario.tipoConta==='administrativo';const estados={pendente:'Pendente',em_analise:'Em análise',resolvida:'Resolvida',arquivada:'Arquivada'}; %>
<div class="<%= admin?'app-shell dc-shell admin-shell':'dc-shell sp-shell' %>"><%- include('../partials/barra-lateral',{path}) %><div class="<%= admin?'main-shell':'dc-page' %>"><% if(admin){ %><%- include('../partials/barra-superior',{breadcrumb:'Suporte e moderação'}) %><% }else{ %><%- include('../partials/componentes/cabecalho-descoberta',{titulo:'Falar com a Cypher',tituloId:'sp-titulo',descricao:'Orientação, segurança e decisões com acompanhamento.'}) %><% } %>
<main class="sp-page <%= admin?'admin-page':'' %>">
<% if(tela==='erro'){ %><section class="sp-panel"><h1>Não foi possível continuar</h1><p role="alert"><%= erro %></p><a class="sp-button" href="<%= admin?'/admin/moderacao':'/suporte' %>">Voltar às solicitações</a></section><% } %>
<% if(tela==='lista'||tela==='fila'){ %><header class="sp-heading"><div><span class="sp-eyebrow"><%= admin?'EQUIPE / SEGURANÇA':'SEU CANAL COM A EQUIPE' %></span><h1><%= admin?'Suporte e moderação':'Minhas solicitações' %></h1><p><%= admin?'Priorize riscos, analise evidências pertinentes e fundamente cada decisão.':'Acompanhe dúvidas, sugestões, denúncias e recursos em um só lugar.' %></p></div><% if(!admin){ %><a class="sp-button sp-primary" href="/suporte/new">Nova solicitação <%- icones.plus %></a><% } %></header>
<% if(!admin&&restricao.restrita){ %><aside class="sp-notice"><strong>Seu acesso está restrito.</strong><p>Este canal continua disponível para consultar a decisão e recorrer. Veja suas solicitações abaixo.</p><a class="sp-button" href="/settings/encerramento">Encerrar minha conta</a></aside><% } %>
<% if(admin){ const estadoAtual = typeof filtroEstado === "string" ? filtroEstado : ""; %><nav class="sp-tabs" aria-label="Filtrar casos por estado"><a href="/admin/moderacao"<% if (!estadoAtual) { %> aria-current="page"<% } %>>Todos os casos</a><% Object.entries(estados).forEach(([id,n])=>{ %><a href="/admin/moderacao?estado=<%= id %>"<% if (estadoAtual === id) { %> aria-current="page"<% } %>><%= n %></a><% }) %></nav><% } %>
<% if(admin){ %><p class="admin-queue-count"><%= itens.length %> <%= itens.length === 1 ? "caso encontrado" : "casos encontrados" %></p><% } %><div class="sp-case-list"><% itens.forEach(i=>{ %><a class="sp-case-card" href="<%= admin?'/admin/moderacao/':'/suporte/' %><%= i.id %>"><span class="sp-status<%= admin ? " admin-badge" : "" %>"<% if (admin) { %> data-prioridade="<%= i.prioridade %>"<% } %>><%= estados[i.estado] %><%= i.prioridade==='alta'?' · Prioridade alta':'' %></span><h2><%= i.assunto %></h2><p><%= i.tipo==='recurso'?'Recurso':tipos.find(t=>t.id===i.tipo)?.nome %></p><small><%= data(i.criada_em) %></small></a><% }) %></div><% if(!itens.length){ %><div class="sp-empty"><h2>Nenhuma solicitação nesta lista.</h2><p>As atualizações aparecerão aqui quando houver registros.</p></div><% } %><% } %>
<% if(tela==='novo'){ %><a class="sp-back" href="/suporte">← Minhas solicitações</a><header class="sp-heading"><div><span class="sp-eyebrow">COMO PODEMOS AJUDAR?</span><h1>Abra uma solicitação</h1><p>Explique o que aconteceu e envie apenas informações necessárias ao atendimento.</p></div></header><form class="sp-panel sp-form" method="post" action="/suporte"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="chave_envio" value="<%= chave %>"><label>O que você precisa?<select name="tipo"><% tipos.forEach(t=>{ %><option value="<%= t.id %>" <%= prefill.objeto_id&&t.id==='denuncia'?'selected':'' %>><%= t.nome %></option><% }) %></select></label><label>Assunto<input name="assunto" minlength="5" maxlength="120" required></label><label>Descreva a situação<textarea name="descricao" required minlength="10" maxlength="4000" rows="4"></textarea></label><details <%= prefill.objeto_id?'open':'' %>><summary>Dados para denúncia</summary><p class="sp-note">Para denunciar, escolha o motivo e um registro existente.</p><div class="sp-fields"><label>Motivo<select name="motivo"><% motivos.forEach(m=>{ %><option value="<%= m.id %>"><%= m.nome %></option><% }) %></select></label><label>Tipo de registro<select name="objeto_tipo"><% [['perfil','Perfil'],['obra','Obra'],['beat','Beat'],['evento','Evento'],['projeto','Projeto / galeria'],['midia','Arquivo'],['oportunidade','Oportunidade'],['mensagem','Mensagem'],['comentario','Comentário'],['selo','Selo profissional'],['conduta','Conduta de uma conta']].forEach(([id,n])=>{ %><option value="<%= id %>" <%= prefill.objeto_tipo===id?'selected':'' %>><%= n %></option><% }) %></select></label></div><label>Identificador do registro (ou @ no caso de perfil)<input name="objeto_id" maxlength="100" value="<%= prefill.objeto_id %>"></label></details><label class="sp-check"><input type="checkbox" name="risco" value="sim"> Há ameaça concreta ou risco imediato que exige prioridade de análise.</label><label>Evidências ou referências (opcional)<textarea name="evidencias" maxlength="3000" rows="3"></textarea></label><p class="sp-note">O registro não comprova uma acusação e não produz punição automática. Mensagens privadas só podem ser denunciadas por um participante da conversa.</p><button class="sp-button sp-primary">Enviar solicitação</button></form><% } %>
<% if(tela==='detalhe'||tela==='caso'){ %><a class="sp-back" href="<%= admin?'/admin/moderacao':'/suporte' %>">← Voltar às solicitações</a><header class="sp-heading"><div><span class="sp-eyebrow">PROTOCOLO <%= c.id %></span><h1><%= c.assunto %></h1><p><%= estados[c.estado] %> · <%= c.prioridade==='alta'?'Prioridade alta':'Prioridade normal' %> · <%= data(c.criada_em) %></p></div></header>
<% if(admin&&!c.atribuido){ %><section class="sp-panel"><h2>Atribuição do caso</h2><p>Assuma a análise para consultar a descrição e as evidências pertinentes. A fila não exibe conteúdo reservado.</p><form class="sp-form" method="post" action="/admin/moderacao/<%= c.id %>/assign"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= c.versao %>"><button class="sp-button sp-primary">Assumir análise</button></form></section><% }else{ %>
<section class="sp-panel"><h2>Andamento</h2><% if(c.descricao){ %><p class="sp-prose"><%= c.descricao %></p><% } %><% if(c.evidencias&&!admin){ %><h3>Referências enviadas</h3><p class="sp-prose"><%= c.evidencias %></p><% } %><% if(c.resposta){ %><h3>Decisão comunicada</h3><p class="sp-prose"><%= c.resposta %></p><% } %><p class="sp-note">As evidências de outras pessoas são reservadas. O suporte mantém o histórico e não transfere acesso a conversas ou arquivos de terceiros.</p></section>
<% if(admin){ %><% if(usuario.papelAdministrativo==='super_admin'&&['pendente','em_analise'].includes(c.estado)){ %><details class="sp-panel"><summary>Responsável e prioridade</summary><form class="sp-form" method="post" action="/admin/moderacao/<%= c.id %>/assign"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= c.versao %>"><label>Responsável<select name="revisor_id"><% c.responsaveis.forEach(r=>{ %><option value="<%= r.usuario_id %>" <%= r.usuario_id===c.revisor_id?'selected':'' %>><%= r.nome %></option><% }) %></select></label><label>Prioridade<select name="prioridade"><option value="normal" <%= c.prioridade==='normal'?'selected':'' %>>Normal</option><option value="alta" <%= c.prioridade==='alta'?'selected':'' %>>Alta</option></select></label><button class="sp-button">Atualizar atribuição</button></form></details><% } %><details class="sp-panel"><summary>Consultar evidência pertinente</summary><form class="sp-form" method="post" action="/admin/moderacao/<%= c.id %>/evidence"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Por que o acesso é necessário?<textarea name="motivo" minlength="20" maxlength="1500" required></textarea></label><button class="sp-button">Consultar e registrar acesso</button></form></details><% if(evidencia){ %><section class="sp-panel"><h2>Evidência consultada com auditoria</h2><dl class="sp-facts"><% Object.entries(evidencia.objeto).forEach(([k,v])=>{ %><div><dt><%= k %></dt><dd class="sp-prose"><%= v %></dd></div><% }) %></dl><p class="sp-prose"><%= evidencia.referencias %></p></section><% } %>
<% if(['pendente','em_analise'].includes(c.estado)){ %><form class="sp-panel sp-form" method="post" action="/admin/moderacao/<%= c.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= c.versao %>"><h2>Registrar decisão</h2><div class="sp-fields"><label>Encaminhamento<select name="estado"><option value="resolvida">Resolvida</option><option value="arquivada">Arquivada</option></select></label><label>Medida<select name="decisao"><% acoes.forEach(a=>{ %><option value="<%= a.id %>"><%= a.nome %></option><% }) %></select></label></div><label>Resposta a comunicar<textarea name="resposta" minlength="10" maxlength="3000" required></textarea></label><label>Fundamentação interna<textarea name="motivo" minlength="20" maxlength="3000" required></textarea></label><div class="sp-fields"><label>Duração em dias (opcional)<input type="number" name="duracao_dias" min="1" max="365"></label><label>Medida anterior, para reverter<select name="medida_id"><option value="">Não se aplica</option><% c.medidas.filter(m=>!m.revogada_em).forEach(m=>{ %><option value="<%= m.id %>"><%= m.acao %> · <%= m.id %></option><% }) %></select></label></div><p class="sp-note">Advertir só comunica; restringir contato não suspende leitura; suspensão e encerramento restringem a conta, preservando este canal de recurso. Ocultar ou retirar afeta o registro, preservando sua origem.</p><button class="sp-button sp-primary">Registrar decisão fundamentada</button></form><% } %><% }else if(['pendente','em_analise'].includes(c.estado)){ %><form class="sp-panel sp-form" method="post" action="/suporte/<%= c.id %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= c.versao %>"><label>Complementar informações<textarea name="texto" minlength="10" maxlength="3000" required></textarea></label><button class="sp-button">Enviar complemento</button></form><% } %>
<% if(c.medidas.length){ %><section class="sp-panel"><h2>Medidas e revisões</h2><% c.medidas.forEach(m=>{ %><article class="sp-event"><strong><%= acoes.find(a=>a.id===m.acao)?.nome||m.acao %></strong><p class="sp-prose"><%= m.motivo %></p><small><%= m.revogada_em?'Revertida':m.ate&&m.ate<Date.now()?'Prazo encerrado':'Registrada' %><%= m.ate?' · Até '+data(m.ate):'' %></small></article><% }) %></section><% } %>
<section class="sp-panel"><h2>Histórico</h2><% c.historico.forEach(h=>{ %><article class="sp-event"><strong><%= h.acao.replaceAll('_',' ') %></strong><small><%= data(h.criada_em) %></small><p class="sp-prose"><%= h.texto %></p></article><% }) %></section>
<% if(!admin&&['resolvida','arquivada'].includes(c.estado)){ %><details class="sp-panel"><summary>Recorrer da decisão</summary><form class="sp-form" method="post" action="/suporte/<%= c.id %>/appeal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="chave_envio" value="<%= chave %>"><input type="hidden" name="versao" value="<%= c.versao %>"><label>Fundamento do recurso<textarea name="descricao" minlength="10" maxlength="4000" required></textarea></label><label>Novas referências<textarea name="evidencias" maxlength="3000"></textarea></label><p class="sp-note">O recurso é analisado por outro responsável e não apaga o histórico anterior.</p><button class="sp-button">Solicitar nova análise</button></form></details><% } %>
<% } %><% } %>
</main><% if(!admin){ %><%- include('../partials/navegacao-mobile',{rotaAtual:path}) %><% } %></div></div><%- include('../partials/fim-pagina') %>
