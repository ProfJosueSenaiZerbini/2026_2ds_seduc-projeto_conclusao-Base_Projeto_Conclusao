<%- include('../partials/cabecalho',{title,stylesheet}) %><link rel="stylesheet" href="/css/descoberta.css"><link rel="stylesheet" href="/css/refino-cypher.css">
<div class="dc-shell cy-activation"><%- include('../partials/barra-lateral',{path}) %><div class="dc-page"><%- include('../partials/componentes/cabecalho-descoberta',{titulo:'Ativar perfil profissional',tituloId:'titulo-ativacao',descricao:'Defina como você atua na cena.'}) %><main class="dc-content cy-activation-content" aria-labelledby="titulo-ativacao">
<header class="page-header"><div><span class="eyebrow">SUA ATUAÇÃO NA CENA</span><h2>Escolha suas atuações</h2><p>Escolha suas profissões e informe apenas o tempo de atuação. Detalhes adicionais ficam para depois.</p></div></header>
<% if(erro){ %><p class="profile-message profile-message-error" role="alert"><%= erro %></p><% } %>
<form class="profile-edit-form card-surface profile-edit-panel" method="post" action="/profile/profissionalizar" data-atuacao-form>
<%- include('../partials/componentes/selecao-profissional',{gruposProfissionais,categoriasSelecionadas,vertentesDisponiveis,vertentesSelecionadas}) %>
<% questionariosAtuacao.forEach((q,i)=>{ %><details data-profile-category-group data-categoria="<%= q.categoria %>" data-categoria-atual="false" hidden><summary><%= q.categoria %></summary><%- include('../partials/componentes/questionario-atuacao',{categoriaAtuacao:q.categoria,perguntasAtuacao:q.perguntas,ativacao:true,idQuestionario:`ativacao-${i}`,legada:false,atuacoesExistentes,formatarRespostaAtuacao}) %><p data-profile-question-validation role="alert" hidden></p></details><% }) %>
<label class="privacy-option"><span>Entendo que a ativação é irreversível e que meu perfil profissional será público, com controles individuais de privacidade.</span><input type="checkbox" name="confirmar" value="1" required></label>
<button class="button button-lime" type="submit">Ativar perfil profissional</button><a class="button button-outline" href="/profile">Voltar</a><input type="hidden" name="respostasAtuacoesJson" data-respostas-atuacoes-json value="{}"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form></main></div><%- include('../partials/navegacao-mobile',{rotaAtual:path}) %></div><script src="/js/questionario-atuacoes.js" defer></script><%- include('../partials/fim-pagina') %>
