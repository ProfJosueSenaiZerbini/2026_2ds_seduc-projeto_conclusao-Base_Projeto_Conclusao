<%- include('../partials/cabecalho', { title, stylesheet }) %>
<div class="dc-shell bl-shell"><a class="dc-skip" href="#beats-conteudo">Pular para o conteúdo</a><%- include('../partials/barra-lateral', {path}) %><div class="dc-page">
<%- include('../partials/componentes/cabecalho-descoberta',{titulo: path==='/purchases'?'Minhas Compras':'Banco de Beats',tituloId:'beats-titulo',descricao:'O som conecta. As condições ficam claras.'}) %>
<main class="bl-page" id="beats-conteudo" tabindex="-1" aria-labelledby="beats-titulo">
<nav class="bl-nav" aria-label="Beats e licenças"><a href="/beats">Explorar beats</a><a href="/purchases">Minhas Compras</a></nav>
<% if(erro){ %><p class="bl-feedback" role="alert"><%= erro %></p><% } %>
<% if(tela==='erro'){ %><section class="bl-panel"><h2>Vamos ajustar esse passo.</h2><p>Confira a informação acima e tente novamente. Seus registros anteriores continuam disponíveis.</p><a class="bl-button" href="/beats">Voltar ao Banco de Beats</a></section><% } %>
<% if(tela==='ficha'){ %>
<%- include('../partials/componentes/acoes-conteudo', { tipo:'beat', id:beat.id }) %>
<header class="bl-hero"><div><span class="dc-stamp">INSTRUMENTAL / ORIGINAL DA CENA</span><h2><%= beat.titulo %></h2><p>Produção de <a href="/p/<%= encodeURIComponent(beat.identificador.replace(/^@/,'')) %>"><strong><%= beat.produtor %></strong></a></p><div class="bl-tags"><% [beat.genero,beat.bpm?beat.bpm+' BPM':'',beat.tom_musical,beat.duracao].filter(Boolean).forEach(t=>{ %><span><%= t %></span><% }) %></div></div><div class="bl-record" aria-hidden="true"><%- icones.disc %><span>CYPHER<br>SIDE A</span></div></header>
<% if(beat.previa_id){ %><section class="bl-panel"><h3>Conheça a batida</h3><audio controls preload="none" src="/beats/<%= beat.id %>/preview">Seu navegador não suporta áudio.</audio><p class="bl-note">A prévia permite conhecer o som. A autorização de uso depende dos termos da oferta.</p></section><% } %>
<% if(beat.descricao){ %><p class="bl-prose"><%= beat.descricao %></p><% } %>
<%- include('../partials/componentes/creditos-ficha',{tipo:'beat',id:beat.id}) %>
<% if(beat.proprio){ %><a class="bl-button bl-outline" href="/creditos/gerir/beat/<%= encodeURIComponent(beat.id) %>">Gerenciar créditos</a><% } %>
<div class="bl-heading"><div><span class="bl-eyebrow">ESCOLHA COM CLAREZA</span><h2>Um beat. Suas possibilidades.</h2></div><% if(beat.proprio){ %><a class="bl-button" href="/beats/<%= beat.id %>/manage">Gerenciar arquivos e ofertas</a><% } %></div>
<% if(beat.vendidoExclusivo){ %><p class="bl-feedback"><strong>Vendido com exclusividade</strong><%= beat.compradorExclusivo?' · '+beat.compradorExclusivo:'' %>. Este instrumental não aceita novas aquisições.</p><% }else if(!beat.disponivel){ %><p class="bl-feedback">Novas aquisições estão pausadas. As licenças anteriores permanecem disponíveis.</p><% } %>
<div class="bl-offers"><% beat.ofertas.forEach(o=>{ %><article class="bl-offer"><div class="bl-offer-top"><span class="bl-badge"><%= o.modalidade==='free'?'Free Use':o.modalidade==='premium'?'Premium não exclusiva':'Exclusiva sob negociação' %></span><small>Versão <%= o.numero %></small></div><h3><%= o.termos.titulo %></h3><strong class="bl-price"><%= o.modalidade==='free'?'Sem cobrança':o.modalidade==='premium'?preco(o.preco_centavos):'Converse sobre os termos' %></strong>
<dl class="bl-terms"><% [['usos','Usos permitidos'],['restricoes','Restrições'],['creditos','Créditos'],['limites','Limites'],['entregaveis','O que você recebe']].forEach(([k,n])=>{ %><div><dt><%= n %></dt><dd><%= o.termos[k] %></dd></div><% }) %></dl>
<% if(o.modalidade==='exclusiva'){ %><p class="bl-note">A exclusividade tem condições próprias, combinadas diretamente com o produtor.</p><% }else if(!beat.proprio&&beat.disponivel){ %><form method="post" action="/beats/<%= beat.id %>/offers/<%= o.id %>/acquire" class="bl-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="chave_envio" value="<%= chave %>-<%= o.id %>"><input type="hidden" name="versao" value="<%= o.versao_id %>"><label class="bl-check"><input type="checkbox" required name="aceite" value="sim">Li e aceito estes termos de utilização, versão <%= o.numero %>.</label><button class="bl-button"><%= o.modalidade==='free'?'Aceitar Free Use e acessar arquivos':'Comprar licença Premium' %></button></form><% } %></article><% }) %></div>
<% if(!beat.ofertas.length){ %><section class="bl-panel"><h3>As condições ainda estão sendo preparadas.</h3><p>Este beat ainda não possui uma oferta de utilização disponível.</p></section><% } %>
<p class="bl-note">Free Use e Premium possuem condições próprias. A licença autoriza os usos descritos na oferta e preserva a autoria do produtor.</p><a class="bl-link" href="/suporte/new?objeto_tipo=beat&amp;objeto_id=<%= beat.id %>">Denunciar este beat</a>
<% } %>
<% if(tela==='ficha'){ %><%- include('../partials/componentes/midias-publicacao',{tipo:'beat',id:beat.id}) %><% } %>
<% if(tela==='gestao'){ const v=valores||{}, t=oferta?.termos||{}; const valor=(nome,padrao='')=>Object.hasOwn(v,nome)?v[nome]:padrao; const selecionados=Array.isArray(v.arquivos)?v.arquivos:typeof v.arquivos==='string'?[v.arquivos]:oferta?.arquivos||[]; %>
<header class="bl-heading"><div><span class="bl-eyebrow">SEU SOM, BEM ORGANIZADO</span><h2><%= beat.titulo %></h2><p>Prepare a prévia, escolha as entregas e publique condições claras.</p></div><div class="bl-actions"><a class="bl-button bl-outline" href="/beats/<%= beat.id %>/edit">Editar informações</a><a class="bl-button" href="/beats/<%= beat.id %>">Ver ficha</a></div></header>
<div class="bl-two"><section class="bl-panel"><h3>Arquivos</h3><a class="bl-button" href="/publicacoes/beat/<%= beat.id %>/midias">Enviar capa do beat</a><p>A prévia é acessível a quem pode ver o beat. Os arquivos de entrega ficam privados e só são liberados pela licença correspondente.</p>
<form class="bl-form" data-beat-upload="<%= beat.id %>"><label>Finalidade<select name="finalidade"><option value="previa">Prévia de áudio · até 12 MB</option><option value="entrega">Arquivo de entrega · até 50 MB</option></select></label><label>Áudio MP3, WAV ou OGG<input type="file" name="arquivo" accept="audio/mpeg,audio/wav,audio/ogg,.mp3,.wav,.ogg" required></label><button class="bl-button">Enviar arquivo</button><p class="bl-note" data-upload-status role="status"></p><noscript>Ative o JavaScript para enviar os arquivos.</noscript></form>
<ul class="bl-file-list"><% beat.arquivos.forEach(a=>{ %><li><span><strong><%= a.nome %></strong><small><%= a.finalidade==='previa'?'Prévia':'Entrega privada' %> · <%= (a.bytes/1024/1024).toFixed(1) %> MB</small></span><a href="/beats/<%= beat.id %>/files/<%= a.id %>">Conferir</a></li><% }) %></ul><p class="bl-note">Limite do acervo: 500 MB. Arquivos vinculados a termos anteriores são preservados para respeitar autorizações já concedidas.</p></section>
<section class="bl-panel"><h3>02 / Catálogo</h3><p><%= beat.disponivel?'Novas aquisições estão disponíveis.':'Novas aquisições estão pausadas.' %></p><form method="post" action="/beats/<%= beat.id %>/availability"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= beat.versao %>"><input type="hidden" name="disponivel" value="<%= beat.disponivel?'nao':'sim' %>"><button class="bl-button bl-outline"><%= beat.disponivel?'Pausar novas aquisições':'Retomar aquisições' %></button></form>
<div class="bl-offer-list"><% beat.ofertas.forEach(o=>{ %><article><div><strong><%= o.termos.titulo %></strong><small><%= o.modalidade==='free'?'Free Use':o.modalidade==='premium'?'Premium não exclusiva':'Exclusiva sob negociação' %> · v<%= o.numero %> · <%= o.ativa?'Disponível':'Retirada' %></small></div><div class="bl-actions"><a href="/beats/<%= beat.id %>/manage?oferta=<%= o.id %>#oferta">Revisar</a><% if(o.ativa){ %><form method="post" action="/beats/<%= beat.id %>/offers/<%= o.id %>/withdraw"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= o.numero %>"><button class="bl-link">Retirar</button></form><% } %></div></article><% }) %></div><p class="bl-note">Pausar ou revisar uma oferta mantém os termos e arquivos das licenças anteriores.</p></section></div>
<section class="bl-panel" id="oferta"><div class="bl-heading"><div><span class="bl-eyebrow">03 / CONDIÇÕES DE UTILIZAÇÃO</span><h2><%= oferta?'Revisar oferta':'Criar oferta' %></h2><p><%= oferta?'Ao salvar, uma nova versão é criada. Os aceites anteriores não são reescritos.':'Explique o que está permitido e quais arquivos fazem parte desta modalidade.' %></p></div><% if(oferta){ %><a href="/beats/<%= beat.id %>/manage#oferta">Criar outra oferta</a><% } %></div>
<form method="post" action="/beats/<%= beat.id %>/offers<%= oferta?'/'+oferta.id:'' %>" class="bl-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versao" value="<%= valor('versao',oferta?.numero||0) %>"><div class="bl-two"><label>Modalidade<select name="modalidade"><% [['free','Free Use'],['premium','Premium não exclusiva'],['exclusiva','Exclusiva sob negociação']].forEach(([id,n])=>{ %><option value="<%= id %>" <%= valor('modalidade',oferta?.modalidade||'free')===id?'selected':'' %>><%= n %></option><% }) %></select></label><label>Nome da oferta<input name="titulo" minlength="3" maxlength="80" required value="<%= valor('titulo',t.titulo||'') %>" placeholder="Ex.: Uso com créditos"></label><label>Preço em R$<input name="preco" inputmode="decimal" maxlength="9" value="<%= valor('preco',oferta?.modalidade==='premium'?(oferta.preco_centavos/100).toFixed(2):'') %>" placeholder="Somente para Premium"></label></div>
<div class="bl-two"><% [['usos','Usos permitidos',2000,10],['restricoes','Restrições',2000,10],['creditos','Atribuição e créditos',600,3],['limites','Limites de uso',1200,3],['entregaveis','Entregáveis',600,3]].forEach(([k,n,max,min])=>{ %><label><%= n %><textarea name="<%= k %>" required minlength="<%= min %>" maxlength="<%= max %>" rows="3"><%= valor(k,t[k]||'') %></textarea></label><% }) %></div>
<fieldset><legend>Arquivos autorizados nesta oferta</legend><% const entregas=beat.arquivos.filter(a=>a.finalidade==='entrega'); if(!entregas.length){ %><p class="bl-note">Envie ao menos um arquivo de entrega antes de publicar a oferta.</p><% } entregas.forEach(a=>{ %><label class="bl-check"><input type="checkbox" name="arquivos" value="<%= a.id %>" <%= selecionados.includes(a.id)?'checked':'' %>><%= a.nome %></label><% }) %></fieldset><p class="bl-note">Informe apenas permissões que você tem autorização para conceder. Samples e contribuições de terceiros continuam sujeitos aos direitos correspondentes.</p><button class="bl-button" <%= !entregas.length?'disabled':'' %>><%= oferta?'Publicar nova versão':'Publicar oferta' %></button></form></section>
<% } %>
<% if(tela==='confirmar'){ const p=pedido,s=p.snapshot; %><header class="bl-heading"><div><span class="bl-eyebrow">CONFIRA O SEU PEDIDO</span><h2>Uma batida. Seu próximo passo.</h2><p>Revise os arquivos e as condições da licença.</p></div></header><div class="bl-two"><section class="bl-panel"><h3><%= s.titulo %></h3><p><%= s.produtor %> · <%= s.oferta.titulo %></p><strong class="bl-price">Sem cobrança</strong><p class="bl-note">Premium não exclusiva · <%= s.arquivos.length %> arquivo(s)</p><ul class="bl-file-list"><% s.arquivos.forEach(a=>{ %><li><strong><%= a.nome %></strong></li><% }) %></ul><form method="post" action="/purchases/<%= p.id %>/confirm" class="bl-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="bl-check"><input type="checkbox" name="confirmacao" value="sim" required>Aceito as condições da licença.</label><button class="bl-button">Confirmar licença</button></form></section><section class="bl-panel"><h3>Os termos do seu som</h3><dl class="bl-terms"><% [['usos','Usos permitidos'],['restricoes','Restrições'],['creditos','Créditos'],['limites','Limites'],['entregaveis','Entregáveis']].forEach(([k,n])=>{ %><div><dt><%= n %></dt><dd><%= s.oferta[k] %></dd></div><% }) %></dl></section></div><% } %><% if(tela==='compras'){ %><header class="bl-hero"><div><span class="dc-stamp">SEU ACERVO DE LICENÇAS</span><h2>Do aceite<br>ao próximo som.</h2><p>Consulte suas compras, termos aceitos e arquivos autorizados.</p></div><span class="bl-record" aria-hidden="true"><%- icones.headphones %></span></header><div class="bl-purchases"><% itens.forEach(p=>{ %><a class="bl-purchase" href="/purchases/<%= p.id %>"><div><small><%= p.snapshot.modalidade==='free'?'Free Use':'Premium não exclusiva' %> · <%= data(p.criado_em) %></small><h3><%= p.snapshot.titulo %></h3><p><%= p.snapshot.oferta.titulo %></p></div><span class="bl-badge"><%= p.estado %></span><strong><%= p.checkoutCatalogo ? 'Sem cobrança' : preco(p.valor_centavos) %></strong><span aria-hidden="true"><%- icones.arrowUpRight %></span></a><% }) %><% if(!itens.length){ %><section class="bl-panel"><h3>Seu próximo som pode começar aqui.</h3><p>Os pedidos e aceites que você realizar aparecerão nesta área.</p><a class="bl-button" href="/beats">Explorar o Banco de Beats</a></section><% } %></div><% } %>
<% if(tela==='pedido'){ const p=pedido,s=p.snapshot; %><header class="bl-heading"><div><span class="bl-eyebrow"><%= s.modalidade==='free'?'AUTORIZAÇÃO FREE USE':'SUA LICENÇA PREMIUM' %></span><h2><%= s.titulo %></h2><p><%= s.oferta.titulo %> · <%= s.produtor %></p><small>Protocolo <%= p.id %> · <%= data(p.criado_em) %></small></div><span class="bl-badge"><%= p.estado %></span></header>
<% if(retorno){ %><p class="bl-feedback">Você voltou do checkout. A liberação depende da confirmação consultada no Mercado Pago. Use “Atualizar situação” se o pedido ainda estiver pendente.</p><% } %>
<div class="bl-two"><section class="bl-panel"><h3>Seu pedido</h3><strong class="bl-price"><%= p.checkoutCatalogo ? 'Sem cobrança' : preco(p.valor_centavos) %></strong><p class="bl-note"><%= s.modalidade==='free'?'Sem cobrança, conforme os termos aceitos.':'Uma licença, os arquivos da oferta e as condições que você escolheu.' %></p><div class="bl-actions">
<% if(s.modalidade==='premium'&&['criando','pendente','rejeitado'].includes(p.estado)){ %><form method="post" action="/purchases/<%= p.id %>/checkout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="bl-button" <%= !checkoutDisponivel&&!p.checkoutCatalogo?'disabled':'' %>><%= p.checkoutCatalogo ? 'Revisar licença' : 'Continuar para o pagamento' %></button></form><% if(!p.checkoutCatalogo){ %><p class="bl-note"><%= checkoutDisponivel ? 'Este checkout não realiza cobranças.' : 'O pagamento está temporariamente indisponível. Seu pedido permanece salvo para você continuar depois.' %></p><% } %><% } %>
<% if(p.preferencia_id&&!['reembolsado','contestado'].includes(p.estado)){ %><form method="post" action="/purchases/<%= p.id %>/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="bl-button bl-outline">Atualizar situação</button></form><% } %></div>
<% if(p.licenca_id){ %><a class="bl-button bl-outline" href="/purchases/<%= p.id %>/license">Baixar licença</a><small class="bl-note">Licença <%= p.licenca_id %></small><% } %><% if(p.suspensa_em){ %><p class="bl-feedback">Entrega suspensa: <%= p.motivo %>.</p><% } %>
<h3>Seus arquivos</h3><% if(p.estado==='aprovado'&&p.licenca_id&&!p.suspensa_em){ %><ul class="bl-file-list"><% s.arquivos.forEach(a=>{ %><li><span><strong><%= a.nome %></strong><small><%= (a.bytes/1024/1024).toFixed(1) %> MB</small></span><a class="bl-button bl-outline" href="/purchases/<%= p.id %>/files/<%= a.id %>">Baixar</a></li><% }) %></ul><% }else{ %><p class="bl-note">Arquivos disponíveis após concessão válida da autorização.</p><% } %></section>
<section class="bl-panel"><h3>Termos que você aceitou</h3><p class="bl-note">Versão <%= s.numero %> · <%= data(s.aceite_em) %></p><dl class="bl-terms"><% [['usos','Usos permitidos'],['restricoes','Restrições'],['creditos','Créditos'],['limites','Limites'],['entregaveis','Entregáveis']].forEach(([k,n])=>{ %><div><dt><%= n %></dt><dd><%= s.oferta[k] %></dd></div><% }) %></dl><p class="bl-note">A autorização concede somente os usos expressos. Não transfere autoria ou exclusividade.</p></section></div><a class="bl-link" href="/suporte/new">Precisa de ajuda com este pedido?</a><% } %>
</main><%- include('../partials/navegacao-mobile',{rotaAtual:path}) %></div></div><script src="/js/beats-licencas.js" defer></script><%- include('../partials/fim-pagina') %>
