<%- include('../partials/cabecalho',{title,stylesheet}) %><div class="app-shell"><%- include('../partials/barra-lateral',{path}) %><main class="main-shell"><%- include('../partials/barra-superior',{breadcrumb:'Meu espaço'}) %><div class="page-content">
<header class="page-header"><div><span class="eyebrow">SEU ESPAÇO PRIVADO</span><h1><%= usuario.name %></h1><p><%= usuario.handle %></p><p>Descubra talentos e acompanhe a cultura hip-hop.</p></div><a class="button button-outline" href="/settings#identidade">Editar identidade</a></header>
<%- include('../partials/componentes/completar-identidade', {usuario}) %>
<% if(erro){ %><p class="profile-message profile-message-error" role="alert"><%= erro %></p><% } %><% if(salvo){ %><p class="profile-message profile-message-success" role="status">Apresentação salva.</p><% } %>
<section class="card-surface profile-edit-panel"><h2>Sua apresentação</h2><p>Esta página é privada. Sua conta não aparece na busca de profissionais.</p><form class="profile-edit-form" method="post" action="/profile/apresentacao"><label>Cidade e estado<input name="cidade" maxlength="100" value="<%= usuario.city %>" autocomplete="address-level2"></label><label>Biografia<textarea name="biografia" maxlength="500" rows="4"><%= usuario.biography %></textarea></label><button class="button button-lime" type="submit">Salvar apresentação</button><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form></section>
<section class="card-surface profile-edit-panel"><h2>Começou a atuar na cena?</h2><p>Ative o perfil profissional na mesma conta. Seu acesso, identidade e histórico continuam com você. A ativação é irreversível.</p><a class="button button-outline" href="/profile/profissionalizar">Tornar-me Profissional</a></section>
</div></main></div><%- include('../partials/fim-pagina') %>
