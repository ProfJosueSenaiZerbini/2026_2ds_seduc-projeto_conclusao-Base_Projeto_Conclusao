<%- include('../partials/cabecalho', { title, stylesheet }) %>
<link rel="stylesheet" href="/css/descoberta.css">
<link rel="stylesheet" href="/css/temas-evento-form.css">
<div class="app-shell">
<%- include('../partials/barra-lateral', { path }) %>
<main class="main-shell">
<%- include('../partials/barra-superior', { breadcrumb: editando ? 'Oportunidades / Editar' : 'Oportunidades / Cadastrar' }) %>
<div class="page-content work-form-page">
<a href="<%= origemEspaco ? '/espaco-de-trabalho' : '/events' %>" class="back-link">
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.arrowLeft %>
  </span>
  <%= origemEspaco ? 'Voltar ao Espaço de Trabalho' : 'Voltar para Oportunidades' %>
</a>
<div class="page-header">
  <div>
    <div class="eyebrow">
      <%= editando ? 'ATUALIZAÇÃO DE EVENTO' : 'NOVO EVENTO' %>
    </div>
    <h1>
      <%= editando ? 'Editar evento' : 'Cadastrar evento' %>
    </h1>
    <p>
      Organize uma oportunidade real para a comunidade Cypher encontrar e acompanhar.
    </p>
  </div>
</div>
<% if (erro) { %>
  <div class="form-feedback error-feedback" role="alert">
    <span class="lucide-icon" aria-hidden="true">
      <%- icones.circleHelp %>
    </span>
    <%= erro %>
  </div>
<% } %>
<div class="work-form-notice">
  <span class="lucide-icon" aria-hidden="true">
    <%- icones.calendarCheck %>
  </span>
  <div>
    <strong>
      Evento público
    </strong>
    <p>
      O evento ficará disponível na descoberta de oportunidades. Revise os dados antes de publicar.
    </p>
  </div>
</div>
<form class="work-form" method="post" action="<%= editando ? `/events/${encodeURIComponent(eventoId)}/edit` : '/events/new' %>" data-event-form data-category-other-legacy-empty="<%= categoriaOutroLegadaVazia %>">
  <section class="form-section">
    <div class="form-section-heading">
      <span class="form-step">
        01
      </span>
      <div>
        <h2>
          Identidade do evento
        </h2>
        <p>
          Comece pelos dados que apresentam a oportunidade.
        </p>
      </div>
    </div>
    <div class="form-grid">
      <label class="field-full">
        Título
        <span class="required-mark">
          *
        </span>
        <input name="titulo" required minlength="2" maxlength="120" value="<%= valores.titulo %>" placeholder="Ex.: Batalha da Praça 011">
      </label>
      <label>
        Categoria
        <span class="required-mark">
          *
        </span>
        <select name="categoria" data-event-category-select required>
          <option value="">
            Selecione
          </option>
          <% categoriasEvento.forEach(categoria => { %>
            <option value="<%= categoria %>"<%= valores.categoria === categoria ? 'selected' : '' %>>
              <%= categoria %>
            </option>
          <% }) %>
        </select>
      </label>
      <label class="field-full" data-event-category-other-field<%= valores.categoria === 'Outro' ? '' : ' hidden' %>>
        Especifique a categoria do evento
        <span class="required-mark" data-event-category-other-required<%= categoriaOutroLegadaVazia ? ' hidden' : '' %>*</span>
        <input name="categoriaDetalhe" data-event-category-other-input minlength="2" maxlength="80" value="<%= valores.categoriaDetalhe %>"<%= valores.categoria === 'Outro' && !categoriaOutroLegadaVazia ? ' required' : '' %><%= valores.categoria === 'Outro' ? '' : ' disabled' %> placeholder="Ex.: encontro de DJs, feira de música independente">
        <small>O detalhe será exibido junto ao evento; a categoria continua “Outro” para os filtros e relatórios.</small>
      </label>
      <fieldset class="workshop-type-fieldset field-full" data-workshop-types-field<%= valores.categoria === 'Workshop' ? '' : ' hidden' %> aria-describedby="workshop-types-help workshop-types-error">
        <legend>Tipo de workshop <span class="required-mark">*</span></legend>
        <p id="workshop-types-help">Selecione uma ou mais áreas.</p>
        <div class="workshop-type-options">
          <% tiposWorkshop.forEach(tipo => { %>
            <label class="workshop-type-option<%= valores.tiposWorkshop.includes(tipo) ? ' selected' : '' %>">
              <input type="checkbox" name="tiposWorkshop" value="<%= tipo %>"<%= valores.tiposWorkshop.includes(tipo) ? ' checked' : '' %>>
              <span><%= tipo %></span>
            </label>
          <% }) %>
        </div>
        <small id="workshop-types-error" data-workshop-types-error role="status" hidden>Selecione pelo menos um tipo de workshop.</small>
      </fieldset>
      <label>
        Situação
        <span class="required-mark">
          *
        </span>
        <select name="situacao" required>
          <% situacoesEvento.forEach(situacao => { %>
            <option value="<%= situacao %>"<%= valores.situacao === situacao ? 'selected' : '' %>>
              <%= situacao %>
            </option>
          <% }) %>
        </select>
      </label>
      <label>
        Participação
        <span class="required-mark">
          *
        </span>
        <select name="tipoParticipacao" required>
          <option value="aberta"<%= valores.tipoParticipacao === 'aberta' ? 'selected' : '' %>>
            Aberta — participação registrada na hora
          </option>
          <option value="aprovacao"<%= valores.tipoParticipacao === 'aprovacao' ? 'selected' : '' %>>
            Mediante aprovação — solicitar participação
          </option>
        </select>
      </label>
      <label>
        Data
        <span class="required-mark">
          *
        </span>
        <input type="date" name="data" required value="<%= valores.data %>">
      </label>
      <label>
        Horário
        <span class="optional-mark">
          Opcional
        </span>
        <input name="horario" maxlength="20" value="<%= valores.horario %>" placeholder="Ex.: 19h30">
      </label>
      <label class="field-full">
        Local ou link
        <span class="required-mark">
          *
        </span>
        <input name="local" required maxlength="160" value="<%= valores.local %>" placeholder="Ex.: Galpão 9 · Belo Horizonte, MG">
      </label>
    </div>
  </section>
  <section class="form-section">
    <div class="form-section-heading">
      <span class="form-step">
        02
      </span>
      <div>
        <h2>
          Organização
        </h2>
        <p>
          Ajude as pessoas a entenderem quem realiza e como participar.
        </p>
      </div>
    </div>
    <div class="form-grid">
      <label>
        Organizador
        <span class="required-mark">
          *
        </span>
        <input name="organizador" required maxlength="120" value="<%= valores.organizador %>" placeholder="Nome do coletivo ou organização">
      </label>
      <label>
        Formato
        <span class="required-mark">
          *
        </span>
        <input name="formato" required maxlength="120" value="<%= valores.formato %>" placeholder="Ex.: Workshop online · 90 minutos">
      </label>
      <label class="field-full">
        Descrição
        <span class="optional-mark">
          Opcional
        </span>
        <textarea name="descricao" rows="5" maxlength="1000" placeholder="Explique a proposta e para quem é o evento.">
          <%= valores.descricao %>
        </textarea>
      </label>
      <label>
        Inscrições
        <span class="optional-mark">
          Opcional
        </span>
        <input name="inscricao" maxlength="240" value="<%= valores.inscricao %>" placeholder="Ex.: Gratuita · vagas limitadas">
      </label>
      <label>
        Destaque ou prêmio
        <span class="optional-mark">
          Opcional
        </span>
        <input name="premio" maxlength="240" value="<%= valores.premio %>" placeholder="Ex.: Troféu e divulgação">
      </label>
      <label class="field-full">
        Etiquetas
        <span class="optional-mark">
          Separadas por vírgula
        </span>
        <input name="etiquetas" maxlength="260" value="<%= valores.etiquetas %>" placeholder="Ex.: MCs, Presencial, Inscrições abertas">
      </label>
      <label>
        Cor visual
        <span class="required-mark">
          *
        </span>
        <select name="cor" required>
          <% coresEvento.forEach(cor => { %>
            <option value="<%= cor %>"<%= valores.cor === cor ? 'selected' : '' %>>
              <%= cor === 'yellow' ? 'Amarela' : cor === 'green' ? 'Verde' : cor === 'cream' ? 'Creme' : cor === 'blue' ? 'Azul' : cor === 'violet' ? 'Violeta' : 'Vermelha' %>
            </option>
          <% }) %>
        </select>
      </label>
    </div>
  </section>
  <fieldset class="form-section event-theme-fieldset">
    <legend>Tema do cartão</legend>
    <div class="event-theme-options dc-shell">
      <% temasEvento.forEach(tema => { %>
        <div class="event-theme-option">
          <label class="event-theme-choice">
            <input type="radio" name="temaCartao" value="<%= tema.id %>"<% if (temaSelecionado === tema.id) { %> checked<% } %> required>
            <span><strong><%= tema.nome %></strong><small><%= tema.descricao %></small></span>
          </label>
          <div class="event-theme-preview" aria-hidden="true">
            <%- include('../partials/componentes/evento-descoberta', {
              previa: true,
              item: {
                temaCartao: tema.id, categoria: valores.categoria, tipo: valores.categoria || 'Batalha de rima', workshopTypes: valores.tiposWorkshop,
                titulo: valores.titulo || 'Batalha da Praça', autor: valores.organizador,
                local: valores.local || 'Praça Roosevelt, São Paulo', hora: valores.horario || '19h30',
                data: '2026-11-23', dia: '23', mes: 'NOV', dataCurta: '23 de novembro', cor: valores.cor
              }
            }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </fieldset>
  <div class="work-form-actions">
    <a class="button button-outline" href="<%= origemEspaco ? '/espaco-de-trabalho' : '/events' %>">
      Cancelar
    </a>
    <button class="button button-lime" type="submit">
      <span class="lucide-icon" aria-hidden="true">
        <%- icones.circleCheck %>
      </span>
      <%= editando ? 'Salvar alterações' : 'Publicar evento' %>
    </button>
  </div>
  <% if (origemEspaco) { %><input type="hidden" name="origem" value="espaco"><% } %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>
</div>
</main>
</div>
<script src="/js/temas-evento.js" defer></script>
<script src="/js/descoberta.js" defer></script>
<%- include('../partials/fim-pagina') %>
