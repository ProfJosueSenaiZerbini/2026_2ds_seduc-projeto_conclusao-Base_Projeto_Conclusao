<%- include('../partials/cabecalho', { title, stylesheet }) %>
<link rel="stylesheet" href="/css/descoberta.css">
<link rel="stylesheet" href="/css/espaco-trabalho-identidade.css">
<div class="dc-shell et-workspace">
  <a class="dc-skip" href="#conteudo-obras">Pular para o conteúdo</a>
  <%- include('../partials/barra-lateral', { path }) %>
  <div class="dc-page">
    <header class="dc-header">
      <button class="dc-menu" type="button" data-sidebar-open aria-label="Abrir menu de navegação" aria-controls="navegacao-principal" aria-expanded="false"><%- icones.menu %></button>
      <a class="dc-brand" href="/dashboard" aria-label="Cypher — início">CYPHER</a>
      <div class="dc-title"><h1 id="ob-titulo">Obras</h1><p>Explore lançamentos de profissionais da Cypher.</p></div>
      <div class="dc-account">
        <%- include('../partials/componentes/tema-entrada') %>
        <%- include('../partials/componentes/acoes-conta') %>
      </div>
    </header>
    <main class="et-page" id="conteudo-obras" aria-labelledby="ob-titulo" tabindex="-1">
      <form class="dc-controls et-search-controls" role="search" aria-label="Buscar no catálogo de obras" method="get" action="/works">
        <%- include('../partials/componentes/campo-busca', { campo: { id: 'busca-obras', nome: 'q', valor: q, limite: 120, rotulo: 'Obra ou artista', rotuloBotao: 'Buscar obras' } }) %>
        <% if (formatos.length || generos.length) { %>
          <details class="dc-filter">
            <summary><span aria-hidden="true"><%- icones.sliders %></span> <%= formato || genero ? 'Filtros ativos' : 'Filtros' %></summary>
            <div class="dc-filter-panel">
              <% if (formatos.length) { %>
                <label>Formato
                  <select name="formato">
                    <option value="">Todos os formatos</option>
                    <% formatos.forEach(opcao => { %>
                      <option value="<%= opcao %>"<%= opcao === formato ? ' selected' : '' %>><%= opcao %></option>
                    <% }) %>
                  </select>
                </label>
              <% } %>
              <% if (generos.length) { %>
                <label>Gênero
                  <select name="genero">
                    <option value="">Todos os gêneros</option>
                    <% generos.forEach(opcao => { %>
                      <option value="<%= opcao %>"<%= opcao === genero ? ' selected' : '' %>><%= opcao %></option>
                    <% }) %>
                  </select>
                </label>
              <% } %>
              <button type="submit">Aplicar filtros</button>
            </div>
          </details>
        <% } %>
      </form>
      <% if (permissao) { %><p class="et-feedback" role="alert">Sua conta não tem permissão para essa ação.</p><% } %>
      <section class="et-section" id="catalogo-obras" aria-labelledby="ob-catalogo-titulo">
        <header>
          <div class="et-heading"><h2 id="ob-catalogo-titulo">Catálogo musical <span class="cy-count-sticker"><%= obras.length %></span></h2></div>
          <% if (usuario.tipoConta === 'profissional') { %><a id="cadastro-obra" class="et-more" href="/espaco-de-trabalho">Espaço de Trabalho <%- icones.arrowRight %></a><% } %>
        </header>
        <% if (obras.length) { %>
          <div class="et-grid et-completa">
            <% obras.forEach(o => { %>
              <%- include('../partials/cartao-trabalho', {item:{modalidade:'obra',titulo:o.titulo,autor:o.autor,tipo:o.tipo,metadados:o.genero,icone:'music'},href:'/p/'+encodeURIComponent(o.handle.replace(/^@/,''))+'#obra-'+encodeURIComponent(o.id),participacao:false}) %>
            <% }) %>
          </div>
        <% } else { %>
          <div class="et-empty">
            <span class="et-empty-icon" aria-hidden="true"><%- icones.disc %></span>
            <div><h3><%= q || formato || genero ? 'Nenhuma obra corresponde à sua busca ou aos filtros.' : 'Ainda não há obras públicas no catálogo.' %></h3></div>
          </div>
        <% } %>
      </section>
    </main>
    <%- include('../partials/navegacao-mobile', { rotaAtual: '/works' }) %>
  </div>
</div>
<script src="/js/espaco-trabalho.js" defer></script>
<%- include('../partials/fim-pagina') %>
