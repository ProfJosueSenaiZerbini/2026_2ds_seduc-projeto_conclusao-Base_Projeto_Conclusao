
@startuml UC_07C_Avaliacoes_Eventos

title CYPHER - Avaliações e Reclamações Pós-evento

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam titleFontSize 17
skinparam nodesep 30
skinparam ranksep 30
skinparam ArrowColor #566057
skinparam actorBorderColor #253127
skinparam usecaseBorderColor #475649
skinparam usecaseBackgroundColor #F7F9F6
skinparam rectangleBorderColor #27362A

actor "Participante\nelegível" as PART

actor "Organizador(a)\ndo evento" as ORG

rectangle "CYPHER - Avaliações Pós-evento" {

  usecase "Avaliar experiência\ndo evento" as U01

  usecase "Registrar reclamação\nsobre organização" as U02

  usecase "Reconhecer reclamação\ne prestar esclarecimentos" as U03

  usecase "Contestar reclamação" as U04

  usecase "Analisar reclamação\ncontestada" as U05

  usecase "Analisar recurso e\nregistrar decisão" as U06

}

actor "Moderador" as MOD

PART -- U01
PART -- U02

ORG -- U03
ORG -- U04

U05 -- MOD
U06 -- MOD

@enduml
