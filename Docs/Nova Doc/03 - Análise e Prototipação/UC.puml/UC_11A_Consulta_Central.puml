
@startuml UC_11A_Consulta_Central

title CYPHER - Consulta à Cypher Central

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam titleFontSize 17
skinparam nodesep 30
skinparam ranksep 30
skinparam ArrowColor #566057
skinparam actorBorderColor #253127
skinparam usecaseBorderColor #475649
skinparam usecaseBackgroundColor #F7F9F6
skinparam rectangleBorderColor #27362A

actor "Usuário\nautenticado" as USER

rectangle "CYPHER - Cypher Central" {

  usecase "Consultar artigos\ne guias educativos" as U01

  usecase "Pesquisar artigos\npor assunto" as U02

  usecase "Explorar artigos\npor categoria" as U03

  usecase "Consultar artigos\nrecentes" as U04

}

USER -- U01
USER -- U02
USER -- U03
USER -- U04

@enduml
