
@startuml UC_10A_Descoberta

title CYPHER - Descoberta e Recomendações

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam titleFontSize 17
skinparam nodesep 30
skinparam ranksep 30
skinparam ArrowColor #566057
skinparam actorBorderColor #253127
skinparam usecaseBorderColor #475649
skinparam usecaseBackgroundColor #F7F9F6
skinparam rectangleBorderColor #27362A

actor "Usuário\nautenticado" as USER

rectangle "CYPHER - Descoberta" {

  usecase "Explorar conteúdos\ne profissionais" as U01

  usecase "Consultar recomendações\npersonalizadas" as U02

  usecase "Configurar interesses\nculturais" as U03

  usecase "Definir preferência\nde região" as U04

  usecase "Abrir ficha ou perfil\nde conteúdo recomendado" as U05

}

USER -- U01
USER -- U02
USER -- U03
USER -- U04
USER -- U05

@enduml
