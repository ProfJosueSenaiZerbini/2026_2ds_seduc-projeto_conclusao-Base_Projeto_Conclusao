
@startuml UC_11B_Feedback_Central

title CYPHER - Avaliação de Artigos

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam titleFontSize 17
skinparam nodesep 30
skinparam ranksep 30
skinparam ArrowColor #566057
skinparam actorBorderColor #253127
skinparam usecaseBorderColor #475649
skinparam usecaseBackgroundColor #F7F9F6
skinparam rectangleBorderColor #27362A

actor "Usuário\nautenticado" as USER

rectangle "CYPHER - Feedback Educativo" {

  usecase "Avaliar artigo\ncomo Útil" as U01

  usecase "Avaliar artigo\ncomo Não útil" as U02

  usecase "Informar motivo\nda avaliação negativa" as U03

  U02 ..> U03 : <<include>>

}

USER -- U01
USER -- U02

@enduml
