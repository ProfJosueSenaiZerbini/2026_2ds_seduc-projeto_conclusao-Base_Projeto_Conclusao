        <mxCell id="d2-EIA6ScOhoEcGh-Ipc-41" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#F3F6EE,#A8C2A1);fontSize=13;spacing=0;" value="Mensagens privadas aos participantes. Administração sem acesso livre: evidência denunciada só é analisada excepcionalmente por responsável competente, com justificativa e auditoria." vertex="1">
          <mxGeometry height="25" width="2150" x="70" y="1721" as="geometry" />
