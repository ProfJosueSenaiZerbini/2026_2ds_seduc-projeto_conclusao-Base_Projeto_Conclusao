        <mxCell id="fsvx8d2B19By9Xq3Kv1Q-29" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#293D2E;strokeColor=#829781;strokeWidth=1.8;fontColor=#F3F6EE;fontFamily=Arial;fontSize=16;spacing=8;" value="&lt;div style=&quot;font-family:Arial;line-height:1.24&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Voltar ao Espaço de Trabalho&lt;/b&gt;&lt;div style=&quot;font-size:13px;color:#D7E2D7;margin-top:4px&quot;&gt;O acervo pode ser consultado novamente&lt;/div&gt;&lt;/div&gt;" vertex="1">
