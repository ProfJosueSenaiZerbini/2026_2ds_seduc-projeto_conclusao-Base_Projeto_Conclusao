        </mxCell>
        <mxCell id="1pUwImCeTL7nM1zxlbpt-15" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#596C5D;fontSize=13;spacing=0;fontFamily=Arial;rounded=0;" value="&lt;span style=&#39;font-size:12px&#39;&gt;Gestão por papel: Administrador Geral, Moderador e Editor (FN-09). Sem perfil público profissional.&lt;/span&gt;" vertex="1">
          <mxGeometry height="47" width="520" x="1136" y="518" as="geometry" />
        </mxCell>
        <mxCell id="1pUwImCeTL7nM1zxlbpt-16" parent="1" style="rounded=0;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFEFA;strokeColor=#C6D5C4;strokeWidth=1.5;fontColor=#1C3224;fontSize=15;spacing=22;spacingTop=19;fontFamily=Arial;" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;color:#294A35&quot;&gt;EXPLORAR&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#627666;margin-top:4px&quot;&gt;Acessível às contas convencionais autenticadas&lt;/div&gt;&lt;div style=&quot;margin-top:15px&quot;&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Buscar pessoas → Perfil profissional → Portfólio&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-02 / FN-03&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Obras e lançamentos → Ficha&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-02 / FN-04&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Banco de Beats → Ficha / Ofertas&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-05&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Eventos → Ficha / Participação&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-06&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Oportunidades → Ficha / Candidatura&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-07&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Cypher Central → Guias&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · RF-126–131&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.45;color:#5E725F;margin-top:13px&quot;&gt;Cada linha representa um destino próprio; não uma sequência entre os conteúdos.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="428" width="508" x="50" y="700" as="geometry" />
        </mxCell>
        <mxCell id="1pUwImCeTL7nM1zxlbpt-17" parent="1" style="rounded=0;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFEFA;strokeColor=#C6D5C4;strokeWidth=1.5;fontColor=#1C3224;fontSize=15;spacing=22;spacingTop=19;fontFamily=Arial;" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:700;color:#294A35&quot;&gt;CONTA E INTERAÇÕES&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#627666;margin-top:4px&quot;&gt;Ações pessoais; disponibilidade sujeita à permissão&lt;/div&gt;&lt;div style=&quot;margin-top:15px&quot;&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Meu perfil → Editar / Privacidade&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-03&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Configurações da conta&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · RF-019&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Seguindo / Salvos&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-08&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Mensagens privadas / Notificações&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-08&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Minhas Compras → Licenças de teste&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-05&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;padding:10px 0;border-bottom:1px solid #E1E7DF;color:#1D3326&quot;&gt;Consumidor → Ativação profissional&lt;span style=&quot;font-size:12px;color:#67816C&quot;&gt;  · FN-01&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.45;color:#5E725F;margin-top:13px&quot;&gt;Perfil de Consumidor é privado; não existe uma segunda conta ao profissionalizar.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="428" width="506" x="611" y="700" as="geometry" />
        </mxCell>
        <mxCell id="1pUwImCeTL7nM1zxlbpt-18" parent="1" style="rounded=0;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFFEFA;strokeColor=#C6D5C4;strokeWidth=1.5;fontColor=#1C3224;fontSize=15;spacing=22;spacingTop=19;fontFamily=Arial;" value="&lt;div style=&quot;font-family:Arial&quot;&gt;&lt;div style=&quot;font-size: 17px; font-weight: 700; color: rgb(41, 74, 53);&quot;&gt;ÁREA PROFISSIONAL&lt;/div&gt;&lt;div style=&quot;font-size: 12px; color: rgb(98, 118, 102); margin-top: 4px;&quot;&gt;Acesso profissional; ações condicionadas às permissões.&lt;/div&gt;&lt;div style=&quot;margin-top:15px&quot;&gt;&lt;div style=&quot;font-size: 15px; line-height: 1.35; padding: 10px 0px; border-bottom: 1px solid rgb(225, 231, 223); color: rgb(29, 51, 38);&quot;&gt;Espaço de Trabalho → Acervo / Fichas&lt;span style=&quot;font-size: 12px; color: rgb(103, 129, 108);&quot;&gt;  · FN-04&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 15px; line-height: 1.35; padding: 10px 0px; border-bottom: 1px solid rgb(225, 231, 223); color: rgb(29, 51, 38);&quot;&gt;Publicar → Escolher modalidade permitida&lt;span style=&quot;font-size: 12px; color: rgb(103, 129, 108);&quot;&gt;  · FN-04&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 15px; line-height: 1.35; padding: 10px 0px; border-bottom: 1px solid rgb(225, 231, 223); color: rgb(29, 51, 38);&quot;&gt;Obras, beats, eventos, projetos e galerias&lt;span style=&quot;font-size: 12px; color: rgb(103, 129, 108);&quot;&gt;  · FN-04–06&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 15px; line-height: 1.35; padding: 10px 0px; border-bottom: 1px solid rgb(225, 231, 223); color: rgb(29, 51, 38);&quot;&gt;Chamadas e oportunidades próprias&lt;span style=&quot;font-size: 12px; color: rgb(103, 129, 108);&quot;&gt;  · FN-07&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 15px; line-height: 1.35; padding: 10px 0px; border-bottom: 1px solid rgb(225, 231, 223); color: rgb(29, 51, 38);&quot;&gt;Meu Perfil&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(28, 50, 36), rgb(185, 204, 192));&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(29, 51, 38), rgb(184, 203, 192)); background-color: transparent;&quot;&gt;&amp;nbsp;Portfólio / Selo Profissional&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 12px; color: rgb(103, 129, 108);&quot;&gt;· FN-03&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 15px; line-height: 1.35; padding: 10px 0px; border-bottom: 1px solid rgb(225, 231, 223); color: rgb(29, 51, 38);&quot;&gt;Collabs / Avaliações profissionais&lt;span style=&quot;font-size: 12px; color: rgb(103, 129, 108);&quot;&gt;  · FN-08&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; line-height: 1.45; color: rgb(94, 114, 95); margin-top: 13px;&quot;&gt;&lt;blockquote&gt;&lt;p&gt;Cada publicação exige profissão ativa compatível, vínculo legítimo e autorização. As modalidades são alternativas, não etapas sucessivas.&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="428" width="516" x="1168" y="700" as="geometry" />
        </mxCell>
        <mxCell id="1pUwImCeTL7nM1zxlbpt-19" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#596C5D;fontSize=13;spacing=0;fontFamily=Arial;rounded=0;" value="&lt;b&gt;LEITURA:&lt;/b&gt; Setas indicam o acesso entre áreas. Os três cartões inferiores agrupam destinos independentes (não representam uma página adicional)." vertex="1">
          <mxGeometry height="29" width="1620" x="50" y="1157" as="geometry" />
        </mxCell>
        <mxCell id="1pUwImCeTL7nM1zxlbpt-20" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#596C5D;fontSize=13;spacing=0;fontFamily=Arial;rounded=0;" value="&lt;b&gt;BASE:&lt;/b&gt; RN-001–046; RF-001–029, RF-056–069 e RF-088–146. Fluxo da versão final documentada; não comprova que todas as telas já estejam implementadas. Consumidor só solicita publicação excepcional mediante mediação/triagem (FN-07)." vertex="1">
          <mxGeometry height="42" width="1640" x="50" y="1188" as="geometry" />
        </mxCell>
