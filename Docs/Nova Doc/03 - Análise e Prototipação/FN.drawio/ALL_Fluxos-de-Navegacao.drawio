        <mxCell id="1pUwImCeTL7nM1zxlbpt-11" parent="1" style="rounded=0;arcSize=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFEFA;strokeColor=#8AA18E;strokeWidth=1.6;dashed=1;dashPattern=5 4;fontColor=#27432D;fontSize=16;spacing=8;fontFamily=Arial;" value="&lt;div style=&quot;font-size:17px;font-weight:700&quot;&gt;Navegação Global&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:4px&quot;&gt;&lt;strong&gt;Sidebar / barra inferior&lt;/strong&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:4px&quot;&gt;&lt;strong&gt;acesso persistente&lt;/strong&gt;&lt;strong&gt;&lt;/strong&gt;&lt;/div&gt;" vertex="1">
