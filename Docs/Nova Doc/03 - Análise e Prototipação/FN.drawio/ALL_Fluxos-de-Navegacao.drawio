        <mxCell id="08_yMqxOuVEedfrpJ8IT-60" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#A8C2A1,#A8C2A1);fontSize=13;spacing=0;" value="Continuidade [A]: candidatura, acompanhamento, gestão e análise compartilham a mesma oportunidade. Negociações e acordos são individuais. [B] nova resposta retoma a verificação do aceite." vertex="1">
          <mxGeometry height="25" width="2150" x="57" y="2243" as="geometry" />
