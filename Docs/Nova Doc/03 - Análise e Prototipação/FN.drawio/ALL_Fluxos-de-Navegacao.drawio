        <mxCell id="1pUwImCeTL7nM1zxlbpt-14" parent="1" style="rounded=0;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#294A35;strokeColor=#294A35;strokeWidth=1.6;fontColor=#FFFFFF;fontSize=16;spacing=10;fontFamily=Arial;" value="&lt;div style=&quot;font-family:Arial;font-weight:700;font-size:16px;line-height:1.3&quot;&gt;Painel administrativo&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;margin-top:5px;color:#E0EDE0&quot;&gt;/admin&lt;/div&gt;" vertex="1">
