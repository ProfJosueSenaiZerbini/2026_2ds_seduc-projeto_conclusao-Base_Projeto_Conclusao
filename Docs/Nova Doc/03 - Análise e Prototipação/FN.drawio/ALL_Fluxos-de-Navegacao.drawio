        <mxCell id="VT6YCAQkFFEKCcAJvxi_-84" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#E2EBE1,#A8C2A1);fontSize=13;spacing=0;" value="[B] Toda função depende da verificação compartilhada de competência. Solicitações de interesse próprio seguem controle competente e independente." vertex="1">
          <mxGeometry height="25" width="2550" x="490" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="VT6YCAQkFFEKCcAJvxi_-85" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#E2EBE1,#6E806A);fontSize=13;spacing=0;" value="&lt;b&gt;PROTEÇÃO:&lt;/b&gt; Dados pessoais, mensagens, denúncias e evidências protegidas exigem competência e finalidade justificadas. Conversas privadas sem acesso administrativo livre." vertex="1">
          <mxGeometry height="25" width="2670" x="413" y="2265" as="geometry" />
        </mxCell>
        <mxCell id="VT6YCAQkFFEKCcAJvxi_-86" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#E2EBE1,#6E806A);fontSize=13;spacing=0;" value="Evidências denunciadas têm tratamento restrito, proporcional e auditável. Aprovações excepcionais não concedem permissões profissionais gerais." vertex="1">
          <mxGeometry height="25" width="2670" x="413" y="2295" as="geometry" />
        </mxCell>
        <mxCell id="VT6YCAQkFFEKCcAJvxi_-87" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#E2EBE1,#6E806A);fontSize=13;spacing=0;" value="&lt;b&gt;REFERÊNCIAS:&lt;/b&gt; FN-00/01 acesso separado · FN-03 perfis e identidade · FN-04 conteúdos · FN-05 beats · FN-06 eventos · FN-07 pedidos e conflitos · FN-08 comunicações." vertex="1">
          <mxGeometry height="25" width="2670" x="413" y="2325" as="geometry" />
        </mxCell>
