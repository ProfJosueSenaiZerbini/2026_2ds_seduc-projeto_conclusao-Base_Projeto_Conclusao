        <mxCell id="08_yMqxOuVEedfrpJ8IT-59" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#A8C2A1,#A8C2A1);fontSize=13;spacing=0;" value="Desistências válidas podem liberar vagas e permitir reabertura, conforme as condições vigentes · gestão da oportunidade [A]." vertex="1">
          <mxGeometry height="25" width="2150" x="57" y="2213" as="geometry" />
