        <mxCell id="Q7ilJWNZX2c1JA7y2pSi-66" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#64805A;strokeColor=#9EB394;strokeWidth=1.8;fontColor=#FFFFFF;fontFamily=Arial;fontSize=16;spacing=8;" value="&lt;div style=&quot;font-family:Arial;line-height:1.24&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Considerar preferências e contexto&lt;/b&gt;&lt;div style=&quot;font-size:13px;color:#F1F6EC;margin-top:4px&quot;&gt;Horário local e situação atual do evento&lt;br&gt;Registrar lembrete e disponibilizar aviso · [D]&lt;/div&gt;&lt;/div&gt;" vertex="1">
