        <mxCell id="Q7ilJWNZX2c1JA7y2pSi-67" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#64805A;strokeColor=#9EB394;strokeWidth=1.8;fontColor=#FFFFFF;fontFamily=Arial;fontSize=16;spacing=8;" value="&lt;div style=&quot;font-family:Arial;line-height:1.24&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Não gerar lembrete opcional&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="320" x="1262" y="1558" as="geometry" />
