        <mxCell id="INef0rQYAZz6amSUKfvo-84" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#E2EBE1,#A8C2A1);fontSize=13;spacing=0;" value="[B] Toda função depende da verificação compartilhada de competência. Solicitações de interesse próprio seguem controle competente e independente." vertex="1">
          <mxGeometry height="25" width="2550" x="491" y="3410" as="geometry" />
        </mxCell>
        <mxCell id="INef0rQYAZz6amSUKfvo-85" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#E2EBE1,#6E806A);fontSize=13;spacing=0;" value="&lt;b&gt;PROTEÇÃO:&lt;/b&gt; Dados pessoais, mensagens, denúncias e evidências protegidas exigem competência e finalidade justificadas. Conversas privadas sem acesso administrativo livre." vertex="1">
          <mxGeometry height="25" width="2670" x="414" y="3455" as="geometry" />
        </mxCell>
        <mxCell id="INef0rQYAZz6amSUKfvo-86" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#E2EBE1,#6E806A);fontSize=13;spacing=0;" value="Evidências denunciadas têm tratamento restrito, proporcional e auditável. Aprovações excepcionais não concedem permissões profissionais gerais." vertex="1">
          <mxGeometry height="25" width="2670" x="414" y="3485" as="geometry" />
        </mxCell>
