        </mxCell>
        <mxCell id="cjObFRWR_jDsMLeoMFRe-31" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#A8C2A1,#8A9E8F);fontSize=13;spacing=0;" value="&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;AUTORIZAÇÃO:&lt;/strong&gt; A criação e a gestão exigem profissão compatível quando aplicável, vínculo legítimo e direitos sobre o conteúdo. Múltiplas profissões acumulam somente suas permissões específicas.&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="25" width="1293" x="252" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="cjObFRWR_jDsMLeoMFRe-32" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#F3F6EE,#AFC7B7);fontSize=13;spacing=0;" value="&lt;b&gt;LEITURA:&lt;/b&gt; Acervo e criação são jornadas independentes. Modalidades e ações dependem das permissões do profissional." vertex="1">
          <mxGeometry height="24" width="1800" x="252" y="1397" as="geometry" />
        </mxCell>
        <mxCell id="cjObFRWR_jDsMLeoMFRe-33" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#E2EBE1,#8A9E8F);fontSize=13;spacing=0;" value="&lt;b&gt;ACESSO:&lt;/b&gt; A criação exige profissão compatível, vínculo legítimo e autorização." vertex="1">
          <mxGeometry height="24" width="1800" x="252" y="1423" as="geometry" />
        </mxCell>
        <mxCell id="cjObFRWR_jDsMLeoMFRe-34" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=light-dark(#F3F6EE,#AFC7B7);fontSize=13;spacing=0;" value="&lt;b&gt;INTEGRIDADE:&lt;/b&gt; Participação não concede edição. Cadastro não comprova lançamento, participação confirmada ou execução. A exposição segue as regras de visibilidade." vertex="1">
