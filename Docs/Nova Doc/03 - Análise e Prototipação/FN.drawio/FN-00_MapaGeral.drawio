        <mxCell id="FUoIh5L09QGOf55NgNaO-13" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#596C5D;fontSize=13;spacing=0;fontFamily=Arial;rounded=0;" value="&lt;span style=&#39;font-size:12px&#39;&gt;Cadastro, recuperação e conversão são detalhados no FN-01. O menu permanece disponível nas áreas autorizadas.&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="987" x="113" y="382" as="geometry" />
        </mxCell>
        <mxCell id="FUoIh5L09QGOf55NgNaO-14" parent="1" style="rounded=0;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#294A35;strokeColor=#294A35;strokeWidth=1.6;fontColor=#FFFFFF;fontSize=16;spacing=10;fontFamily=Arial;" value="&lt;div style=&quot;font-family:Arial;font-weight:700;font-size:16px;line-height:1.3&quot;&gt;Login administrativo&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:11px;line-height:1.3;margin-top:5px;color:#E0EDE0&quot;&gt;/admin/login&lt;/div&gt;" vertex="1">
