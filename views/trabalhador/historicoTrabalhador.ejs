<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ibico | Histórico de Bicos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../Partials/phosphorIcons') %>
    <link rel="stylesheet" href="/css/paleta.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/historicoTrabalhador.css">
    <link rel="stylesheet" href="/css/mascotes.css">
</head>

<body>

    <%- include('../Partials/headertrabalhador') %>

        <% const listaConcluidos=(typeof concluidos !=='undefined' ) ? concluidos : []; const listaRecusados=(typeof recusados !=='undefined' ) ? recusados : []; const listaCancelados=(typeof cancelados !=='undefined' ) ? cancelados : []; const abas=[ { id: 'aceitos' ,
            titulo: 'Bicos Aceitos' , lista: aceitos, tipo: 'aceito' , vazio: 'Você ainda não possui bicos aceitos.' },
            { id: 'pendentes' , titulo: 'Bicos Pendentes' , lista: pendentes, tipo: 'pendente' ,
            vazio: 'Você não tem nenhuma candidatura pendente.' }, { id: 'concluidos' , titulo: 'Concluídos' , lista:
            listaConcluidos, tipo: 'concluido' , vazio: 'Você ainda não concluiu nenhum bico.' },
            { id: 'recusados' , titulo: 'Recusados' , lista: listaRecusados, tipo: 'cancelado' , rotulo: 'Recusado' ,
            vazio: 'Nenhuma candidatura sua foi recusada.' }, { id: 'cancelados' ,
            titulo: 'Cancelados' , lista: listaCancelados, tipo: 'cancelado' , rotulo: 'Cancelado' ,
            vazio: 'Você não possui candidaturas canceladas.' } ]; %>

            <main class="page">
                <header class="page__header">
                    <div>
                        <p class="page__eyebrow">Painel do Profissional</p>
                        <h1 class="page__title">Seu Histórico de Bicos</h1>
                        <p class="page__subtitle">Acompanhe suas candidaturas, serviços em andamento e trabalhos
                            concluídos em um só lugar com transparência instantânea.</p>
                    </div>
                </header>

                <!-- Abas + busca + ordenação -->
                <div class="toolbar">
                    <div class="tabs" role="tablist" aria-label="Status das candidaturas">
                        <% abas.forEach((aba, i)=> { %>
                            <button type="button" class="tab <%= i === 0 ? 'tab--active' : '' %>" role="tab" data-tab="<%= aba.id %>"
                                id="tab-<%= aba.id %>" aria-controls="<%= aba.id %>"
                                aria-selected="<%= i === 0 ? 'true' : 'false' %>" tabindex="<%= i === 0 ? '0' : '-1' %>"
                                aria-label="<%= String(aba.titulo).trim() %>, <%= aba.lista.length %> <%= aba.lista.length === 1 ? 'serviço' : 'serviços' %>">
                                <%= aba.titulo %>
                                    <span class="tab__count">
                                        <%= aba.lista.length %>
                                    </span>
                            </button>
                            <% }); %>
                    </div>

                    <div class="filters">
                        <label class="search">
                            <span class="search__icon" aria-hidden="true"><i class="ph ph-magnifying-glass"></i></span>
                            <input type="search" id="busca" placeholder="Buscar por serviço ou cliente...">
                        </label>
                        <select id="ordenar" class="select" aria-label="Ordenar">
                            <option value="recentes">Mais recentes</option>
                            <option value="antigos">Mais antigos</option>
                            <option value="maior">Maior valor</option>
                            <option value="menor">Menor valor</option>
                        </select>
                    </div>
                </div>

                <!-- Painéis -->
                <div class="tab-content">
                    <% abas.forEach((aba, i)=> { %>
                        <section class="tab-panel <%= i === 0 ? 'tab-panel--active' : '' %>" id="<%= aba.id %>" role="tabpanel"
                            aria-labelledby="tab-<%= aba.id %>"<%- aba.lista.length === 0 ? ' tabindex="0"' : '' %>>
                            <% if (aba.lista.length===0) { %>
                                <div class="empty">
                                    <%- include('../Partials/mascoteVazio', { area: 'trabalhador' }) %>
                                    <p><%= aba.vazio %></p>
                                </div>
                                <% } else { %>
                                    <ul class="bicos-list">
                                        <% aba.lista.forEach(bico=> { %>
                                            <%- include('../Partials/cardBico', { bico: bico, tipo: aba.tipo, rotulo: aba.rotulo || '' }) %>
                                                <% }); %>
                                    </ul>
                                    <p class="empty empty--filtro" hidden>Nenhum serviço encontrado para a busca.</p>
                                    <% } %>
                        </section>
                        <% }); %>

                            <!-- Rodapé da lista: contador + paginação -->
                            <div class="list-footer">
                                <p class="list-footer__info" id="infoPaginacao" role="status" aria-live="polite"></p>
                                <nav class="pagination" id="paginacao" aria-label="Paginação"></nav>
                            </div>
                </div>
            </main>

            <!-- Pop-up: Dica para Profissionais -->
            <aside class="tip-popup" id="dicaPopup" role="region" aria-labelledby="dicaTitulo" hidden>
                <div class="tip-popup__icon" aria-hidden="true"><%- include('../Partials/mascote', { ave: 'tie', comGalho: false, tamanho: 56, piscar: true }) %></div>
                <div class="tip-popup__body">
                    <h4 id="dicaTitulo">Dica para Profissionais</h4>
                    <p>Use o chat para combinar horário e local com o contratante. Ao finalizar o serviço, o valor simulado
                        vai para sua carteira simulada, sem pagamento real.</p>
                </div>
                <button type="button" class="tip-popup__close" id="fecharDica" aria-label="Fechar dica"><i class="ph ph-x" aria-hidden="true"></i></button>
            </aside>

            <%- include('../Partials/footer') %>

                <script src="/js/mascotes.js"></script>
                <script src="/js/historicoTrabalhador.js"></script>
</body>

</html>
