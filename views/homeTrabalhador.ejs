            </div>
            <form method="GET" action="/hometrabalhador" class="sort-wrap">
                <span class="sort-label">Ordenar por</span>
                <input type="hidden" name="busca" value="<%= busca %>">
                <select name="ordem" class="sort-select" aria-label="Ordenar vagas">
                    <option value="recentes" <%= ordem === 'recentes' ? 'selected' : '' %>>Mais recentes</option>
                    <option value="maior_preco" <%= ordem === 'maior_preco' ? 'selected' : '' %>>Maior valor</option>
                    <option value="menor_preco" <%= ordem === 'menor_preco' ? 'selected' : '' %>>Menor valor</option>
                </select>
                <button type="submit" class="filter-action">Buscar filtro</button>
            </form>
        </div>

        <div class="grid" id="cardsGrid">
            <% if (vagas.length===0) { %>
                <p style="text-align: center; color: #666; grid-column: 1 / -1; padding: 2rem;">Nenhum bico disponível
                    no momento. Tente novamente mais tarde!</p>
                <% } else { %>
                    <% vagas.forEach(vaga=> { %>
                        <div class="card">
                            <div class="card-head">
                                <div>
                                    <h3>
                                        <%= vaga.titulo %>
                                    </h3>
                                    <div class="location">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                                            <circle cx="12" cy="10" r="3" />
                                        </svg>
                                        <%= vaga.bairro %>
                                    </div>
                                </div>
                                <span class="price-pill">R$ <%= vaga.valor %></span>
                            </div>

                            <div class="meta">
                                <div class="meta-row">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                        <path d="M16 2v4M8 2v4M3 10h18" />
                                    </svg>
                                    <%= vaga.data_servico.toLocaleDateString('pt-BR') %>
                                </div>
                                <div class="meta-row">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="M12 7v5l3 3" />
                                    </svg>
                                    <%= vaga.horario %>
                                </div>
                            </div>

                            <div class="vaga-actions">
                                <a href="/bicos/<%= vaga.id %>" class="btn btn-teal">
                                    <i class="fas fa-eye"></i> Ver Detalhes
                                </a>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>
        </div>

        <div class="load-more-wrap">
            <button class="btn-outline" id="loadMoreBtn">Carregar mais vagas</button>
        </div>
    </main>

    <%- include('partials/footer') %>

    <div class="toast" id="toast"></div>

    <script src="/js/homeTrabalhador.js"></script>

</body>

</html>
